---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import Price from '../components/Price.astro';
import { DEMO, plansFor, planPrice, infraLine, SUPPORT } from '../data/plans';
import { breadcrumbSchema } from '../lib/seo';
import { url } from '../lib/url';
const plans = plansFor('self-hosted');
---

<Layout title="Obstack self-hosted · Helm deployment on your Kubernetes cluster" description="Run the Obstack Stack on your Kubernetes cluster with a Helm chart. Self-hosted Go, Pro and Max plans, with a 30-day Max demo that converts to your chosen paid plan." active="self-hosted" schema={[breadcrumbSchema('/self-hosted', 'Self-hosted')]}>
  <section class="hero">
    <div class="wrap stack" style="gap: 26px">
      <div class="eyebrow rise">Obstack self-hosted</div>
      <h1 class="display rise" style="max-width: 900px">Your Kubernetes cluster.<br />The full observability stack.</h1>
      <p class="lead rise-2" style="max-width: 740px">Install with the Obstack Helm chart and keep telemetry on infrastructure you control. Bee collects it, Piper serves it, Eagle and Grafana show it, and EagleMCP connects your assistants. Updates and support follow your plan.</p>
      <div class="btn-row rise-2"><a class="btn btn-primary" href={url('/download')}>Try Max · {DEMO.days}-day license <Arrow /></a><a class="btn btn-ghost" href="#plans">Compare self-hosted plans</a></div>
    </div>
  </section>

  <section class="section" id="plans">
    <div class="wrap">
      <div class="section-head"><div class="stack"><div class="eyebrow">Self-hosted plans</div><h2 class="h2">Choose your capacity and support.</h2></div><p class="body-2">You provide Kubernetes, compute, persistent storage and an S3-compatible bucket. Install the chart yourself or ask us for deployment assistance over your VPN. Starter is Obstack Cloud only.</p></div>
      <div class="tile-grid grid-3">
        {plans.map((plan) => <article class="stack" style="gap: 18px"><h3 class="h3">{plan.name}</h3><p class="h2"><Price eur={planPrice(plan, 'self-hosted')} /> <span class="small">/ month</span></p><p class="body-2">{plan.blurb}</p><p class="mono small">{infraLine(plan)}</p><p class="body-2">{SUPPORT[plan.id].tier} support {SUPPORT[plan.id].hoursPhrase}.</p><a class="btn btn-dark" href={url(`/buy?plan=${plan.id}&deploy=self-hosted&term=1`)}>Choose self-hosted {plan.name} <Arrow size={16} /></a></article>)}
      </div>
      <p class="small" style="margin-top: 24px">Monthly list prices exclude VAT. Annual and three-year billing discounts are available. Model-provider usage, inference hosting and notification-provider charges are separate. EagleSRE is in preview, with production entitlements as described on the pricing page.</p>
      <a class="text-link" href={url('/pricing#products')}>See every product and entitlement <Arrow size={16} /></a>
    </div>
  </section>

  <section class="dark">
    <div class="wrap cta-band">
      <div class="stack" style="gap: 18px"><h2 class="h2">Evaluate Max. Activate the plan that fits.</h2><p class="body-2" style="max-width: 660px">Get the Helm chart and a {DEMO.days}-day Max evaluation license. When you are ready, retain your installation and data, activate self-hosted Go, Pro or Max, and adjust resources for your chosen plan.</p></div>
      <div class="btn-row"><a class="btn btn-primary" href={url('/download')}>Get the Max demo <Arrow /></a><a class="btn btn-ghost" href={url('/download#activate')}>Activate an existing demo</a></div>
    </div>
  </section>
</Layout>

<style>
  #plans { scroll-margin-top: 96px; }
</style>
