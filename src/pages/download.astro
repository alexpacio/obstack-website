---
import Layout from "../layouts/Layout.astro";

const basePath = import.meta.env.BASE_URL || '';
---

<Layout title="Download Obstack Bee — Linux Observability Agent" description="Download Obstack Bee, the zero-code Linux observability agent. Choose from stable releases, nightly builds, or the Docker image.">
  <!-- Hero -->
  <section class="relative section overflow-hidden">
    <div class="container">
      <div class="text-center max-w-4xl mx-auto animate-slide-up">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-gray-900 mb-6">
          Download <span class="gradient-text">Obstack Bee</span>
        </h1>
        <p class="text-lg text-gray-600 mb-10 max-w-2xl mx-auto">
          Get the latest stable release of Obstack Bee, or explore other download options.
        </p>
      </div>
    </div>
    <div class="absolute inset-0 bg-grid opacity-50 pointer-events-none" aria-hidden="true"></div>
  </section>

  <!-- Latest Release -->
  <section class="section">
    <div class="container">
      <div class="mx-auto max-w-4xl">
        <article class="card card-bordered border-2 border-primary">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 mb-8">
            <div>
              <span class="badge badge-primary mb-4">Latest Stable</span>
              <h2 class="text-3xl font-bold text-gray-900 mb-2">Obstack Bee v1.0.0</h2>
              <p class="text-gray-600">Released July 29, 2026</p>
            </div>
            <div class="text-right">
              <p class="text-2xl font-bold text-gray-900">Apache-2.0</p>
              <p class="text-sm text-gray-500">License</p>
            </div>
          </div>

          <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <a
              href="https://github.com/netter/obstack-bee/releases/download/v1.0.0/obstack-bee-v1.0.0-x86_64-unknown-linux-gnu.tar.gz"
              class="flex flex-col items-center border border-gray-200 p-4 text-center hover:bg-gray-50 transition-colors"
            >
              <svg class="mb-2 h-8 w-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-4-4l-.586-.586a2 2 0 10-2.828 0L4 12v4h4z" />
              </svg>
              <span class="text-sm font-medium">Linux x86_64</span>
              <span class="text-xs text-gray-500">tar.gz</span>
            </a>

            <a
              href="https://github.com/netter/obstack-bee/releases/download/v1.0.0/obstack-bee-v1.0.0-aarch64-unknown-linux-gnu.tar.gz"
              class="flex flex-col items-center border border-gray-200 p-4 text-center hover:bg-gray-50 transition-colors"
            >
              <svg class="mb-2 h-8 w-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-4-4l-.586-.586a2 2 0 10-2.828 0L4 12v4h4z" />
              </svg>
              <span class="text-sm font-medium">Linux ARM64</span>
              <span class="text-xs text-gray-500">tar.gz</span>
            </a>

            <a
              href="https://github.com/netter/obstack-bee/releases/download/v1.0.0/obstack-bee-v1.0.0-docker.tar.gz"
              class="flex flex-col items-center border border-gray-200 p-4 text-center hover:bg-gray-50 transition-colors"
            >
              <svg class="mb-2 h-8 w-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l4-4m0 0l-4-4m4 4H8" />
              </svg>
              <span class="text-sm font-medium">Docker Image</span>
              <span class="text-xs text-gray-500">tar.gz</span>
            </a>

            <a
              href="https://hub.docker.com/r/obstack/bee"
              class="flex flex-col items-center border border-gray-200 p-4 text-center hover:bg-gray-50 transition-colors"
            >
              <svg class="mb-2 h-8 w-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-4-4l-.586-.586a2 2 0 10-2.828 0L4 12v4h4z" />
              </svg>
              <span class="text-sm font-medium">Docker Hub</span>
              <span class="text-xs text-gray-500">obstack/bee</span>
            </a>
          </div>

          <div class="mt-8 rounded-none bg-gray-950 p-6">
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-mono text-sm font-medium text-gray-300">Quick Install</h3>
              <button id="copy-install" class="text-sm text-primary hover:text-primary-light transition-colors">Copy</button>
            </div>
            <pre id="install-command" class="overflow-x-auto text-sm text-gray-300"><code>curl -L https://obstack.io/download/bee | tar xz -C /usr/local/bin</code></pre>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- All Releases -->
  <section class="section bg-gray-50">
    <div class="container">
      <div class="mx-auto max-w-4xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 mb-4">All Releases</h2>
          <p class="text-lg text-gray-600">Browse all available versions of Obstack Bee.</p>
        </div>

        <div class="overflow-x-auto">
          <table class="table">
            <thead>
              <tr>
                <th>Version</th>
                <th>Release Date</th>
                <th>Assets</th>
                <th>License</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200/50">
              <tr class="hover:bg-white/50 transition-colors">
                <td class="font-medium text-gray-900">
                  <a href="https://github.com/netter/obstack-bee/releases/tag/v1.0.0" class="text-primary hover:underline">v1.0.0</a>
                </td>
                <td class="text-gray-600">July 29, 2026</td>
                <td>
                  <a href="https://github.com/netter/obstack-bee/releases/download/v1.0.0/obstack-bee-v1.0.0-x86_64-unknown-linux-gnu.tar.gz" class="text-primary hover:underline">Linux x86_64</a>
                  <span class="mx-2 text-gray-300">·</span>
                  <a href="https://github.com/netter/obstack-bee/releases/download/v1.0.0/obstack-bee-v1.0.0-aarch64-unknown-linux-gnu.tar.gz" class="text-primary hover:underline">Linux ARM64</a>
                </td>
                <td class="text-gray-600">Apache-2.0</td>
              </tr>
              <tr class="hover:bg-white/50 transition-colors">
                <td class="font-medium text-gray-900">
                  <a href="https://github.com/netter/obstack-bee/releases/tag/v0.9.0" class="text-primary hover:underline">v0.9.0 (Beta)</a>
                </td>
                <td class="text-gray-600">June 15, 2026</td>
                <td>
                  <a href="https://github.com/netter/obstack-bee/releases/download/v0.9.0/obstack-bee-v0.9.0-x86_64-unknown-linux-gnu.tar.gz" class="text-primary hover:underline">Linux x86_64</a>
                </td>
                <td class="text-gray-600">Apache-2.0</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Installation Guide -->
  <section class="section">
    <div class="container">
      <div class="mx-auto max-w-4xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 mb-4">Installation Guide</h2>
        </div>

        <div class="space-y-8">
          <article class="card">
            <div class="flex items-center gap-3 mb-4">
              <span class="flex h-10 w-10 items-center justify-center bg-primary/10 text-primary rounded-none">1</span>
              <h3 class="text-lg font-semibold text-gray-900">Download</h3>
            </div>
            <pre class="rounded-none bg-gray-950 p-4 text-sm text-gray-300"><code>curl -L https://obstack.io/download/bee | tar xz -C /usr/local/bin</code></pre>
          </article>

          <article class="card">
            <div class="flex items-center gap-3 mb-4">
              <span class="flex h-10 w-10 items-center justify-center bg-primary/10 text-primary rounded-none">2</span>
              <h3 class="text-lg font-semibold text-gray-900">Validate</h3>
            </div>
            <pre class="rounded-none bg-gray-950 p-4 text-sm text-gray-300"><code>obstack-bee validate --config config/obstack-bee.yaml</code></pre>
          </article>

          <article class="card">
            <div class="flex items-center gap-3 mb-4">
              <span class="flex h-10 w-10 items-center justify-center bg-primary/10 text-primary rounded-none">3</span>
              <h3 class="text-lg font-semibold text-gray-900">Run</h3>
            </div>
            <pre class="rounded-none bg-gray-950 p-4 text-sm text-gray-300"><code>sudo obstack-bee run --config config/obstack-bee.yaml</code></pre>
          </article>
        </div>

        <div class="mt-12 text-center">
          <a href="https://docs.obstack.io/bee" class="inline-flex items-center gap-2 text-primary hover:underline">
            <span>Read full documentation</span>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7l-7 7" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var btn = document.getElementById('copy-install');
      var codeBlock = document.getElementById('install-command');

      btn.addEventListener('click', function() {
        var code = codeBlock.textContent.trim();
        navigator.clipboard.writeText(code).then(function() {
          btn.textContent = 'Copied!';
          setTimeout(function() {
            btn.textContent = 'Copy';
          }, 2000);
        });
      });
    });
  </script>
</Layout>