---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import Comparison from '../components/Comparison.astro';
import PricingTable from '../components/PricingTable.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import { url } from '../lib/url';

const trace = [
  { name: 'POST /api/checkout', indent: 0, start: 0, width: 100, ms: '812 ms', color: '#19B8E2' },
  { name: 'redis GET cart:*', indent: 1, start: 2, width: 1.2, ms: '2 ms', color: '#2ED0C3' },
  { name: 'mysql SELECT … orders', indent: 1, start: 4, width: 5, ms: '41 ms', color: '#2ED0C3' },
  { name: 'await reserveStock()', indent: 1, start: 11, width: 78, ms: '640 ms', color: '#63E8B0', hot: true },
  { name: 'HTTPS POST /reserve', indent: 2, start: 13, width: 73, ms: '598 ms', color: '#2ED0C3' },
];

const steps = [
  ['Trace', 'Distributed traces inside a microservice, between processes on the same host, and across hosts over gossip.'],
  ['Profile', 'On-CPU and await stacks tied to the request that held them. Profiling is the same evidence as the trace, not a second product.'],
  ['Correlate', 'Links hops and async waits only where socket, stream or runtime evidence proves it.'],
  ['Export', 'Sends OTLP over HTTP to any OpenTelemetry collector and serves Prometheus metrics locally.'],
];

const qualities = [
  ['In-kernel capture that never gets in the way', 'Aya cgroup-skb programs filter TCP in the kernel and keep per-CPU flow aggregates. Bee never blocks or drops a packet: filtering only decides what gets observed.', 'eBPF · cgroup ingress/egress · OpenSSL uprobes'],
  ['Protocols parsed to the field', 'HTTP/1 with pipelining, HTTP/2 and gRPC with HPACK state, TLS handshakes with SNI and ALPN. Full MySQL query text with typed prepared-statement parameters. Redis RESP2 and RESP3.', 'HTTP/1 · HTTP/2 · gRPC · TLS 1.2/1.3 · MySQL · Redis'],
  ['Node.js awaits, named', 'Promise probes capture a bounded stack at the exact await boundary. Bee reads V8 frames using the layout constants the Node binary itself exports, and emits a span only once an observed socket proves which request it belongs to.', 'Node.js ≥ 22 · process_vm_readv · v8dbg_*'],
  ['Evidence, never guesses', 'Parent–child edges come from socket cookies, HTTP/2 stream ids, MySQL statements, W3C traceparent and authenticated hops between agents. Timestamp overlap proves nothing, so without proof a span ships as an honest root.', 'unmeasured values are labelled, never zero'],
  ['Intra-service and intra-host', 'Bee follows a request through awaits, SQL and Redis inside one process, then across local sockets to other processes on the same machine. Cross-host hops continue the same trace over gossip.', 'intra-microservice · intra-host · gossip'],
  ['Works with your collector', 'Batches go over one persistent OTLP/HTTP connection to any OpenTelemetry collector: Vector, the OpenTelemetry Collector or your vendor’s endpoint. If it goes down, finished batches wait up to five minutes in a fixed on-disk ring.', 'OTLP/HTTP protobuf · rustls · at-most-once'],
];

const gossip = [
  ['No coordinator', 'Membership, liveness and peer addresses live on the agents. There is no extra process to deploy, scale or lose when a request hops machines.'],
  ['Gossip between Bees', 'Each node talks to a few peers. Who is up, how to reach them, and enough identity to continue a trace travel with the gossip — not through a central correlator.'],
  ['One trace across hosts', 'When a request leaves one Linux box for another, Bee authenticates the hop and continues the W3C trace. The next agent already knows who sent it.'],
  ['On your network only', 'Gossip stays inside the fleet. Nothing phones home to stitch traces together. Air-gapped delivery and offline updates are quoted as Enterprise, not on the list plans.'],
];

const othersWin = [
  'PostgreSQL, Kafka or MongoDB today. They are on Bee’s roadmap; Beyla covers them now, and ships in the Obstack Stack.',
  'ARM64, Windows, or any distro other than Ubuntu 24.04 and 26.04.',
  'Framework-aware spans inside Java, .NET or Python services.',
];
---

<Layout
  title="Obstack Bee · distributed tracing and profiling"
  description="Bee does distributed tracing and profiling inside a microservice and across processes on the host, then continues the same trace across hosts. No SDK, no coordinator."
  active="bee"
>
  <section class="hero">
    <div class="wrap hero-grid bee-hero">
      <div class="stack" style="gap: 26px">
        <div class="eyebrow rise">Obstack Bee</div>
        <h1 class="display rise">Distributed tracing and profiling. Inside the service, on the host.</h1>
        <p class="lead rise-2">Bee traces and profiles every process on a Linux host: inside a microservice, between services on the same machine, then across hosts over gossip. HTTP, gRPC, TLS, MySQL and Redis from the kernel, named Node.js awaits, no SDK and no coordinator.</p>
        <div class="btn-row rise-2" style="padding-top: 8px">
          <a class="btn btn-primary" href="#pricing">Buy Bee <Arrow /></a>
          <ObfuscatedEmail label="Request an evaluation license" class="btn btn-ghost" subject="Bee evaluation license" />
        </div>
      </div>

      <figure class="trace rise-3" aria-label="Example trace produced by Bee">
        <div class="t-head mono"><span>Example trace · checkout-api</span><span>812 ms</span></div>
        <div class="t-rows mono">
          {trace.map((r) => (
            <div class:list={['t-row', { hot: r.hot }]}>
              <span class="t-name" style={`padding-left:${r.indent * 14}px`}>{r.name}</span>
              <div class="t-track"><div class="t-bar" style={`margin-left:${r.start}%;width:${r.width}%;background:${r.color}`}></div></div>
              <span class="t-ms">{r.ms}</span>
            </div>
          ))}
        </div>
        <figcaption class="t-foot mono">
          <span><b>code.function</b> reserveStock · src/inventory.js:88</span>
          <span><b>parent proven by</b> socket cookie · traceparent</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">01 / What Bee does</div>
          <h2 class="h2">Trace and profile. One binary, no coordinator.</h2>
        </div>
      </div>
      <div class="grid-4 rule-top four">
        {steps.map(([t, d]) => (
          <div class="stack">
            <span class="mono">→ {t}</span>
            <p class="body-2">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">02 / Under the hood</div>
          <h2 class="h2">Built for the engineer who reads the trace and asks how it knows.</h2>
        </div>
      </div>
      <div class="tile-grid grid-3">
        {qualities.map(([t, d, m]) => (
          <div>
            <h3 class="h3" style="font-size: 20px">{t}</h3>
            <p class="body-2" style="font-size: 15px">{d}</p>
            <div class="tile-meta">{m}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="dark">
    <div class="wrap section bounded">
      <div class="stack" style="gap: 20px">
        <div class="eyebrow">03 / Distributed traces</div>
        <h2 class="h2">One trace: inside the service, on the host, across hosts.</h2>
        <p class="body-2" style="font-size: 17px">Bee already follows a request through awaits and local sockets on one machine. Gossip continues that same distributed trace when it hops hosts — no coordinator to run, scale or lose. Profiling rides along: the stack that held the request, not a dump from somewhere else.</p>
      </div>
      <div class="gossip">
        {gossip.map(([t, d]) => (
          <div>
            <h3 class="h3" style="font-size: 18px">{t}</h3>
            <p class="body-2" style="font-size: 15px">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">04 / How Bee compares</div>
          <h2 class="h2">Bee next to Grafana Beyla, Dynatrace and Datadog.</h2>
        </div>
        <p class="body-2">Beyla is the open-source eBPF agent Bee's architecture follows. Dynatrace and Datadog are the platforms most teams pay for today. Bee covers fewer things than any of them, and goes deeper on the ones it covers.</p>
      </div>
      <Comparison />
      <div class="others">
        <div class="stack" style="gap: 12px">
          <h3 class="h3">Where the others win</h3>
          <p class="body-2" style="font-size: 15px">We would rather you hear it from us. Pick something else if you need:</p>
        </div>
        <ul>{othersWin.map((o) => <li>{o}</li>)}</ul>
      </div>
      <p class="mono reviewed">Based on each vendor's public documentation, reviewed September 2026.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="panel grid-2 runs">
        <div class="stack">
          <div class="eyebrow">05 / Runs on</div>
          <h2 class="h2" style="font-size: 32px">A package per node. Pods stay untouched.</h2>
          <div class="matrix mono">
            <div><span>Ubuntu 24.04 LTS</span><span>.deb</span></div>
            <div><span>Ubuntu 26.04 LTS</span><span>.deb</span></div>
            <div><span>Kubernetes</span><span>one agent per Ubuntu node</span></div>
            <div><span>Requires</span><span>x86-64 · cgroup v2 · BTF</span></div>
          </div>
        </div>
        <div class="stack">
          <div class="eyebrow">PolyForm Internal Use</div>
          <h2 class="h2" style="font-size: 32px">Source and updates while you subscribe.</h2>
          <p class="body-2" style="font-size: 15px">Bee is released under the <a class="text-link" href="https://polyformproject.org/licenses/internal-use/1.0.0">PolyForm Internal Use License</a>: use and change it for your own operations; do not distribute it. An active subscription is how you get the source and every update. Stop paying and updates stop.</p>
          <pre class="code"><span class="p">$ </span>sudo apt install ./obstack-bee_0.2.4_amd64.deb
<span class="p">$ </span>curl http://127.0.0.1:9400/healthz</pre>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight" id="pricing">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">06 / Pricing</div>
          <h2 class="h2">Per node, per month. Nothing metered.</h2>
        </div>
        <p class="body-2" style="font-size: 15px">Bee on its own, or inside the full stack. Every plan includes distributed tracing and profiling, intra-service and intra-host, all protocols and Node.js await naming.</p>
      </div>
      <PricingTable variant="bee" />
    </div>
  </section>
</Layout>

<style>
  .bee-hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }

  .trace { margin: 0; background: #080D10; border: 1px solid rgba(232, 241, 242, 0.14); border-radius: 14px; overflow: hidden; box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.6); min-width: 0; }
  .t-head { display: flex; justify-content: space-between; padding: 14px 20px; border-bottom: 1px solid var(--on-dark-line); font-size: 12px; color: var(--on-dark-3); letter-spacing: 0.06em; text-transform: uppercase; }
  .t-rows { padding: 10px 0; font-size: 12.5px; }
  .t-row { display: grid; grid-template-columns: minmax(0, 250px) minmax(0, 1fr) 64px; gap: 14px; align-items: center; padding: 9px 20px; color: var(--on-dark-2); }
  .t-row:first-child { color: var(--on-dark); }
  .t-row.hot { background: rgba(99, 232, 176, 0.07); box-shadow: inset 2px 0 0 var(--mint); color: var(--mint); }
  .t-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .t-track { height: 10px; background: rgba(232, 241, 242, 0.05); }
  .t-bar { height: 10px; transform-origin: left; animation: grow 0.9s 0.3s cubic-bezier(.2, .7, .2, 1) both; }
  .t-ms { text-align: right; }
  .t-foot { display: flex; flex-direction: column; gap: 6px; padding: 16px 20px; border-top: 1px solid var(--on-dark-line); font-size: 12px; color: var(--on-dark-3); }
  .t-foot b { color: var(--on-dark); font-weight: 500; }
  @keyframes grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .four > .stack { gap: 12px; padding: 28px 28px 0; border-left: 1px solid var(--line); }
  .four > .stack:first-child { padding-left: 0; border-left: none; }
  .four .mono { font-size: 13px; color: var(--link); font-weight: 700; text-transform: uppercase; }

  .bounded { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 72px; align-items: start; }
  .gossip { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--on-dark-line); align-self: stretch; }
  .gossip > div { background: var(--night); padding: 24px 28px 28px; display: flex; flex-direction: column; gap: 10px; }
  .gossip .h3 { color: var(--on-dark-strong); }
  .gossip .body-2 { color: var(--on-dark-2); }

  .others { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 56px; padding-top: 48px; }
  .others ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 40px; }
  .others li { display: flex; gap: 12px; font-size: 15px; line-height: 1.6; }
  .others li::before { content: "—"; font-family: var(--font-mono); color: var(--link); }
  .reviewed { font-size: 12px; color: var(--muted); margin-top: 40px; }

  .runs > .stack { padding: 48px; gap: 24px; }
  .runs > .stack + .stack { border-left: 1px solid var(--line); }
  .matrix { display: flex; flex-direction: column; font-size: 13px; }
  .matrix div { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line-soft); }
  .matrix div:last-child { border-bottom: none; }
  .matrix span + span { color: var(--text-2); text-align: right; }

  @media (max-width: 1100px) {
    .bee-hero { grid-template-columns: minmax(0, 1fr); }
    .bounded { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .four > .stack:nth-child(3) { padding-left: 0; border-left: none; }
    .others { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  }
  @media (max-width: 800px) {
    .t-row { grid-template-columns: minmax(0, 1fr) 52px; gap: 8px; padding: 8px 14px; font-size: 11px; }
    .t-track { grid-column: 1 / -1; grid-row: 2; }
    .t-head, .t-foot { padding-left: 14px; padding-right: 14px; }
    .four > .stack, .four > .stack:first-child { padding: 20px 0 0; border-left: none; }
    .gossip { grid-template-columns: minmax(0, 1fr); }
    .gossip > div { padding: 20px 0; background: transparent; }
    .others ul { grid-template-columns: minmax(0, 1fr); }
    .runs > .stack { padding: 24px; }
    .runs > .stack + .stack { border-left: none; border-top: 1px solid var(--line); }
    .matrix { font-size: 12px; }
  }
</style>
