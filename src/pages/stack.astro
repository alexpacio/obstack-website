---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import { url } from '../lib/url';
import { PAGEROOT, STORAGE, findPlan, formatPrice } from '../data/plans';

const stackPlan = findPlan('stack');
const cloud = findPlan('cloud');

const services = [
  ['Infrastructure, configured', 'We deploy and configure every component for your environment: agents on your nodes, Vector pipelines, Kafka where it helps, GreptimeDB with retention and object storage, Grafana and Prometheus Alertmanager. PageRoot if you add the module.'],
  ['Reference dashboards', 'Grafana arrives connected to your data, with reference dashboards for hosts and Bee, so the first login shows your fleet, not an empty canvas.'],
  ['Custom work, quoted first', 'Dashboards built for your services, alert rules and routing, migration of your current dashboards, alerts, workflows and incidents: billed on time and materials, from a written quote you approve before we start.'],
  ['Storage in your datacenter', `Telemetry lands in Obstack storage at ${formatPrice(STORAGE.pricePerGb, 'usd')} per GB per month, in the EU or US datacenter you pick.`],
];

const components: {
  layer: string;
  name: string;
  role: string;
  text: string;
  ours?: boolean;
  optional?: boolean;
  href?: string;
}[] = [
  { layer: 'Collect', name: 'Bee', role: 'Application agent', text: 'Distributed tracing and profiling inside a microservice and on the host: HTTP, gRPC, TLS, MySQL, Redis and named Node.js awaits, no coordinator.', ours: true, href: url('/bee') },
  { layer: 'Collect', name: 'Grafana Beyla', role: 'Broad eBPF coverage', text: 'Covers the runtimes and protocols Bee does not reach yet, such as PostgreSQL, Kafka and MongoDB, with the same zero-code model.' },
  { layer: 'Ship', name: 'Vector', role: 'Node-local collector', text: 'Receives OTLP from the agents, collects host metrics and logs, and routes every signal onward.' },
  { layer: 'Ship', name: 'Kafka', role: 'Buffer, when needed', text: 'Sits between collectors and storage for large or bursty fleets, so storage maintenance never costs you data.', optional: true },
  { layer: 'Store', name: 'GreptimeDB', role: 'Telemetry database', text: 'Metrics, logs and traces in one database, queried with SQL and PromQL.' },
  { layer: 'See', name: 'Grafana', role: 'Dashboards and MCP', text: 'Exploration and dashboards on the tool your team already knows, with reference dashboards for Bee, plus the Grafana MCP server for agents.', href: url('/grafana') },
  { layer: 'Act', name: 'Prometheus Alertmanager', role: 'Alert routing', text: 'Groups, inhibits, silences and routes firing alerts from Prometheus and Grafana onto receivers. The Prometheus-native half of paging.' },
  { layer: 'Act', name: 'PageRoot', role: 'On-call and incidents', text: `Optional module: schedules, escalation chains, ChatOps and a built-in MCP server. ${formatPrice(PAGEROOT.selfHosted, 'usd')} per user self-hosted, ${formatPrice(PAGEROOT.cloud, 'usd')} on Obstack Cloud.`, ours: true, optional: true, href: url('/pageroot') },
  { layer: 'Act', name: 'Grafana MCP server', role: 'Access for agents', text: 'Lets AI assistants, and our AI SRE agent, query dashboards and datasources through Grafana RBAC. Ships with Grafana in the stack.', href: url('/grafana#mcp') },
];
---

<Layout
  title="Obstack Stack · Bee, Beyla, Vector, GreptimeDB, Grafana and Alertmanager"
  description="The Obstack Stack: Bee and Beyla for collection, Vector and Kafka for transport, GreptimeDB for storage, Grafana for dashboards, Prometheus Alertmanager for alert routing, the Grafana MCP server, and optional PageRoot for on-call."
  active="stack"
>
  <section class="hero">
    <div class="wrap stack-hero">
      <div class="stack" style="gap: 26px; max-width: 900px">
        <div class="eyebrow rise">Obstack Stack</div>
        <h1 class="display rise">A complete observability stack, running on your servers.</h1>
        <p class="lead rise-2" style="max-width: 680px">Eight components, chosen to fit together, configured by us around Bee and supported as one product. PageRoot, the on-call module, is optional. Open standards at every seam, so no part of it locks you in.</p>
        <div class="btn-row rise-2" style="padding-top: 8px">
          <a class="btn btn-primary" href={url('/pricing?plan=stack#configure')}>Configure the stack · from {formatPrice(stackPlan.price, 'usd')} / node / month <Arrow /></a>
          <ObfuscatedEmail label="Talk to us" class="btn btn-ghost" subject="Obstack Stack" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">01 / What's inside</div>
          <h2 class="h2">Every component has one job.</h2>
        </div>
        <p class="body-2">Bee is ours. PageRoot, when you add it, is ours too. The rest are open-source projects we deploy, wire together and support, so you get one product instead of eight integrations.</p>
      </div>
      <div class="tile-grid grid-4 parts">
        {components.map((c) => (
          <div class:list={{ ours: c.ours }}>
            <div class="part-top">
              <span class="mono layer">{c.layer}</span>
              <span class="part-badges">
                {c.ours && <span class="badge badge-mint">Obstack</span>}
                {c.optional && <span class="badge badge-dashed">Optional</span>}
              </span>
            </div>
            <h3 class="h3">{c.name}</h3>
            <span class="role">{c.role}</span>
            <p class="body-2" style="font-size: 15px">{c.text}</p>
            {c.href && <a class="text-link" href={c.href} style="font-size: 13px">How it works <Arrow size={16} /></a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">02 / Setup and migration</div>
          <h2 class="h2">We build it for you. Anything custom is quoted first.</h2>
        </div>
        <p class="body-2">Setup is part of the full Obstack Stack, self-hosted or on Obstack Cloud: you get a working observability platform, not a box of parts. Tailoring it to your team is billed on time and materials.</p>
      </div>
      <div class="tile-grid grid-4">
        {services.map(([t, d]) => (
          <div>
            <h3 class="h3" style="font-size: 20px">{t}</h3>
            <p class="body-2" style="font-size: 15px">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="dark">
    <div class="wrap section flow-sec">
      <div class="stack" style="gap: 16px; max-width: 760px">
        <div class="eyebrow">03 / Data flow</div>
        <h2 class="h2">From the kernel to the person on call.</h2>
      </div>
      <div class="diagram-wrap">
        <svg class="diagram" viewBox="0 0 1180 300" role="img" aria-label="Bee and Beyla send OTLP to Vector, optionally through Kafka, into GreptimeDB; Grafana reads from it; Prometheus Alertmanager routes alerts to PageRoot; PageRoot's MCP server serves the AI SRE agent">
          <g font-family="M PLUS 1 Code, monospace" font-size="13">
            <g fill="none" stroke="#2ED0C3" stroke-width="1.5">
              <path d="M190 90 H250"></path><path d="M190 190 H220 V110 H250"></path>
              <path d="M410 100 H470"></path>
              <path d="M630 100 H690"></path>
              <path d="M850 100 H890 V60 H930"></path><path d="M850 100 H890 V150 H930"></path>
              <path d="M1030 180 V230"></path>
            </g>
            <g fill="#2ED0C3"><path d="M250 90 l-8 -5 v10 z"></path><path d="M250 110 l-8 -5 v10 z"></path><path d="M470 100 l-8 -5 v10 z"></path><path d="M690 100 l-8 -5 v10 z"></path><path d="M930 60 l-8 -5 v10 z"></path><path d="M930 150 l-8 -5 v10 z"></path><path d="M1030 230 l-5 -8 h10 z"></path></g>

            <rect x="30" y="60" width="160" height="60" fill="#63E8B0"></rect>
            <text x="48" y="96" fill="#0A1F2E" font-weight="700">Bee</text>
            <rect x="30" y="160" width="160" height="60" fill="none" stroke="#63E8B0" stroke-width="1.5"></rect>
            <text x="48" y="196" fill="#E8F1F2">Beyla</text>

            <rect x="250" y="70" width="160" height="60" fill="none" stroke="#E8F1F2" stroke-width="1.5"></rect>
            <text x="268" y="106" fill="#E8F1F2">Vector</text>

            <rect x="470" y="70" width="160" height="60" fill="none" stroke="#7FA3B3" stroke-width="1.5" stroke-dasharray="5 5"></rect>
            <text x="488" y="106" fill="#A9BEC6">Kafka (optional)</text>

            <rect x="690" y="70" width="160" height="60" fill="#174D6B" stroke="#2ED0C3" stroke-width="1.5"></rect>
            <text x="708" y="106" fill="#E8F1F2">GreptimeDB</text>

            <rect x="930" y="30" width="200" height="60" fill="none" stroke="#E8F1F2" stroke-width="1.5"></rect>
            <text x="948" y="66" fill="#E8F1F2">Grafana · Eagle soon</text>
            <rect x="930" y="120" width="200" height="60" fill="none" stroke="#E8F1F2" stroke-width="1.5"></rect>
            <text x="948" y="156" fill="#E8F1F2">Alertmanager</text>

            <rect x="930" y="230" width="200" height="60" fill="none" stroke="#63E8B0" stroke-width="1.5" stroke-dasharray="5 5"></rect>
            <text x="948" y="266" fill="#63E8B0">PageRoot · MCP</text>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <section class="section-tight" id="grafana-screenshots">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">04 / Grafana</div>
          <h2 class="h2">Dashboards and traces in the Grafana your team already knows.</h2>
          <a class="text-link" href={url('/grafana')}>How Grafana and its MCP work <Arrow size={16} /></a>
        </div>
        <p class="body-2">Grafana is the exploration layer in the stack, with the Grafana MCP server for agents. Your deployment arrives with reference dashboards for hosts and Bee, wired to your data. The shots below are Grafana itself: a distributed trace next to its logs, and a RED-metrics dashboard of request rate, errors, latency and host resources.</p>
      </div>
      <div class="grafana-shots">
        <figure>
          <img src={url('/images/grafana_tracing.png')} alt="Grafana Explore showing logs and a distributed trace for one request" width="2335" height="2715" loading="lazy" />
          <figcaption>Grafana Explore: logs and a distributed trace for the same request.</figcaption>
        </figure>
        <figure>
          <img src={url('/images/grafana_sli_slo.png')} alt="Grafana dashboard of request rate, errors, latency, CPU and memory" width="1000" height="460" loading="lazy" />
          <figcaption>Grafana dashboard: request rate, errors, latency, CPU and memory.</figcaption>
        </figure>
      </div>
      <div class="tile-grid grid-2 grafana-notes">
        <div>
          <h3 class="h3" style="font-size: 20px">Why Obstack Cloud costs more</h3>
          <p class="body-2" style="font-size: 15px">Obstack Cloud is priced higher ({formatPrice(cloud.price, 'usd')} / node / month vs {formatPrice(stackPlan.price, 'usd')} self-hosted) because it includes full infrastructure operation: managed Vector, GreptimeDB, Grafana and Alertmanager; region-specific deployment; automatic upgrades; backups; monitoring; 99.9% uptime SLA; and 24/7 P1 support. Self-hosted customers run the backend themselves. PageRoot is an optional module on either deployment.</p>
        </div>
        <div>
          <h3 class="h3" style="font-size: 20px">Professional Services are quoted in advance</h3>
          <p class="body-2" style="font-size: 15px">Creating custom dashboards, wiring components, designing alert rules, migrating existing dashboards and building bespoke projects are billed on time and materials. Every request is estimated in a written quote you approve before any work starts; then we invoice the time actually spent. Nothing is charged without your prior agreement.</p>
        </div>
      </div>
      <p class="mono fx-note">Prices shown in USD, which are 25% above the euro list. Switch the configurator to EUR for euro amounts. The invoice is issued in the currency you pick.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2 pair">
      <div class="stack">
        <div class="eyebrow">05 / Bee and Beyla together</div>
        <h2 class="h2">Deep where it matters, broad everywhere else.</h2>
      </div>
      <div class="stack" style="gap: 18px">
        <p class="body-2">Bee traces and profiles inside a microservice and across processes on the host, then continues the same distributed trace across machines. Named Node.js awaits, full MySQL queries, evidence-only links, no coordinator.</p>
        <p class="body-2">Beyla covers the long tail with broader protocol and runtime support. Both speak OTLP to the same Vector, so every trace lands in the same place and your dashboards don't care which agent saw it.</p>
        <a class="text-link" href={url('/bee')}>Read how Bee works <Arrow size={16} /></a>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap grid-2 pair">
      <div class="stack">
        <div class="eyebrow">06 / Alertmanager and PageRoot</div>
        <h2 class="h2">Alert routing, then the people on call.</h2>
      </div>
      <div class="stack" style="gap: 18px">
        <p class="body-2">Prometheus Alertmanager groups, inhibits, silences and routes firing alerts from Prometheus and Grafana. It is the receiver layer operators already know.</p>
        <p class="body-2">PageRoot is the optional on-call module: schedules, escalation chains, ChatOps and a built-in MCP server. {formatPrice(PAGEROOT.selfHosted, 'usd')} per user self-hosted, {formatPrice(PAGEROOT.cloud, 'usd')} on Obstack Cloud — a fraction of PagerDuty or Rootly.</p>
        <a class="text-link" href={url('/pageroot')}>Read how PageRoot compares <Arrow size={16} /></a>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap grid-2 next">
      <article class="panel">
        <div class="next-top"><h3 class="h3">AI SRE agent</h3><span class="badge badge-dashed">Early access</span></div>
        <p class="body-2">Works incidents alongside your on-call through PageRoot's MCP server and the Grafana MCP server, reading the same telemetry and alert groups your team does, without it leaving your infrastructure.</p>
        <ObfuscatedEmail label="Request early access" class="text-link" subject="AI SRE agent early access" />
      </article>
      <article class="panel">
        <div class="next-top"><h3 class="h3">Eagle</h3><span class="badge badge-line">Coming soon</span></div>
        <p class="body-2">Our own console, an alternative to Grafana, built for the Obstack data model. It will join the stack as an option next to Grafana, not a forced replacement.</p>
        <ObfuscatedEmail label="Hear when it ships" class="text-link" subject="Eagle updates" />
      </article>
    </div>
  </section>

  <section class="dark">
    <div class="wrap cta-band">
      <div class="stack" style="gap: 18px">
        <h2 class="h2">On your servers, or run by us.</h2>
        <p class="body-2" style="font-size: 18px; max-width: 620px">{formatPrice(stackPlan.price, 'usd')} per node per month self-hosted, or {formatPrice(cloud.price, 'usd')} per node plus {formatPrice(STORAGE.pricePerGb, 'usd')} per GB when we run it for you, in the region you choose. PageRoot is optional. Every included component above, set up by us, one support contract.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" href={url('/buy?plan=stack')}>Buy the stack</a>
        <a class="btn btn-ghost" href={url('/buy?plan=cloud')}>Buy Obstack Cloud</a>
        <a class="btn btn-ghost" href={url('/pricing')}>Compare plans</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .stack-hero { padding-top: 96px; padding-bottom: 104px; }

  .parts > div { gap: 10px; }
  .parts > .ours { background: var(--mint-wash); }
  .part-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; min-height: 24px; }
  .part-badges { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
  .layer { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--link); font-weight: 700; }
  .role { font-size: 14px; font-weight: 700; color: var(--text-2); }

  .flow-sec { display: flex; flex-direction: column; gap: 48px; }
  .diagram-wrap { overflow-x: auto; }
  .diagram { width: 100%; min-width: 900px; height: auto; }

  .grafana-shots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: start; }
  .grafana-shots figure { margin: 0; }
  .grafana-shots img { width: 100%; height: 420px; object-fit: cover; object-position: top left; border-radius: 12px; border: 1px solid var(--line); display: block; background: #111; }
  .grafana-shots figcaption { font-size: 13px; color: var(--text-2); margin-top: 8px; line-height: 1.5; }
  .grafana-notes { margin-top: 32px; }
  .fx-note { margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 13px; color: var(--text-2); }

  .pair { gap: 72px; align-items: start; }

  .next { gap: 24px; }
  .next .panel { padding: 36px; display: flex; flex-direction: column; gap: 16px; }
  .next-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }

  @media (max-width: 1100px) {
    .pair { gap: 24px; }
  }
  @media (max-width: 800px) {
    .stack-hero { padding-top: 48px; padding-bottom: 56px; }
    .grafana-shots { grid-template-columns: minmax(0, 1fr); }
    .grafana-shots img { height: 220px; }
    .diagram { min-width: 640px; }
    .next .panel { padding: 24px; }
  }
</style>
