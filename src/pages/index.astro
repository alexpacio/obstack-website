---
import Layout from "../layouts/Layout.astro";

const basePath = import.meta.env.BASE_URL || '';
---

<Layout title="Obstack — The Ultimate Observability Stack" description="Obstack is the ultimate observability stack for businesses who want to internalize and automate their observability needs. Start with Bee, the zero-code Linux observability agent.">
  <!-- Hero -->
  <section class="relative section overflow-hidden">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Hero Content -->
        <div class="text-center lg:text-left animate-slide-up">
          <div class="inline-flex items-center gap-2 rounded-none border border-primary/30 bg-primary/10 px-3 py-1 text-sm font-medium text-primary mb-6">
            <span class="relative flex h-2 w-2">
              <span class="absolute inset-0 bg-primary rounded-none animate-pulse"></span>
              <span class="absolute inset-0 bg-primary rounded-none"></span>
            </span>
            Now Available — v1.0.0
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-gray-900 mb-6">
            The Ultimate <span class="gradient-text">Observability Stack</span>
          </h1>
          <p class="text-lg sm:text-xl text-gray-600 max-w-2xl mx-auto lg:mx-0 mb-10">
            Internalize and automate your observability needs with Obstack.
            Zero-code, zero-overhead, built for production Linux environments.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
            <a
              href={`${basePath}/download`}
              class="btn-primary"
              >Download Bee</a
            >
            <a
              href={`${basePath}/demo`}
              class="btn-secondary"
              >Request a Demo</a
            >
          </div>
          <div class="mt-8 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-sm text-gray-500">
            <div class="flex items-center gap-2">
              <svg class="h-4 w-4 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Zero-code deployment</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="h-4 w-4 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>eBPF + V8 profiling</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="h-4 w-4 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>OTLP export</span>
            </div>
          </div>
        </div>

        <!-- Hero Illustration -->
        <div class="relative animate-fade-in" style="animation-delay: 200ms;">
          <div class="relative aspect-square max-w-lg mx-auto lg:max-w-none">
            <img
              src="/images/hero-architecture.svg"
              alt="Obstack Bee Architecture - eBPF agent capturing HTTP/1.1, TLS, gRPC, Redis, MySQL and exporting via OTLP to Vector"
              class="w-full h-auto"
            />
            <!-- Floating badges -->
            <div class="absolute -top-4 -right-4 lg:top-4 lg:right-4 hidden lg:block animate-fade-in" style="animation-delay: 400ms;">
              <div class="bg-white border border-border px-4 py-3 shadow-xl">
                <div class="flex items-center gap-3">
                  <div class="flex h-2 w-2 bg-success rounded-none animate-pulse"></div>
                  <div>
                    <p class="text-xs font-medium text-gray-900">Active Capture</p>
                    <p class="text-xs text-gray-500 font-mono">12,847 spans/s</p>
                  </div>
                </div>
              </div>
            </div>
            <div class="absolute -bottom-4 -left-4 lg:bottom-4 lg:left-4 hidden lg:block animate-fade-in" style="animation-delay: 600ms;">
              <div class="bg-white border border-border px-4 py-3 shadow-xl">
                <div class="flex items-center gap-3">
                  <div class="flex h-2 w-2 bg-warning rounded-none"></div>
                  <div>
                    <p class="text-xs font-medium text-gray-900">Bounded Memory</p>
                    <p class="text-xs text-gray-500 font-mono">47.2 MB / 512 MB</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Background accent -->
    <div class="absolute inset-0 bg-grid opacity-50 pointer-events-none" aria-hidden="true"></div>
  </section>

  <!-- Trusted by / Logos placeholder -->
  <section class="py-12 border-y border-border/50">
    <div class="container">
      <p class="text-center text-xs font-medium text-gray-400 uppercase tracking-wider mb-8">Trusted by engineering teams at</p>
      <div class="flex flex-wrap items-center justify-center gap-12 opacity-60">
        <span class="text-sm font-mono text-gray-400">Linux 7.0+</span>
        <span class="text-sm font-mono text-gray-400">Node.js 24</span>
        <span class="text-sm font-mono text-gray-400">OTLP/HTTP</span>
        <span class="text-sm font-mono text-gray-400">Vector</span>
        <span class="text-sm font-mono text-gray-400">Prometheus</span>
        <span class="text-sm font-mono text-gray-400">Grafana</span>
      </div>
    </div>
  </section>

  <!-- The Stack -->
  <section class="section">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 mb-4">
          The Obstack Stack
        </h2>
        <p class="text-lg text-gray-600">
          A suite of purpose-built observability components, each solving a
          specific need. Start with Bee and add more as you grow.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- Bee -->
        <article class="feature-card">
          <div class="feature-icon">
            <img src="/images/feature-ebpf.svg" alt="eBPF Architecture" class="w-full h-full" />
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Bee</h3>
          <p class="text-sm text-gray-600 mb-4 flex-1">
            Zero-code Linux observability agent with eBPF and native Node.js
            profiling. Captures HTTP/1.1, TLS, HTTP/2/gRPC, Redis, MySQL.
          </p>
          <div class="flex gap-3 pt-4 border-t border-border">
            <a
              href={`${basePath}/bee`}
              class="text-sm font-medium text-primary hover:underline flex-1 text-center"
              >Learn more</a
            >
            <a
              href={`${basePath}/download`}
              class="text-sm font-medium text-primary hover:underline flex-1 text-center"
              >Download</a
            >
          </div>
        </article>

        <!-- Future Component -->
        <article class="feature-card opacity-50">
          <div class="feature-icon bg-gray-100 text-gray-400">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h7.67M12 15V5m0 0L8 9m4-4l4 4M5 20h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v11a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Coming Soon</h3>
          <p class="text-sm text-gray-600 mb-4 flex-1">
            Additional components are in development to complete the observability stack.
          </p>
          <div class="flex gap-3 pt-4 border-t border-border">
            <span class="text-sm font-medium text-gray-400 flex-1 text-center">Coming soon</span>
          </div>
        </article>

        <!-- Future Component -->
        <article class="feature-card opacity-50">
          <div class="feature-icon bg-gray-100 text-gray-400">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0a9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Coming Soon</h3>
          <p class="text-sm text-gray-600 mb-4 flex-1">
            More observability tools are in the pipeline for the complete stack.
          </p>
          <div class="flex gap-3 pt-4 border-t border-border">
            <span class="text-sm font-medium text-gray-400 flex-1 text-center">Coming soon</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Key Capabilities -->
  <section class="section bg-gray-50">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 mb-4">
          Key Capabilities
        </h2>
        <p class="text-lg text-gray-600">
          Built for production observability with zero application changes and bounded resources.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <article class="feature-card">
          <div class="feature-icon">
            <img src="/images/feature-ebpf.svg" alt="eBPF Architecture" class="w-full h-full" />
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Zero-Code</h3>
          <p class="text-sm text-gray-600">
            No application packages, flags, source changes, or restarts required.
            Deploy as a sidecar or host agent.
          </p>
        </article>

        <article class="feature-card">
          <div class="feature-icon">
            <img src="/images/feature-bounded.svg" alt="Bounded Resources" class="w-full h-full" />
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Bounded Resources</h3>
          <p class="text-sm text-gray-600">
            Every queue, eBPF map, parser buffer, and batch has an explicit ceiling.
            Predictable memory and CPU usage.
          </p>
        </article>

        <article class="feature-card">
          <div class="feature-icon">
            <img src="/images/feature-ebpf.svg" alt="eBPF Architecture" class="w-full h-full" />
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">eBPF Powered</h3>
          <p class="text-sm text-gray-600">
            Kernel-level observability with cgroup-skb programs.
            No packet sockets, no CAP_NET_RAW needed.
          </p>
        </article>

        <article class="feature-card">
          <div class="feature-icon">
            <img src="/images/feature-v8.svg" alt="V8 Profiling" class="w-full h-full" />
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Native Profiling</h3>
          <p class="text-sm text-gray-600">
            99Hz Node.js profiling with V8 symbolization via perf_event_open.
            Hot/slow function spans with caller chains.
          </p>
        </article>

        <article class="feature-card">
          <div class="feature-icon">
            <img src="/images/feature-protocols.svg" alt="Protocol Support" class="w-full h-full" />
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Multi-Protocol</h3>
          <p class="text-sm text-gray-600">
            HTTP/1.1, HTTP/2/gRPC, TLS 1.2/1.3, Redis RESP2/3, MySQL COM_QUERY.
            Full protocol semantics preserved.
          </p>
        </article>

        <article class="feature-card">
          <div class="feature-icon">
            <img src="/images/feature-otlp.svg" alt="OTLP Export" class="w-full h-full" />
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">OTLP Export</h3>
          <p class="text-sm text-gray-600">
            Native OTLP/HTTP protobuf export to Vector, Prometheus, and OTLP collectors.
            Single persistent connection.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Architecture Deep Dive -->
  <section class="section">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 mb-4">
          Architecture Overview
        </h2>
        <p class="text-lg text-gray-600">
          Bee's discover → capture → correlate → export pipeline runs entirely on Compio's io_uring runtime.
        </p>
      </div>

      <div class="overflow-x-auto">
        <pre class="code-block"><code>host /proc ──> immutable discovery snapshot ───────────────┐
     │                                                    │
     └─ Node PID ─> perf/V8 samples + OpenSSL uprobes     │
                                     │                         │
cgroup ingress/egress            │                         │
         │                         │                         │
         v                         v                         │
  Aya eBPF: TCP port gate ─> payload + TLS plaintext rings  │
         └─ per-CPU flow aggregation                        │
                                     │                         │
                                     v                         v
               HTTP/1 + HTTP/2/gRPC + TLS + Redis + MySQL parsing
                                     │
                        peer/request/profile correlation
                                     │
                          bounded Compio channel
                                     │
                 /metrics + /graph ├─ Cyper OTLP/HTTP(S) protobuf
                                     v
                           node-local Vector</code></pre>
      </div>

      <div class="mt-8 grid sm:grid-cols-3 gap-6 text-center">
        <div class="p-4">
          <p class="text-3xl font-bold text-primary">99 Hz</p>
          <p class="text-sm text-gray-500">Profiling Frequency</p>
        </div>
        <div class="p-4">
          <p class="text-3xl font-bold text-primary">Zero</p>
          <p class="text-sm text-gray-500">App Changes Required</p>
        </div>
        <div class="p-4">
          <p class="text-3xl font-bold text-primary">Bounded</p>
          <p class="text-sm text-gray-500">All Resources</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-gray-900">
    <div class="container">
      <div class="mx-auto max-w-4xl text-center">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mb-4">
          Ready to get started?
        </h2>
        <p class="mt-4 text-lg text-gray-300 mb-10">
          Download Bee, request a demo, or browse our licensing options.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={`${basePath}/download`}
            class="btn-primary"
            >Download Bee</a
          >
          <a
            href={`${basePath}/demo`}
            class="btn-secondary border-gray-600 text-gray-300 hover:bg-gray-800 hover:border-gray-500"
            >Request a Demo</a
          >
          <a
            href={`${basePath}/pricing`}
            class="btn-secondary border-gray-600 text-gray-300 hover:bg-gray-800 hover:border-gray-500"
            >View Pricing</a
          >
        </div>
      </div>
    </div>
  </section>
</Layout>