---
import Layout from '../layouts/Layout.astro';
import IsoDiagram from '../components/IsoDiagram.astro';
import Arrow from '../components/Arrow.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import { url } from '../lib/url';
import { findPlan, formatPrice } from '../data/plans';

const bee = findPlan('bee');
const stackPlan = findPlan('stack');
const cloud = findPlan('cloud');

const pipeline = [
  { step: 'Collect', name: 'Bee · Beyla', text: 'eBPF agents on every node: Bee goes deep on the services that matter, Beyla goes broad on the rest.' },
  { step: 'Ship', name: 'Vector · Kafka', text: 'Vector gathers OTLP, host metrics and logs. Kafka buffers large or bursty fleets when you need it.' },
  { step: 'Store', name: 'GreptimeDB', text: 'Metrics, logs and traces in one database, queried with SQL and PromQL.' },
  { step: 'See', name: 'Grafana', text: 'Dashboards and exploration on the Grafana your team already knows. Eagle is on its way.' },
  { step: 'Act', name: 'Keep · MCP · AI SRE', text: 'Keep runs alerting and incidents; the Grafana MCP server lets agents read what your team reads.' },
];
---

<Layout>
  <section class="hero">
    <div class="wrap hero-grid home-hero">
      <div class="stack" style="gap: 28px">
        <div class="eyebrow rise">Self-hosted observability stack</div>
        <h1 class="display rise">One observability stack for applications, infrastructure and IoT.</h1>
        <p class="lead rise-2">Obstack collects traces, metrics and logs without code changes, keeps them on servers you own, and shows them in Grafana. No per-gigabyte meters. No phone-home.</p>
        <div class="btn-row rise-2" style="padding-top: 8px">
          <a class="btn btn-primary" href={url('/bee')}>Meet Bee, the application agent <Arrow /></a>
          <a class="btn btn-ghost" href={url('/stack')}>See the full stack</a>
        </div>
      </div>
      <div class="rise-3 hero-art"><IsoDiagram /></div>
    </div>
  </section>

  <!-- Products -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">01 / What we sell</div>
          <h2 class="h2">Start with one agent, or take the whole stack.</h2>
        </div>
        <p class="body-2">Every product speaks OpenTelemetry, so each one works with what you already run, and the next one slots in without a migration.</p>
      </div>

      <div class="products">
        <article class="product lead-product">
          <div class="p-head"><span class="p-name">Bee</span><span class="badge badge-mint">Available</span></div>
          <p class="p-line">Distributed tracing and profiling, on its own.</p>
          <p class="body-2">Bee traces and profiles inside a microservice and between processes on the same host, then continues the same trace across hosts. HTTP, gRPC, TLS, MySQL, Redis and named Node.js awaits, no SDK. Exports OTLP to any OpenTelemetry collector.</p>
          <div class="p-foot">
            <span class="mono p-price">{formatPrice(bee.price, 'usd')} / node / month</span>
            <div class="btn-row">
              <a class="btn btn-dark" href={url('/buy?plan=bee')}>Buy Bee</a>
              <a class="text-link" href={url('/bee')}>How Bee works <Arrow size={16} /></a>
            </div>
          </div>
        </article>

        <article class="product lead-product">
          <div class="p-head"><span class="p-name">Obstack Stack</span><span class="badge badge-mint">Available</span></div>
          <p class="p-line">The complete stack, built around Bee.</p>
          <p class="body-2">Bee and Beyla for collection, Vector and Kafka for transport, GreptimeDB for storage, Grafana for dashboards, Keep for alerts and incidents, and the Grafana MCP server for agents. Self-hosted, or run by us in the region you choose. We configure it end to end; custom dashboards, alerts and migration are quoted and billed on time and materials. One support contract.</p>
          <div class="p-foot">
            <span class="mono p-price">{formatPrice(stackPlan.price, 'usd')} self-hosted · {formatPrice(cloud.price, 'usd')} cloud, / node / month</span>
            <div class="btn-row">
              <a class="btn btn-dark" href={url('/buy?plan=stack')}>Buy the stack</a>
              <a class="text-link" href={url('/stack')}>What's inside <Arrow size={16} /></a>
            </div>
          </div>
        </article>

        <article class="product" id="ai-sre">
          <div class="p-head"><span class="p-name">AI SRE agent</span><span class="badge badge-dashed">Early access</span></div>
          <p class="body-2">An agent that works incidents alongside your on-call. It reads the same traces, metrics, logs and alerts your team does, through the stack's own interfaces, on your infrastructure.</p>
          <ObfuscatedEmail class="text-link" subject="AI SRE agent early access" label="Request early access">
            Request early access <Arrow size={16} />
          </ObfuscatedEmail>
        </article>

        <article class="product" id="eagle">
          <div class="p-head"><span class="p-name">Eagle</span><span class="badge badge-line">Coming soon</span></div>
          <p class="body-2">Our own observability console: an alternative to Grafana, designed around the Obstack data model from the first screen.</p>
          <ObfuscatedEmail class="text-link" subject="Eagle updates" label="Hear when it ships">
            Hear when it ships <Arrow size={16} />
          </ObfuscatedEmail>
        </article>
      </div>
    </div>
  </section>

  <!-- Three layers -->
  <section class="section-tight">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">02 / What it observes</div>
          <h2 class="h2">Three layers, one pipeline, one place to ask questions.</h2>
        </div>
        <p class="body-2">Every signal lands in the same store with the same labels, so a slow request, the host it ran on and the device that sent it can be read side by side.</p>
      </div>
      <div class="grid-3 rule-top layers">
        <article>
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0A1F2E" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M4 7h16M4 12h10M4 17h13"></path><circle cx="19" cy="12" r="1.6" fill="#2ED0C3" stroke="none"></circle></svg>
          <h3 class="h3">Applications</h3>
          <p class="body-2">Bee traces and profiles inside a microservice and on the host. Requests, database calls and hops between services become one distributed trace, with no SDK and no coordinator.</p>
        </article>
        <article>
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0A1F2E" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><rect x="4" y="4" width="16" height="6"></rect><rect x="4" y="14" width="16" height="6"></rect><path d="M8 7h.01M8 17h.01" stroke="#2ED0C3" stroke-width="2.4"></path></svg>
          <h3 class="h3">Infrastructure</h3>
          <p class="body-2">Hosts, containers and Kubernetes nodes report CPU, memory, disk and logs through Vector, while Bee maps which services talk to which.</p>
        </article>
        <article>
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0A1F2E" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><rect x="9" y="9" width="6" height="6"></rect><path d="M5.5 5.5a9 9 0 0 1 13 0M18.5 18.5a9 9 0 0 1-13 0" stroke="#2ED0C3"></path></svg>
          <h3 class="h3">IoT &amp; edge</h3>
          <p class="body-2">Gateways and devices send OTLP into the same pipeline, with Kafka absorbing the bursts. Tell us about your fleet: <ObfuscatedEmail subject="IoT" />.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="section-tight">
    <div class="wrap">
      <div class="panel pipeline">
        <div class="stack" style="gap: 16px; max-width: 760px">
          <div class="eyebrow">03 / How the stack fits together</div>
          <h2 class="h2">From the kernel to the incident, every hop runs on your hardware.</h2>
        </div>
        <div class="grid-5 steps">
          {pipeline.map((s, i) => (
            <div class="step">
              <div class="step-head"><span class="mono">{s.step}</span><span class:list={['rule', { last: i === pipeline.length - 1 }]}></span></div>
              <div class="step-name">{s.name}</div>
              <p class="small">{s.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="section-tight">
    <div class="wrap">
      <div class="eyebrow" style="margin-bottom: 48px">04 / Why teams choose it</div>
      <div class="grid-3 principles">
        <div class="stack">
          <h3 class="h3">Your data stays on your servers</h3>
          <p class="body-2">Telemetry goes to collectors and databases you run. Bee is licensed under PolyForm Internal Use: you get the source and every update for as long as you subscribe. Air-gapped sites are a first-class deployment.</p>
        </div>
        <div class="stack">
          <h3 class="h3">Open formats in and out</h3>
          <p class="body-2">OTLP and Prometheus on the way in, SQL, PromQL and Grafana on the way out. If you ever leave, your data is already in formats every tool reads.</p>
        </div>
        <div class="stack">
          <h3 class="h3">Costs that behave like infrastructure</h3>
          <p class="body-2">A flat price per node. When an incident triples your traffic, your observability bill stays exactly where it was.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="dark">
    <div class="wrap cta-band">
      <div class="stack" style="gap: 18px">
        <h2 class="h2">Start with Bee on one node.</h2>
        <p class="body-2" style="font-size: 18px; max-width: 620px">Install the package next to your busiest Node.js service and watch request-level traces arrive in your existing Grafana within the hour.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" href={url('/buy?plan=bee')}>Buy Bee</a>
        <ObfuscatedEmail class="btn btn-ghost" label="Request an evaluation license" subject="Bee evaluation license" />
      </div>
    </div>
  </section>
</Layout>

<style>
  .home-hero { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 32px; }
  .hero-art { margin-right: calc(var(--gutter) * -0.5); overflow: hidden; max-width: 100%; }

  .products { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .product { background: var(--white); border: 1px solid var(--line); padding: 36px; display: flex; flex-direction: column; gap: 16px; }
  .lead-product { border-top: 4px solid var(--ink); }
  .p-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .p-name { font-size: 28px; font-weight: 800; letter-spacing: -0.01em; }
  .p-line { font-size: 18px; font-weight: 700; color: var(--text); }
  .p-foot { margin-top: auto; padding-top: 20px; border-top: 1px solid var(--line-soft); display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .p-price { font-size: 13px; color: var(--text-2); }
  .product .btn-row { gap: 20px; }

  .layers article { display: flex; flex-direction: column; gap: 16px; padding: 36px 36px 8px 0; }
  .layers article + article { padding-left: 36px; border-left: 1px solid var(--line); }

  .pipeline { padding: 56px; display: flex; flex-direction: column; gap: 44px; }
  .step { display: flex; flex-direction: column; gap: 12px; padding-right: 24px; }
  .step-head { display: flex; align-items: center; gap: 10px; }
  .step-head .mono { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 700; color: var(--ink); }
  .rule { flex-grow: 1; height: 2px; background: var(--teal); }
  .rule.last { background: var(--ink); }
  .step-name { font-size: 20px; font-weight: 800; }
  .flow { font-size: 13px; color: var(--text-2); background: var(--paper); padding: 16px 20px; border: 1px solid var(--line-soft); overflow-x: auto; white-space: nowrap; }

  .principles { gap: 56px; }
  .principles .stack { gap: 14px; padding-top: 20px; border-top: 2px solid var(--ink); }

  @media (max-width: 1100px) {
    .home-hero { grid-template-columns: minmax(0, 1fr); }
    .hero-art { margin-right: 0; }
    .products { grid-template-columns: minmax(0, 1fr); }
    .principles { gap: 32px; }
  }
  @media (max-width: 800px) {
    .product, .pipeline { padding: 24px; }
    .p-name { font-size: 24px; }
    .layers article, .layers article + article { padding: 24px 0 0; border-left: none; }
    .layers { border-top: none; }
    .layers article { border-top: 2px solid var(--ink); }
    .flow { white-space: normal; }
  }
</style>
