---
import Layout from '../layouts/Layout.astro';
import IsoDiagram from '../components/IsoDiagram.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import Arrow from '../components/Arrow.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import { url } from '../lib/url';
import { CHAPTERS, JOURNEY, runTime } from '../data/videos';
import { AURORA, DEMO, PAGEROOT, entryPlan, featuredPlan, planNames, plansBuying, plansWith, priceRange } from '../data/plans';
import Price from '../components/Price.astro';

const cloud = priceRange('cloud');
const pro = featuredPlan();
const pagerootIn = planNames(plansWith('pageroot'));
const [pagerootAddon] = plansBuying('pageroot');
const [auroraIn] = plansWith('aurora');
// The dearest plan that still buys Aurora as an add-on: the natural upsell.
const [auroraAddTo] = plansBuying('aurora').slice(-1);

const pipeline = [
  { step: 'Collect', name: 'Bee · Beyla', text: 'eBPF agents on every node: Bee goes deep on the services that matter, Beyla goes broad on the rest.' },
  { step: 'Ship', name: 'Vector', text: 'Vector gathers OTLP, host metrics and logs on every node, and routes every signal onward.' },
  { step: 'Store', name: 'GreptimeDB', text: 'Metrics, logs and traces in one database, queried with SQL and PromQL.' },
  { step: 'See', name: 'Grafana · MCP', text: 'Dashboards and exploration on the Grafana your team already knows, plus the Grafana MCP server for agents. Eagle is on its way.' },
  { step: 'Act', name: 'Alertmanager · PageRoot', text: 'Prometheus Alertmanager groups and routes firing alerts. PageRoot is an optional on-call module: schedules, escalations, ChatOps and a built-in MCP server.' },
];
---

<Layout>
  <section class="hero">
    <div class="wrap hero-grid home-hero">
      <div class="stack" style="gap: 28px">
        <div class="eyebrow rise">Self-hosted observability stack</div>
        <h1 class="display rise">One observability stack for applications, infrastructure and IoT.</h1>
        <p class="lead rise-2">Obstack collects traces, metrics and logs without code changes, keeps them on servers you own, and shows them in Grafana. One flat price a month, whatever the size of your fleet. No per-node licence, no per-gigabyte meter, no phone-home.</p>
        <div class="btn-row rise-2" style="padding-top: 8px">
          <a class="btn btn-primary" href={url('/pricing')}>See the plans · from <Price eur={cloud.from} /> / month <Arrow /></a>
          <a class="btn btn-ghost" href={url('/stack')}>See the full stack</a>
        </div>
      </div>
      <div class="rise-3 hero-art"><IsoDiagram /></div>
    </div>
  </section>

  <!-- Demo -->
  <section class="section" aria-labelledby="demo-title">
    <div class="wrap demo-grid">
      <div class="stack demo-copy">
        <div class="eyebrow">01 / See it running</div>
        <h2 class="h2" id="demo-title">From a signal to an answer, in one recording.</h2>
        <p class="body-2">A live Obstack environment, recorded end to end: a Python application emits real telemetry, the signals land in Grafana, a real failure raises the PageRoot alarm, and Aurora pulls the evidence back through MCP. The whole incident lifecycle in two minutes.</p>

        <ol class="demo-steps">
          {CHAPTERS.map((chapter, i) => (
            <li>
              <span class="mono n">{String(i + 1).padStart(2, '0')}</span>
              <span class="t">{chapter.title}</span>
              <span class="mono d">{runTime(chapter.seconds)}</span>
            </li>
          ))}
        </ol>

        <div class="btn-row">
          <a class="btn btn-dark" href={url('/demo')}>Watch the three steps <Arrow /></a>
        </div>
      </div>

      <div class="demo-video"><VideoPlayer clip={JOURNEY} chrome={false} /></div>
    </div>
  </section>

  <!-- Products -->
  <section class="section-tight">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">02 / What we sell</div>
          <h2 class="h2">Start with one agent, or take the whole stack.</h2>
        </div>
        <p class="body-2">Every product speaks OpenTelemetry, so each one works with what you already run, and the next one slots in without a migration.</p>
      </div>

      <div class="products">
        <article class="product lead-product">
          <div class="p-head"><span class="p-name">Bee</span><span class="badge badge-mint">Available</span></div>
          <p class="p-line">Distributed tracing and profiling, on its own.</p>
          <p class="body-2">Bee traces and profiles inside a microservice and between processes on the same host, then continues the same trace across hosts. HTTP, gRPC, TLS, MySQL, Redis and named Node.js awaits, no SDK. Exports OTLP to any OpenTelemetry collector.</p>
          <div class="p-foot">
            <span class="mono p-price">In every plan, on every node you run</span>
            <div class="btn-row">
              <a class="text-link" href={url('/bee')}>How Bee works <Arrow size={16} /></a>
            </div>
          </div>
        </article>

        <article class="product lead-product">
          <div class="p-head"><span class="p-name">Obstack Stack</span><span class="badge badge-mint">Available</span></div>
          <p class="p-line">The complete stack, built around Bee.</p>
          <p class="body-2">Bee and Beyla for collection, Vector for transport, GreptimeDB for storage, Grafana for dashboards, Prometheus Alertmanager for alert routing, and the Grafana MCP server for agents. PageRoot, the on-call module, comes with {pagerootIn}. Self-hosted, or run by us in the region you choose, at the same flat price. We configure it end to end; custom dashboards, alerts and migration are quoted and billed on time and materials. One support contract.</p>
          <div class="p-foot">
            <span class="mono p-price"><Price eur={cloud.from} /> to <Price eur={cloud.to} /> / month · unlimited nodes</span>
            <div class="btn-row">
              <a class="btn btn-dark" href={url('/pricing')}>See the plans</a>
              <a class="text-link" href={url('/stack')}>What's inside <Arrow size={16} /></a>
            </div>
          </div>
        </article>

      </div>

      <div class="products products-rest">
        <article class="product" id="pageroot">
          <div class="p-head"><span class="p-name">PageRoot</span><span class="badge badge-mint">In {pagerootIn}</span></div>
          <p class="body-2">On-call, escalations, ChatOps and a built-in MCP server, with unlimited on-call users. Included in {pagerootIn}, or <Price eur={PAGEROOT.price} /> a month on {pagerootAddon.name}. PagerDuty, Rootly and incident.io all bill again for the next person on the rota.</p>
          <div class="p-foot">
            <span class="mono p-price">Included, or <Price eur={PAGEROOT.price} /> / month · no seats</span>
            <div class="btn-row">
              <a class="btn btn-dark" href={url(`/buy?plan=${pro.id}`)}>Buy {pro.name}</a>
              <a class="text-link" href={url('/pageroot')}>How it compares <Arrow size={16} /></a>
            </div>
          </div>
        </article>

        <article class="product" id="grafana">
          <div class="p-head"><span class="p-name">Grafana</span><span class="badge badge-mint">In the stack</span></div>
          <p class="body-2">Dashboards, Explore and alerting in Grafana, with the Grafana MCP server so agents query the same datasources your team does. In every plan, with unlimited users, not sold on its own.</p>
          <a class="text-link" href={url('/grafana')}>How Grafana works here <Arrow size={16} /></a>
        </article>

        <article class="product" id="ai-sre">
          <div class="p-head"><span class="p-name">Aurora AI</span><span class="badge badge-mint">Optional module</span></div>
          <p class="body-2">An AI SRE that works incidents alongside your on-call through Grafana MCP and PageRoot MCP, bundled with unlimited {AURORA.model}. {auroraIn.name} runs it on a private, single-tenant model deployment.</p>
          <div class="p-foot">
            <span class="mono p-price"><Price eur={AURORA.price} /> / month, or included in {auroraIn.name}</span>
            <div class="btn-row">
              <a class="btn btn-dark" href={url(`/buy?plan=${auroraAddTo.id}&aurora=1`)}>Buy Aurora</a>
              <a class="text-link" href={url('/aurora')}>How it works <Arrow size={16} /></a>
            </div>
          </div>
        </article>

        <article class="product" id="eagle">
          <div class="p-head"><span class="p-name">Eagle</span><span class="badge badge-line">Coming soon</span></div>
          <p class="body-2">Our own observability console: an alternative to Grafana, designed around the Obstack data model from the first screen.</p>
          <ObfuscatedEmail class="text-link" subject="Eagle updates" label="Hear when it ships">
            Hear when it ships <Arrow size={16} />
          </ObfuscatedEmail>
        </article>
      </div>
    </div>
  </section>

  <!-- Three layers -->
  <section class="section-tight">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">03 / What it observes</div>
          <h2 class="h2">Three layers, one pipeline, one place to ask questions.</h2>
        </div>
        <p class="body-2">Every signal lands in the same store with the same labels, so a slow request, the host it ran on and the device that sent it can be read side by side.</p>
      </div>
      <div class="grid-3 rule-top layers">
        <article>
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0A1F2E" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M4 7h16M4 12h10M4 17h13"></path><circle cx="19" cy="12" r="1.6" fill="#2ED0C3" stroke="none"></circle></svg>
          <h3 class="h3">Applications</h3>
          <p class="body-2">Bee traces and profiles inside a microservice and on the host. Requests, database calls and hops between services become one distributed trace, with no SDK and no coordinator.</p>
        </article>
        <article>
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0A1F2E" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><rect x="4" y="4" width="16" height="6"></rect><rect x="4" y="14" width="16" height="6"></rect><path d="M8 7h.01M8 17h.01" stroke="#2ED0C3" stroke-width="2.4"></path></svg>
          <h3 class="h3">Infrastructure</h3>
          <p class="body-2">Hosts, containers and Kubernetes nodes report CPU, memory, disk and logs through Vector, while Bee maps which services talk to which.</p>
        </article>
        <article>
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0A1F2E" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><rect x="9" y="9" width="6" height="6"></rect><path d="M5.5 5.5a9 9 0 0 1 13 0M18.5 18.5a9 9 0 0 1-13 0" stroke="#2ED0C3"></path></svg>
          <h3 class="h3">IoT &amp; edge</h3>
          <p class="body-2">Gateways and devices send OTLP into the same pipeline. Tell us about your fleet: <ObfuscatedEmail subject="IoT" />.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="section-tight">
    <div class="wrap">
      <div class="panel pipeline">
        <div class="stack" style="gap: 16px; max-width: 760px">
          <div class="eyebrow">04 / How the stack fits together</div>
          <h2 class="h2">From the kernel to the incident, every hop runs on your hardware.</h2>
        </div>
        <div class="grid-5 steps">
          {pipeline.map((s, i) => (
            <div class="step">
              <div class="step-head"><span class="mono">{s.step}</span><span class:list={['rule', { last: i === pipeline.length - 1 }]}></span></div>
              <div class="step-name">{s.name}</div>
              <p class="small">{s.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="section-tight">
    <div class="wrap">
      <div class="eyebrow" style="margin-bottom: 48px">05 / Why teams choose it</div>
      <div class="grid-3 principles">
        <div class="stack">
          <h3 class="h3">Your data stays on your servers</h3>
          <p class="body-2">Telemetry goes to collectors and databases you run. Bee ships under a license key for the first month; after you sign the PolyForm Internal Use agreement, you get the source over git for as long as you subscribe. Air-gapped delivery is quoted as Enterprise, not on the list plans.</p>
        </div>
        <div class="stack">
          <h3 class="h3">Open formats in and out</h3>
          <p class="body-2">OTLP and Prometheus on the way in, SQL, PromQL and Grafana on the way out. If you ever leave, your data is already in formats every tool reads.</p>
        </div>
        <div class="stack">
          <h3 class="h3">A price that ignores your fleet</h3>
          <p class="body-2">Everyone else licenses observability per node, so the invoice grows every time you add a machine. Obstack charges a flat monthly fee for the plan: twenty nodes and two thousand cost the same, and an incident that triples your traffic changes nothing.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="dark">
    <div class="wrap cta-band">
      <div class="stack" style="gap: 18px">
        <h2 class="h2">Try it on your own cluster for {DEMO.days} days.</h2>
        <p class="body-2" style="font-size: 18px; max-width: 620px">Not a sandbox with sample data. Give us VPN access to your nodes and a Kubernetes cluster of your choice, we deploy the full stack on it, and you judge it on your own telemetry. No card, and nothing converts automatically.</p>
      </div>
      <div class="btn-row">
        <ObfuscatedEmail class="btn btn-primary" label={`Request the ${DEMO.days}-day evaluation`} subject={`${DEMO.days}-day evaluation`} />
        <a class="btn btn-ghost" href={url('/pricing')}>See the plans</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .home-hero { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 32px; }
  .hero-art { margin-right: calc(var(--gutter) * -0.5); overflow: hidden; max-width: 100%; }

  /* The recording carries its own frame: the copy beside it does the labelling. */
  .demo-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 56px; align-items: center; }
  .demo-copy { gap: 20px; }
  .demo-copy .body-2 { max-width: 520px; }
  .demo-steps { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-direction: column; }
  .demo-steps li { display: flex; align-items: baseline; gap: 14px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .demo-steps li:first-child { border-top: 2px solid var(--ink); }
  .demo-steps .n { font-size: 12px; letter-spacing: 0.14em; font-weight: 700; color: var(--link); }
  .demo-steps .t { font-size: 16px; font-weight: 700; }
  .demo-steps .d { margin-left: auto; font-size: 12px; color: var(--muted); }
  .demo-video { min-width: 0; }

  .products { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .products-rest { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 24px; }
  .product { background: var(--white); border: 1px solid var(--line); padding: 36px; display: flex; flex-direction: column; gap: 16px; }
  .lead-product { border-top: 4px solid var(--ink); }
  .p-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .p-name { font-size: 28px; font-weight: 800; letter-spacing: -0.01em; }
  .p-line { font-size: 18px; font-weight: 700; color: var(--text); }
  .p-foot { margin-top: auto; padding-top: 20px; border-top: 1px solid var(--line-soft); display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .p-price { font-size: 13px; color: var(--text-2); }
  .product .btn-row { gap: 20px; margin-left: auto; justify-content: flex-end; }

  .layers article { display: flex; flex-direction: column; gap: 16px; padding: 36px 36px 8px 0; }
  .layers article + article { padding-left: 36px; border-left: 1px solid var(--line); }

  .pipeline { padding: 56px; display: flex; flex-direction: column; gap: 44px; }
  .step { display: flex; flex-direction: column; gap: 12px; padding-right: 24px; }
  .step-head { display: flex; align-items: center; gap: 10px; }
  .step-head .mono { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 700; color: var(--ink); }
  .rule { flex-grow: 1; height: 2px; background: var(--teal); }
  .rule.last { background: var(--ink); }
  .step-name { font-size: 20px; font-weight: 800; }
  .flow { font-size: 13px; color: var(--text-2); background: var(--paper); padding: 16px 20px; border: 1px solid var(--line-soft); overflow-x: auto; white-space: nowrap; }

  .principles { gap: 56px; }
  .principles .stack { gap: 14px; padding-top: 20px; border-top: 2px solid var(--ink); }

  @media (max-width: 1100px) {
    .home-hero { grid-template-columns: minmax(0, 1fr); }
    .hero-art { margin-right: 0; }
    .demo-grid { grid-template-columns: minmax(0, 1fr); gap: 36px; }
    .demo-copy .body-2 { max-width: none; }
    .products, .products-rest { grid-template-columns: minmax(0, 1fr); }
    .principles { gap: 32px; }
  }
  @media (max-width: 800px) {
    .product, .pipeline { padding: 24px; }
    .pipeline { gap: 32px; }
    .step { padding-right: 0; }
    .p-name { font-size: 24px; }
    .layers article, .layers article + article { padding: 24px 0 0; border-left: none; }
    .layers { border-top: none; }
    .layers article { border-top: 2px solid var(--ink); }
    .flow { white-space: normal; }
  }
</style>
