---
import Layout from '../layouts/Layout.astro';
import PricingTable from '../components/PricingTable.astro';
import PriceTable from '../components/PriceTable.astro';
import Configurator from '../components/Configurator';
import Arrow from '../components/Arrow.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import {
  BUSINESS_HOURS,
  COMMERCIAL,
  DEMO,
  FLEETS,
  PER_NODE_VENDORS,
  PLANS,
  RATE_LIMIT,
  STORAGE,
  SUPPORT,
  TERM_DISCOUNT,
  dedicatedPlans,
  dualPrice,
  formatPrice,
  formatTb,
  formatUsd,
  infraLine,
  infraPhrase,
  infraShape,
  infraShapePhrase,
  machinePhrase,
  pct,
  planForFleet,
  planNames,
  spell,
  planPrice,
  priceRange,
  sharedPlans,
  vendorMonthly,
} from '../data/plans';
import { AI_BILLING, EAGLESRE, PRODUCT_PRICING } from '../data/product-pricing';
import MaxDemoDownload from '../components/MaxDemoDownload.astro';
import Price from '../components/Price.astro';
import { url } from '../lib/url';
import { breadcrumbSchema, faqSchema, plainText } from '../lib/seo';

// Every plan reference below is derived from the catalogue, so adding or
// repricing a tier never leaves a stale figure in the copy.
const [starter] = sharedPlans();
const tiers = dedicatedPlans();
const [go, pro, max] = tiers;
const cloudRange = priceRange('cloud');
const onPremRange = priceRange('self-hosted');
/** Who carries, who can buy and who cannot have each optional module. */

/**
 * The whole argument in one table. Each column picks the plan that fits a fleet
 * that size, so the Obstack row steps a handful of times across two orders of
 * magnitude while the selected host-priced examples multiply.
 */
const fleetHead = [
  '',
  ...FLEETS.map((f) => `${f.nodes.toLocaleString('en-US')} nodes${f.note ? `, ${f.note}` : ''}`),
];
const fleetRows = [
  ['Obstack', ...FLEETS.map((f) => {
    const plan = planForFleet(f);
    return `<span class="pt-plan">${plan.name}</span>${dualPrice(plan.price)} / month`;
  })],
  ...PER_NODE_VENDORS.map((v) => [v.name, ...FLEETS.map((f) => `${formatUsd(vendorMonthly(v, f.nodes))} / month`)]),
];
const fleetSpan = `${dualPrice(planForFleet(FLEETS[0]).price)} to ${dualPrice(planForFleet(FLEETS[FLEETS.length - 1]).price)}`;

const vendorHead = ['', 'Pricing model', 'What grows the bill', 'Stored data', 'Users', 'During an incident'];
const vendors = [
  ['Obstack', `Flat per month, ${PLANS.length} tiers`, 'The selected backend tier and storage blocks', `${formatTb(STORAGE.includedTb)} on dedicated plans, ${dualPrice(STORAGE.pricePerBlock)} per extra ${STORAGE.blockTb} TB`, 'Unlimited, included', 'Model and notification providers bill separately'],
  ['Datadog', '$15 infrastructure + $31 APM / host / month, annual billing', 'Hosts, logs, indexed spans and other add-ons', 'Retention and ingestion charges vary by product', 'Included', 'Usage charges depend on the selected products'],
  ['Grafana Cloud', '$19 / month platform fee + usage', 'Application host-hours, series, telemetry and retention', 'Billed by signal and retention', 'Plan-dependent', 'Usage and AI investigation charges may apply'],
  ['SigNoz Cloud', '$49 / month minimum, includes $49 of usage', 'Logs/traces $0.30 / GB; metrics $0.10 / million samples', 'Retention-dependent; self-hosting is a separate offering', 'Unlimited, included', 'MCP access included; consumption still applies'],
  ['Better Stack', '$29 / responder / month, annual billing', 'Responders, telemetry and optional features', 'Telemetry bundles priced separately', 'Responders are paid; other teammates free', 'AI SRE chat $5 / million tokens'],
];

const infraHead = ['Plan', 'Backend', 'Sizing', 'Object storage', 'Support', 'On your own hardware'];
const infraRows = [
  [
    starter.name,
    infraShape(starter),
    'Shared with other Starter tenants',
    formatTb(starter.includedTb),
    `${SUPPORT.starter.tier}, email`,
    'Not available',
  ],
  ...tiers.map((p) => [
    p.name,
    infraShape(p),
    infraLine(p),
    formatTb(p.includedTb),
    `${SUPPORT[p.id].tier}, P1 in ${SUPPORT[p.id].p1.toLowerCase()}`,
    `${dualPrice(planPrice(p, 'self-hosted'))} / month`,
  ]),
];

const keyTerms = [
  ['Flat', 'One monthly fee per tier. Nodes, hosts, pods, Grafana users, dashboards, alerts, incidents, on-call users, ingest, egress and queries are never counted.'],
  ['Billing', `Monthly at list, or yearly in advance at ${pct(TERM_DISCOUNT[12])} off. A 3-year term is billed yearly at ${pct(TERM_DISCOUNT[36])} off and locks the price. VAT on invoice, bank transfer within ${COMMERCIAL.paymentDays} days.`],
  ['Changes', 'Move up a tier, switch deployment, or add a module or storage block at any time, prorated to your renewal date. Reduce at renewal.'],
  ['Refund', `${DEMO.days}-day evaluation before you buy, then a full refund within ${COMMERCIAL.refundDays} days of your first order.`],
];

const faqs = [
  ['How is this different from per-node licensing?', `Datadog and Grafana Application Observability charge by hosts or host-hours, so the bill is a function of how much infrastructure you run. Obstack charges a flat monthly fee for the tier. Twenty nodes and two thousand nodes cost the same. What you are buying is a backend of a given size and a support level, not a licence per machine.`],
  ['So there is really no node limit?', 'There is no node count on the invoice and no licence key tied to one. Install the agent on as many Linux hosts, virtual machines and Kubernetes workers as you like. The only real limit is what the backend in your tier can chew through, and if you outgrow it we tell you and agree a move to the next tier. We never add charges automatically.'],
  ['What actually changes between the tiers, then?', `The infrastructure the backend runs on and the support that answers you. ${starter.name} is ${infraShapePhrase(starter)} with best-effort ingest. ${go.name} is ${infraPhrase(go)}, answered by ${SUPPORT[go.id].channel.toLowerCase()} ${SUPPORT[go.id].p1.toLowerCase()}. ${pro.name} is a much larger node with Eagle included and ${SUPPORT[pro.id].tier} support ${SUPPORT[pro.id].hoursPhrase}. ${max.name} is ${infraShapePhrase(max)}, each node ${machinePhrase(max)}, with ${SUPPORT[max.id].tier} support ${SUPPORT[max.id].hoursPhrase} and EagleSRE production entitlement at launch. Model usage is billed by your provider.`],
  [`What are the ${starter.name} rate limits?`, `${RATE_LIMIT.blurb} We do not publish the numbers because they follow the capacity of the shared tier. A collector that honours ${RATE_LIMIT.statuses} and the ${RATE_LIMIT.header} header needs nothing else; the OTLP exporter does this by default.`],
  ['What does running it on our own hardware save?', `The hosting we no longer buy: ${tiers.map((p) => `${dualPrice(p.onPrem)} on ${p.name}`).join(', ')}. That brings the range down to ${dualPrice(onPremRange.from)}–${dualPrice(onPremRange.to)} a month. You provide machines matching the tier's sizing plus an S3-compatible bucket, and install using the Helm chart or ask for deployment assistance over your VPN. Same software, same modules, same support.`],
  ['Can we try it before we pay?', `Yes, for ${DEMO.days} days, free. ${DEMO.blurb} No card or automatic conversion. The trial license expires unless you activate a paid plan; the evaluation itself is free.`],
  ['How much storage do we get?', `${formatTb(STORAGE.includedTb)} of object storage on ${planNames(tiers)}, and ${formatTb(starter.includedTb)} on ${starter.name}. That is compressed data at rest in the EU or US region you pick, with egress and API calls included. More is ${dualPrice(STORAGE.pricePerBlock)} per ${STORAGE.blockTb} TB per month. When it fills, the oldest data expires first, so there is never an overage bill.`],
  ['What is EagleSRE?', `The incident and on-call product alongside Eagle: schedules, escalations, ChatOps and an investigation agent. EagleSRE is in preview; preview access is by request. The proposed production price is ${dualPrice(EAGLESRE.launchPrice)} per month on Go, included in Pro and Max at launch.`],
  ['What is EagleMCP?', 'MCP access for assistants working with the Obstack Stack, included in every plan with no connector or per-tool-call charge. Assistant and model-provider charges are separate.'],
  ['Are AI tokens included?', AI_BILLING],
  ['Do the list tiers cover air-gapped sites?', 'No. The list tiers assume the site can receive updates. Air-gapped delivery, offline updates, sites with no outbound connectivity, multi-region deployments and custom model hosting are quoted as Enterprise.'],
  ['Do you set it up for us?', 'Yes, on every tier. First setup, the release of updates, and the ongoing rollout and monitoring of the infrastructure are included. Custom Grafana dashboards, alert design and migration from your current tools are Professional Services, quoted in advance and invoiced for the time actually spent.'],
  ['Which support tier answers us?', `${tiers.map((p) => `${SUPPORT[p.id].tier} on ${p.name}, ${SUPPORT[p.id].channel.toLowerCase()}, P1 in ${SUPPORT[p.id].p1.toLowerCase()}`).join('. ')}. Business hours are ${BUSINESS_HOURS}.`],
];
---

<Layout
  title="Obstack pricing · flat monthly tiers, not per node"
  description={`Obstack pricing: ${PLANS.length} flat tiers from ${formatPrice(cloudRange.from, 'usd')} to ${formatPrice(cloudRange.to, 'usd')} per month, plus Enterprise. No per-node licensing, no ingest or user meters, ${formatTb(STORAGE.includedTb)} of storage included, and a self-hosted Max demo with a ${DEMO.days}-day license and Helm deployment.`}
  active="pricing"
  schema={[
    faqSchema('/pricing', faqs.map(([q, a]) => [q, plainText(a)] as [string, string])),
    breadcrumbSchema('/pricing', 'Pricing'),
  ]}
>
  <section class="hero">
    <div class="wrap price-hero">
      <div class="stack" style="gap: 22px; max-width: 920px">
        <div class="eyebrow rise">Pricing</div>
        <h1 class="display rise">Flat monthly pricing. Your fleet never touches the bill.</h1>
        <p class="lead rise-2" style="max-width: 720px">Some platforms charge by host, others by telemetry volume or responders. Obstack sells {spell(PLANS.length)} tiers at a fixed price. Unlimited nodes, unlimited ingest, unlimited users — the tier is what you pay.</p>
        <div class="btn-row rise-2" style="padding-top: 8px">
          <a class="btn btn-primary" href="#configure">Configure a quote <Arrow /></a>
          <a class="btn btn-ghost" href="#deployment">Cloud or your own hardware</a>
          <a class="btn btn-ghost" href="#demo">{DEMO.days} days free</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">01 / Plans</div>
          <h2 class="h2">{PLANS.length} tiers, one flat price each.</h2>
        </div>
        <p class="body-2">What separates them is the backend we run for you and the engineers who answer when it breaks — never how much you send. Bee, Eagle, Grafana and EagleMCP are included. EagleSRE is in preview; its production entitlement is included in Pro and Max at launch. Everything outside the list is Enterprise, quoted against your estate.</p>
      </div>
      <PricingTable variant="all" />
    </div>
  </section>

  <section class="section-tight" id="products">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">Product pricing</div>
          <h2 class="h2">One stack subscription. Clear product entitlements.</h2>
        </div>
        <p class="body-2">Bee, Eagle, Grafana and EagleMCP are included in every tier. You pay for the backend and support level, without a second console or connector licence.</p>
      </div>
      <div class="tile-grid grid-2">
        {PRODUCT_PRICING.map((product) => (
          <div>
            <h3 class="h3"><a href={url(product.path)}>{product.name}</a></h3>
            <p><strong>{product.price}</strong></p>
            <p class="body-2">{product.note}</p>
          </div>
        ))}
      </div>
      <div class="panel" style="margin-top: 24px; padding: 28px">
        <h3 class="h3"><a href={url('/eaglesre')}>EagleSRE</a> · Preview</h3>
        <p class="body-2">Preview access is by request, with no production pager commitment. Proposed production pricing: <Price eur={EAGLESRE.launchPrice} /> / month flat on Go, included in Pro and Max at launch. Not offered on Starter. Production billing starts only after general availability and an agreed activation.</p>
        <ObfuscatedEmail class="text-link" subject="EagleSRE preview" label="Request preview access" />
        <p class="small" style="margin-top: 16px">{AI_BILLING}</p>
      </div>
    </div>
  </section>

  <section class="section-tight" id="deployment">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">02 / Deployment</div>
          <h2 class="h2">Two ways to run it. Pick one and the prices above follow.</h2>
        </div>
        <p class="body-2">{planNames(tiers)} are the same product either way — same stack, same modules, same support tier. The only question is who buys the servers. When you already own them, we take the hosting off the price instead of charging you for it twice.</p>
      </div>

      <div class="ways">
        <article class="way">
          <div class="way-top">
            <span class="mono way-kind">Obstack Cloud</span>
            <span class="badge badge-mint">Default</span>
          </div>
          <h3 class="h3">We buy the hardware.</h3>
          <p class="body-2" style="font-size: 15px">You install the agents and nothing else. We provision the nodes your plan describes and the object storage that comes with them, in the EU or US datacenter you pick, and run them.</p>
          <dl class="way-split">
            <div>
              <dt class="mono">You supply</dt>
              <dd>The agents on your fleet, and a decision about the region.</dd>
            </div>
            <div>
              <dt class="mono">We supply</dt>
              <dd>The nodes, the object storage, the network, the backups, the upgrades and the monitoring.</dd>
            </div>
          </dl>
          <div class="way-rows">
            {tiers.map((p) => (
              <div class="way-row">
                <span>{p.name}</span>
                <strong><Price eur={p.price} /> / month</strong>
              </div>
            ))}
            <div class="way-row muted">
              <span>{starter.name}</span>
              <strong><Price eur={starter.price} /> / month</strong>
            </div>
          </div>
        </article>

        <article class="way">
          <div class="way-top">
            <span class="mono way-kind">Your own hardware</span>
            <span class="badge badge-line">Hosting credit</span>
          </div>
          <h3 class="h3">You already own the machines.</h3>
          <p class="body-2" style="font-size: 15px">Install the self-hosted version using our Helm chart, or ask us to deploy it over your VPN. Updates and support follow your plan; telemetry stays on your infrastructure.</p>
          <dl class="way-split">
            <div>
              <dt class="mono">You supply</dt>
              <dd>Kubernetes nodes matching the plan sizing and an S3-compatible bucket. A VPN is needed only for remote deployment assistance.</dd>
            </div>
            <div>
              <dt class="mono">We supply</dt>
              <dd>The Helm chart, paid license, updates and the support tier you select, with deployment assistance available.</dd>
            </div>
          </dl>
          <div class="way-rows">
            {tiers.map((p) => (
              <div class="way-row">
                <span>{p.name}</span>
                <strong><Price eur={planPrice(p, 'self-hosted')} /> / month</strong>
                <em class="mono">−<Price eur={p.onPrem} /></em>
              </div>
            ))}
            <div class="way-row muted">
              <span>{starter.name}</span>
              <strong>Not available</strong>
              <em class="mono">cloud only</em>
            </div>
          </div>
        </article>
      </div>

      <p class="mono note">The credit is roughly what we would have spent hosting that plan — the nodes, the addresses, the backup space and the included object storage — so an on-premise order pays for the software, the deployment work and the support, and nothing else. It is a fixed figure per plan, not a percentage, and it does not change with your fleet. Air-gapped delivery, offline updates and sites with no outbound connectivity are quoted as Enterprise.</p>
    </div>
  </section>

  <section class="section-tight" id="flat">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">03 / Flat versus per node</div>
          <h2 class="h2">Four hundred times the fleet. Nothing like four hundred times the bill.</h2>
        </div>
        <p class="body-2" set:html={`Read one row across. Every other row is a multiplication, so it never stops climbing. Ours steps between a handful of fixed prices — ${fleetSpan} across the whole range — because what grows is the backend we run for you, not a licence you buy per machine. Within any one plan the figure does not move at all.`} />
      </div>
      <PriceTable head={fleetHead} rows={fleetRows} highlight={0} minWidth={880} />
      <p class="mono note">Each Obstack column uses an illustrative plan; actual sizing depends on telemetry volume, query load and retention, not host count alone. The price shown is the plan's flat monthly fee. {starter.name} assumes low telemetry volumes, since its ingest is rate limited and best effort. Obstack figures follow the EUR/USD switch in the header; the other vendors are quoted at US list in USD, annual billing where offered, reviewed 26 October 2026, before logs, indexed spans, retained volume and custom metrics. Enterprise agreements differ from list.</p>
    </div>
  </section>

  <section class="dark">
    <div class="wrap section">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">04 / What you are actually buying</div>
          <h2 class="h2">Infrastructure and support, not a licence per machine.</h2>
        </div>
        <p class="body-2">A tier is a backend of a given size plus a support level. That is the whole model, and it is why the tiers cost what they cost.</p>
      </div>
      <div class="grid-4 why">
        {PLANS.map((p) => (
          <div class="stack">
            <h3 class="h3" style="font-size: 18px">{p.name}</h3>
            <p class="mono why-spec">{infraLine(p)}</p>
            <p class="body-2" style="font-size: 15px">{p.infra.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <PriceTable head={infraHead} rows={infraRows} minWidth={1000} />
      <p class="mono note">On your own hardware you supply machines matching the sizing and an S3-compatible bucket, and install using the Helm chart or ask for deployment assistance over your VPN; the hosting we would have bought comes off the price. {starter.name} is Obstack Cloud only. Air-gapped delivery and multi-region deployments are Enterprise.</p>
    </div>
  </section>

  <section class="section-tight" id="configure">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">05 / Quote</div>
          <h2 class="h2">Pick the tier, the deployment and the modules.</h2>
        </div>
        <p class="body-2">There is no node count to enter, because there is no node count on the invoice. Take the quote to checkout, or send it to sales for a purchase order.</p>
      </div>
      <Configurator client:load />
    </div>
  </section>

  <section class="section-tight" id="demo">
    <div class="wrap">
      <div class="panel demo">
        <div class="stack" style="gap: 18px">
          <div class="eyebrow">06 / Before you buy</div>
          <h2 class="h2">Max on your Kubernetes cluster. A {DEMO.days}-day license.</h2>
          <p class="body-2" style="font-size: 17px; max-width: 640px">Install the Max edition with our Helm chart and a 30-day evaluation license. Use your own telemetry, then convert the installation to a paid self-hosted Go, Pro or Max plan. Retain your data and apply the entitlements and resources of your chosen plan.</p>
        </div>
        <ol class="demo-steps">
          <li><span class="mono">01</span><strong>Get the chart</strong><span>Request the Obstack Helm chart and a {DEMO.days}-day Max evaluation license for your company.</span></li>
          <li><span class="mono">02</span><strong>Install Max</strong><span>Deploy on your own Kubernetes cluster using the supplied values and license. Deployment assistance is available.</span></li>
          <li><span class="mono">03</span><strong>Evaluate</strong><span>Run your own traces, metrics and logs through the stack. EagleSRE preview access is agreed separately.</span></li>
          <li><span class="mono">04</span><strong>Activate your plan</strong><span>Keep your installation and data, then activate self-hosted Go, Pro or Max. No automatic order or charge.</span></li>
        </ol>
        <MaxDemoDownload />
        <div class="btn-row">
          <a class="btn btn-outline" href={url('/download#activate')}>Activate an existing Max demo</a>
          <a class="text-link" href={url('/self-hosted')}>Compare self-hosted versions <Arrow size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight" id="compare">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">07 / Against the market</div>
          <h2 class="h2">What grows your bill, vendor by vendor.</h2>
        </div>
        <p class="body-2">The other platforms price the fleet you run and the traffic you send them, so an incident that triples your telemetry triples part of the invoice. On Obstack there is nothing on that column.</p>
      </div>
      <PriceTable head={vendorHead} rows={vendors} highlight={0} minWidth={1100} />
      <p class="mono note">Obstack figures follow the EUR/USD switch in the header; the other vendors are quoted at US list in USD. Public list prices, annual billing where offered, reviewed 26 October 2026. Stored sizes are not directly comparable: Obstack counts compressed bytes at rest; other vendors price ingestion and retention by signal. Enterprise agreements differ from list.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">08 / Terms in brief</div>
          <h2 class="h2">The commercial terms, in four lines.</h2>
        </div>
        <a class="text-link" href={url('/terms')}>Read the full terms <Arrow size={16} /></a>
      </div>
      <div class="tile-grid grid-4">
        {keyTerms.map(([t, d]) => (
          <div>
            <span class="mono term-k">{t}</span>
            <p class="body-2" style="font-size: 15px">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap grid-2 faq">
      <div class="stack" style="gap: 16px">
        <div class="eyebrow">09 / Questions</div>
        <h2 class="h2">Before you buy.</h2>
        <p class="body-2">Anything else: <ObfuscatedEmail label="email us" class="mono" subject="Pricing question" /></p>
      </div>
      <dl>
        {faqs.map(([q, a]) => (
          <div>
            <dt>{q}</dt>
            <dd set:html={a} />
          </div>
        ))}
      </dl>
    </div>
  </section>
  <section class="section-tight">
    <div class="wrap">
      <p class="small">Market comparison reviewed 26 October 2026 against public US list prices:
        <a class="text-link" href="https://www.datadoghq.com/pricing/list/">Datadog</a>,
        <a class="text-link" href="https://grafana.com/pricing/">Grafana</a>,
        <a class="text-link" href="https://signoz.io/pricing/">SigNoz</a> and
        <a class="text-link" href="https://betterstack.com/pricing">Better Stack</a>.
        Host examples use the stated list rate before allowances, discounts and additional usage; they are not complete, feature-equivalent quotes. Fleet sizes illustrate pricing only and do not guarantee backend capacity.</p>
    </div>
  </section>
</Layout>

<style>
  .price-hero { padding-top: 88px; padding-bottom: 96px; }
  #configure, #compare, #flat, #demo, #deployment { scroll-margin-top: 64px; }

  .ways { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: stretch; }
  .way { background: var(--white); border: 1px solid var(--line); border-top: 4px solid var(--ink); padding: 32px; display: flex; flex-direction: column; gap: 16px; }
  .way-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .way-kind { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--link); font-weight: 700; }
  .way-split { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; padding: 18px 0; border-top: 1px solid var(--line-soft); border-bottom: 1px solid var(--line-soft); }
  .way-split dt { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700; color: var(--ink); margin-bottom: 6px; }
  .way-split dd { margin: 0; font-size: 14px; line-height: 1.55; color: var(--text-2); }
  .way-rows { margin-top: auto; display: flex; flex-direction: column; }
  .way-row { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 12px; align-items: baseline; padding: 11px 0; border-bottom: 1px solid var(--line-soft); font-size: 15px; }
  .way-row:last-child { border-bottom: none; }
  .way-row span { font-weight: 700; }
  .way-row strong { font-weight: 800; letter-spacing: -0.01em; }
  .way-row em { font-style: normal; font-size: 12px; color: var(--link); font-weight: 700; min-width: 68px; text-align: right; }
  .way-row.muted span, .way-row.muted strong { color: var(--text-2); font-weight: 600; }
  .way-row.muted em { color: var(--muted); }
