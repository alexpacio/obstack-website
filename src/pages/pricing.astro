---
import Layout from '../layouts/Layout.astro';
import PricingTable from '../components/PricingTable.astro';
import PriceTable from '../components/PriceTable.astro';
import Configurator from '../components/Configurator';
import Arrow from '../components/Arrow.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import PageRootCompare from '../components/PageRootCompare.astro';
import { PAGEROOT, STORAGE, findPlan, formatPrice } from '../data/plans';
import { url } from '../lib/url';

const bee = findPlan('bee');
const cloud = findPlan('cloud');
const gb = formatPrice(STORAGE.pricePerGb, 'usd');

const vendorHead = ['', 'Pricing model', 'Per host', 'Logs and traces', 'Stored data', 'Users', 'During an incident'];
const vendors = [
  ['Obstack', 'Flat per node, storage by the gigabyte', `${formatPrice(bee.price, 'usd')}–${formatPrice(cloud.price, 'usd')} / node / month`, 'Included, not metered', `${gb} / GB / month, capacity you choose`, 'Unlimited, included', 'Unchanged'],
  ['Datadog', 'Per host, plus per GB and per event', '$46 / host / month for Infrastructure Pro + APM Pro', '$0.10 / GB ingested, plus $1.70 per million log events indexed', 'Priced into indexing; longer retention costs more', 'Included', 'Host, span and log meters rise'],
  ['Dynatrace', 'Per memory GiB-hour, plus per GiB ingested', '≈ $58 / month for an 8 GiB host on Full-Stack', '$0.20 / GiB ingested', 'Retention billed per GiB-day', 'Included', 'Ingest rises; bigger hosts cost more'],
  ['Grafana Cloud', '$19 platform fee plus usage', '$0.025 / host-hour, ≈ $18 / host / month', '$0.45 / GB written', '$0.10 / GB / month, ≈ $100 / TB', 'Varies by plan', 'Series, GB written and retention rise'],
  ['New Relic', 'Per GB ingested, plus per user', 'No host fee', '$0.40 / GB beyond 100 GB free ($0.60 with Data Plus)', 'Default retention included', '$349 / full-platform user / month (Pro, annual)', 'Ingest rises'],
  ['Elastic Serverless', 'Per GB ingested and per GB retained', 'No host fee', '$0.09–0.15 / GB ingested', '≈ $0.02 / GB / month, measured before compression', 'Included', 'Ingest and retention rise'],
];

const whyStorage = [
  ['Priced per gigabyte', `Obstack storage is ${gb} per GB per month of compressed data at rest. Egress and API calls are included.`],
  ['Requests that cost nothing', 'GreptimeDB writes, compacts and reads Parquet files all day. Those requests are included, so that activity never reaches your bill.'],
  ['No minimum storage duration', 'Retention deletes telemetry every day. You only pay for what is stored, not for data already gone.'],
  ['Your datacenter, EU or US', 'Choose EU or US in the configurator. Telemetry and managed storage stay there; EU data stays in the EU.'],
];

const keyTerms = [
  ['Billing', 'Yearly in advance, in USD or EUR. USD is 25% above the euro list. VAT on invoice. Bank transfer within 30 days. Card payments are not accepted.'],
  ['Changes', 'Add nodes, gigabytes or PageRoot seats any time, prorated to your renewal date. Reduce at renewal.'],
  ['Renewal', 'Renews for the same term unless cancelled 30 days before. 1-year renewals rise at most 5%; 3-year terms are locked.'],
  ['Refund', 'Full refund within 30 days of your first order. Cloud outages earn service credits.'],
];

const faqs = [
  ['What counts as a node?', 'One Linux host, VM or Kubernetes worker node running an Obstack agent. Pods and containers are not counted, and autoscaling bursts of up to 20% for a few days a month are covered.'],
  ['Self-hosted or Cloud?', 'Self-hosted runs on your servers. Bee is licensed under PolyForm Internal Use; source and updates come with the subscription. Obstack Cloud is the same stack operated by us: you install the agents, we run and upgrade the rest. Data exports in open formats either way.'],
  ['Do list plans include air-gapped sites?', 'No. Bee, Stack, Cloud and PageRoot on the public price list assume the site can receive updates. Air-gapped delivery, offline updates and sites with no outbound connectivity are quoted as Enterprise.'],
  ['Do you set it up for us?', 'Yes. Obstack Stack on-prem and Obstack Cloud both include first setup, the release of updates, and the ongoing rollout and monitoring of the infrastructure.'],
  ['What about custom work?', 'Custom Grafana dashboards, alert setup and anything else tailored to your environment are Professional Services, quoted in advance. We send a written quote you approve before we start, then invoice the time spent.'],
  ['Is anything metered?', 'No. Ingest, egress and queries are free. Grafana users are unlimited. Storage is a capacity you choose: when it fills, the oldest data expires first and we warn you at 80%. There is never an overage bill. PageRoot is optional and priced per on-call user.'],
  ['What is PageRoot?', `An optional on-call module on Stack and Cloud: schedules, escalations, ChatOps and a built-in MCP server. ${formatPrice(PAGEROOT.selfHosted, 'usd')} per user self-hosted, ${formatPrice(PAGEROOT.cloud, 'usd')} on Obstack Cloud. Alertmanager is already in the stack.`],
  ['How much storage do I need?', 'Nodes × stored GB per node per day × retention days. The configurator does the arithmetic. Start with the retention you need today; you can add gigabytes at any time.'],
  ['Where does our data live?', `In the EU or US datacenter you pick in the configurator. Managed storage is Obstack storage at ${gb} per GB per month. Self-hosted customers can use their own S3-compatible bucket or local disk instead.`],
  ['How is Bee licensed?', 'Under the PolyForm Internal Use License: use and modify it for your own operations; do not distribute it. Pay the subscription and you get the source and every update. Stop paying and updates stop.'],
  ['Can we try it first?', 'Yes. Ask for a 30-day evaluation license, or a 30-day Cloud trial with 1,000 GB of storage.'],
];
---

<Layout
  title="Pricing · Obstack"
  description={`Obstack pricing: self-hosted from ${formatPrice(bee.price, 'usd')} per node per month, Obstack Cloud from ${formatPrice(cloud.price, 'usd')} per node plus storage at ${gb} per GB. No ingest, egress, query or user meters.`}
  active="pricing"
>
  <section class="hero">
    <div class="wrap price-hero">
      <div class="stack" style="gap: 22px; max-width: 880px">
        <div class="eyebrow rise">Pricing</div>
        <h1 class="display rise">Flat per node. Storage by the gigabyte. Nothing metered.</h1>
        <p class="lead rise-2" style="max-width: 680px">Run Obstack on your servers or let us run it in the region you choose. Either way your bill looks the same during an incident as it does on a quiet Sunday.</p>
        <div class="btn-row rise-2" style="padding-top: 8px">
          <a class="btn btn-primary" href="#configure">Configure a quote <Arrow /></a>
          <a class="btn btn-ghost" href="#compare">Compare with Datadog and others</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">01 / Plans</div>
          <h2 class="h2">Three products, plus an optional on-call module.</h2>
        </div>
        <p class="body-2">Per node, per month. Stack on-prem and Cloud include setup, updates, rollout and monitoring. PageRoot is an optional on-call module, priced per user. Custom Grafana dashboards and alerts are Professional Services, quoted in advance.</p>
      </div>
      <PricingTable variant="all" />
    </div>
  </section>

  <section class="section-tight" id="configure">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">02 / Quote</div>
          <h2 class="h2">Pick the deployment, the nodes, the gigabytes and PageRoot if you want it.</h2>
        </div>
        <p class="body-2">Discounts apply as you go. Take the quote to checkout, or send it to sales for a purchase order.</p>
      </div>
      <Configurator client:load />
    </div>
  </section>

  <section class="section-tight" id="compare">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">03 / Against the market</div>
          <h2 class="h2">What grows your bill, vendor by vendor.</h2>
        </div>
        <p class="body-2">The other platforms price the traffic you send them, so an incident that triples your telemetry triples part of the invoice. Obstack prices the fleet.</p>
      </div>
      <PriceTable head={vendorHead} rows={vendors} highlight={0} minWidth={1100} />
      <p class="mono note">Public list prices, annual billing where offered, reviewed September 2026. Stored sizes are not directly comparable: Obstack bills compressed bytes at rest, Elastic bills size before compression, Grafana bills volume written. Enterprise agreements differ from list.</p>
    </div>
  </section>

  <section class="section-tight" id="pageroot">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">04 / PageRoot</div>
          <h2 class="h2">On-call at {formatPrice(PAGEROOT.selfHosted, 'usd')}–{formatPrice(PAGEROOT.cloud, 'usd')} per user. PagerDuty starts at $21.</h2>
        </div>
        <p class="body-2">Optional on Stack and Cloud. Ten on-call users are {formatPrice(PAGEROOT.selfHosted * 10, 'usd')} / month self-hosted, versus $210 on PagerDuty Professional and $400 if you buy both Rootly products.</p>
      </div>
      <PageRootCompare />
      <p class="mono note">Public list prices, annual billing where offered, reviewed September 2026. See the <a class="text-link" href={url('/pageroot')}>PageRoot page</a> for the full comparison and where the others win.</p>
    </div>
  </section>

  <section class="dark">
    <div class="wrap section">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">05 / Storage</div>
          <h2 class="h2">Why storage is billed by the gigabyte.</h2>
        </div>
        <p class="body-2">An observability workload pays for capacity, requests, deletions and egress. Obstack storage is predictable on all four.</p>
      </div>
      <div class="grid-4 why">
        {whyStorage.map(([t, d]) => (
          <div class="stack">
            <h3 class="h3" style="font-size: 18px">{t}</h3>
            <p class="body-2" style="font-size: 15px">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">06 / Terms in brief</div>
          <h2 class="h2">The commercial terms, in four lines.</h2>
        </div>
        <a class="text-link" href={url('/terms')}>Read the full terms <Arrow size={16} /></a>
      </div>
      <div class="tile-grid grid-4">
        {keyTerms.map(([t, d]) => (
          <div>
            <span class="mono term-k">{t}</span>
            <p class="body-2" style="font-size: 15px">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap grid-2 faq">
      <div class="stack" style="gap: 16px">
        <div class="eyebrow">07 / Questions</div>
        <h2 class="h2">Before you buy.</h2>
        <p class="body-2">Anything else: <ObfuscatedEmail label="email us" class="mono" subject="Pricing question" /></p>
      </div>
      <dl>
        {faqs.map(([q, a]) => (
          <div>
            <dt>{q}</dt>
            <dd>{a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Layout>

<style>
  .price-hero { padding-top: 88px; padding-bottom: 96px; }
  #configure, #compare, #pageroot { scroll-margin-top: 64px; }
  .why { gap: 48px; }
  .why .stack { gap: 12px; padding-top: 20px; border-top: 2px solid var(--mint); }
  .note { font-size: 12px; color: var(--muted); margin-top: 20px; max-width: 980px; line-height: 1.6; }
  .term-k { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--link); font-weight: 700; }
  .faq { gap: 72px; align-items: start; }
  dl { margin: 0; border-top: 2px solid var(--ink); }
  dl div { padding: 22px 0; border-bottom: 1px solid var(--line); }
  dt { font-weight: 800; font-size: 17px; margin-bottom: 6px; }
  dd { margin: 0; color: var(--text-2); font-size: 15px; line-height: 1.65; }
  @media (max-width: 1100px) { .faq { gap: 32px; } .why { gap: 32px; } }
  @media (max-width: 800px) { .price-hero { padding-top: 48px; padding-bottom: 48px; } }
</style>
