---
import Layout from '../layouts/Layout.astro';
import PricingTable from '../components/PricingTable.astro';
import PriceTable from '../components/PriceTable.astro';
import Configurator from '../components/Configurator';
import Arrow from '../components/Arrow.astro';
import { STORAGE, findPlan, formatUsd } from '../data/plans';
import { url, mailto } from '../lib/url';

const bee = findPlan('bee');
const cloud = findPlan('cloud');
const tb = formatUsd(STORAGE.pricePerTb);

const vendorHead = ['', 'Pricing model', 'Per host', 'Logs and traces', 'Stored data', 'Users', 'During an incident'];
const vendors = [
  ['Obstack', 'Flat per node, storage by the terabyte', `${formatUsd(bee.price)}–${formatUsd(cloud.price)} / node / month`, 'Included, not metered', `${tb} / TB / month, capacity you choose`, 'Unlimited, included', 'Unchanged'],
  ['Datadog', 'Per host, plus per GB and per event', '$46 / host / month for Infrastructure Pro + APM Pro', '$0.10 / GB ingested, plus $1.70 per million log events indexed', 'Priced into indexing; longer retention costs more', 'Included', 'Host, span and log meters rise'],
  ['Dynatrace', 'Per memory GiB-hour, plus per GiB ingested', '≈ $58 / month for an 8 GiB host on Full-Stack', '$0.20 / GiB ingested', 'Retention billed per GiB-day', 'Included', 'Ingest rises; bigger hosts cost more'],
  ['Grafana Cloud', '$19 platform fee plus usage', '$0.025 / host-hour, ≈ $18 / host / month', '$0.45 / GB written', '$0.10 / GB / month, ≈ $100 / TB', 'Varies by plan', 'Series, GB written and retention rise'],
  ['New Relic', 'Per GB ingested, plus per user', 'No host fee', '$0.40 / GB beyond 100 GB free ($0.60 with Data Plus)', 'Default retention included', '$349 / full-platform user / month (Pro, annual)', 'Ingest rises'],
  ['Elastic Serverless', 'Per GB ingested and per GB retained', 'No host fee', '$0.09–0.15 / GB ingested', '≈ $0.02 / GB / month, measured before compression', 'Included', 'Ingest and retention rise'],
];

const s3Head = ['', 'Storage / TB / month', 'Egress', 'API calls', 'Minimum storage duration', 'EU regions'];
const s3 = [
  ['IDrive e2', `$6 list · ${tb} through Obstack, operations included`, 'Free up to 3× stored per month; always included through Obstack', 'Free', 'None', STORAGE.regions.join(', ')],
  ['Backblaze B2', '$6.95', 'Free up to 3× stored, then $0.01 / GB', 'Free, except one class above a daily allowance', 'None', 'Amsterdam'],
  ['Wasabi', '$7.99', 'Free under a fair-use policy', 'Free', '90 days, billed even after deletion', 'Several, including Milan and Frankfurt'],
  ['Impossible Cloud', '€7.99', 'Free', 'Free', 'None', 'Germany and other EU'],
  ['Cloudflare R2', '$15', 'Free', '$4.50 per million writes, $0.36 per million reads', 'None', 'EU jurisdiction option'],
  ['Amazon S3 Standard', '$23', '$90 / TB to the internet', '$5 per million writes', 'None', 'Milan, Frankfurt and others'],
];

const whyStorage = [
  ['Lowest list price without egress fees', 'At $6 per TB it undercuts Backblaze, Wasabi and Impossible Cloud, and costs a quarter of Amazon S3 before S3 charges a cent of egress.'],
  ['Free API calls', 'GreptimeDB writes, compacts and reads Parquet files all day. Per-request fees on R2 or S3 grow with that activity; on IDrive e2 they are zero.'],
  ['No minimum storage duration', 'Retention deletes telemetry every day. Wasabi bills 90 days for every object, so you would keep paying for data already gone.'],
  ['Data stays in Italy', 'The Milan region keeps Italian telemetry in Italy; Frankfurt, Paris and Ireland cover the rest of the EU. London, outside the EU, is not offered.'],
];

const keyTerms = [
  ['Billing', 'Yearly in advance, in USD, VAT on invoice. Card, or bank transfer within 30 days.'],
  ['Changes', 'Add nodes or terabytes any time, prorated to your renewal date. Reduce at renewal.'],
  ['Renewal', 'Renews for the same term unless cancelled 30 days before. 1-year renewals rise at most 5%; 3-year terms are locked.'],
  ['Refund', 'Full refund within 30 days of your first order. Cloud outages earn service credits.'],
];

const faqs = [
  ['What counts as a node?', 'One Linux host, VM or Kubernetes worker node running an Obstack agent. Pods and containers are not counted, and autoscaling bursts of up to 20% for a few days a month are covered.'],
  ['Is anything metered?', 'No. Ingest, egress, queries and users are free. Storage is a capacity you choose: when it fills, the oldest data expires first and we warn you at 80%. There is never an overage bill.'],
  ['Self-hosted or Cloud?', 'Self-hosted runs on your servers under an offline license, air-gapped sites included, and you run the backend. Obstack Cloud is the same stack operated by us in the EU: you install the agents, we run and upgrade the rest. Your data exports in open formats either way.'],
  ['How much storage do I need?', 'Nodes × stored GB per node per day × retention days. The configurator does the arithmetic. Start with the retention you need today; you can add terabytes at any time.'],
  ['How is a self-hosted license delivered?', 'As an Ed25519-signed file sent by email. It works offline, is bound to no machine and needs no license server.'],
  ['Can we try it first?', 'Yes. Ask info@obstack.it for a 30-day evaluation license, or a 30-day Cloud trial with 1 TB of storage.'],
];
---

<Layout
  title="Pricing · Obstack"
  description="Obstack pricing: self-hosted from $15 per node per month, Obstack Cloud from $39 per node plus storage at $7 per TB. No ingest, egress, query or user meters."
  active="pricing"
>
  <section class="hero">
    <div class="wrap price-hero">
      <div class="stack" style="gap: 22px; max-width: 880px">
        <div class="eyebrow rise">Pricing</div>
        <h1 class="display rise">Flat per node. Storage by the terabyte. Nothing metered.</h1>
        <p class="lead rise-2" style="max-width: 680px">Run Obstack on your servers or let us run it in the EU. Either way your bill looks the same during an incident as it does on a quiet Sunday.</p>
        <div class="btn-row rise-2" style="padding-top: 8px">
          <a class="btn btn-primary" href="#configure">Configure a quote <Arrow /></a>
          <a class="btn btn-ghost" href="#compare">Compare with Datadog and others</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <PricingTable variant="all" />
    </div>
  </section>

  <section class="section-tight" id="configure">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">01 / Configurator</div>
          <h2 class="h2">Pick the deployment, the nodes and the terabytes.</h2>
        </div>
        <p class="body-2">Discounts apply as you go. Take the quote straight to checkout, or send it to sales for a purchase order.</p>
      </div>
      <Configurator client:load />
    </div>
  </section>

  <section class="dark">
    <div class="wrap section">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">02 / Storage</div>
          <h2 class="h2">Why your terabytes live on IDrive e2.</h2>
        </div>
        <p class="body-2">We compared every major S3-compatible provider on what an observability workload actually pays for: capacity, requests, deletions and egress.</p>
      </div>
      <div class="grid-4 why">
        {whyStorage.map(([t, d]) => (
          <div class="stack">
            <h3 class="h3" style="font-size: 18px">{t}</h3>
            <p class="body-2" style="font-size: 15px">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <PriceTable head={s3Head} rows={s3} highlight={0} />
      <p class="mono note">Pay-as-you-go list prices from each provider's public pricing page, reviewed September 2026. Through Obstack, storage is {tb} per TB per month with egress, API calls and deletions included.</p>
    </div>
  </section>

  <section class="section-tight" id="compare">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">03 / Against the market</div>
          <h2 class="h2">What grows your bill, vendor by vendor.</h2>
        </div>
        <p class="body-2">The other platforms price the traffic you send them, so an incident that triples your telemetry triples part of the invoice. Obstack prices the fleet.</p>
      </div>
      <PriceTable head={vendorHead} rows={vendors} highlight={0} minWidth={1100} />
      <p class="mono note">Public list prices, annual billing where offered, reviewed September 2026. Stored sizes are not directly comparable: Obstack bills compressed bytes at rest, Elastic bills size before compression, Grafana bills volume written. Enterprise agreements differ from list.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">04 / Terms in brief</div>
          <h2 class="h2">The commercial terms, in four lines.</h2>
        </div>
        <a class="text-link" href={url('/terms')}>Read the full terms <Arrow size={16} /></a>
      </div>
      <div class="tile-grid grid-4">
        {keyTerms.map(([t, d]) => (
          <div>
            <span class="mono term-k">{t}</span>
            <p class="body-2" style="font-size: 15px">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap grid-2 faq">
      <div class="stack" style="gap: 16px">
        <div class="eyebrow">Questions</div>
        <h2 class="h2">Before you buy.</h2>
        <p class="body-2">Anything else: <a href={mailto('Pricing question')}>info@obstack.it</a></p>
      </div>
      <dl>
        {faqs.map(([q, a]) => (
          <div>
            <dt>{q}</dt>
            <dd>{a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Layout>

<style>
  .price-hero { padding-top: 88px; padding-bottom: 96px; }
  #configure { scroll-margin-top: 96px; }
  .why { gap: 48px; }
  .why .stack { gap: 12px; padding-top: 20px; border-top: 2px solid var(--mint); }
  .note { font-size: 12px; color: var(--muted); margin-top: 20px; max-width: 980px; line-height: 1.6; }
  .term-k { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--link); font-weight: 700; }
  .faq { gap: 72px; align-items: start; }
  dl { margin: 0; border-top: 2px solid var(--ink); }
  dl div { padding: 22px 0; border-bottom: 1px solid var(--line); }
  dt { font-weight: 800; font-size: 17px; margin-bottom: 6px; }
  dd { margin: 0; color: var(--text-2); font-size: 15px; line-height: 1.65; }
  @media (max-width: 1100px) { .faq { gap: 32px; } .why { gap: 32px; } }
  @media (max-width: 800px) { .price-hero { padding-top: 64px; padding-bottom: 64px; } }
</style>
