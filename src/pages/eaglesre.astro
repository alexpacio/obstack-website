---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import EagleMark from '../components/EagleMark.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import Price from '../components/Price.astro';
import { EAGLESRE, AI_BILLING } from '../data/product-pricing';
import { breadcrumbSchema, softwareSchema } from '../lib/seo';
import { url } from '../lib/url';

const flow = [
  ['Receive', 'Eagle monitors, Prometheus Alertmanager or a token-authenticated webhook brings an alert into the incident workflow.'],
  ['Respond', 'Map the incident to a service, severity and escalation policy. Work from Eagle, Slack or Microsoft Teams.'],
  ['Investigate', 'Ask a question. The investigation agent gathers evidence with approved read-only queries and checkpoints its steps.'],
  ['Learn', 'Keep the timeline, follow-ups, postmortem and status updates alongside the incident.'],
];
const features = [
  ['On-call and escalations', 'Schedules and escalation steps connect incidents to responders. Notification adapters cover Slack, Teams, email, Pushover and Twilio.'],
  ['One identity', 'Eagle provides the identity service. EagleSRE checks changes against current permissions, with short-lived credentials.'],
  ['Evidence you can follow', 'The LangGraph investigation agent runs as a Serverless function. Its checkpointed steps leave a record of how it reached an answer.'],
  ['People approve changes', 'Chat actions require confirmation against the incident revision. Proposed monitors wait for a person to approve the tested revision in the web console.'],
];
---

<Layout
  title="Obstack EagleSRE · on-call, incidents and investigations"
  description="EagleSRE brings on-call schedules, escalations, incidents and an investigation agent alongside Eagle. Preview access by request."
  active="eaglesre"
  image="/og-eagle.png"
  schema={[
    breadcrumbSchema('/eaglesre', 'EagleSRE'),
    softwareSchema({ path: '/eaglesre', name: 'Obstack EagleSRE', description: 'On-call, incident response and checkpointed investigations alongside Eagle. Currently in preview.' }),
  ]}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="stack" style="gap: 26px">
        <div class="brand-row"><EagleMark size={32} /><span class="eyebrow">Obstack EagleSRE</span><span class="badge badge-line">Preview</span></div>
        <h1 class="display rise">From an alert to a response your team can follow.</h1>
        <p class="lead rise-2">On-call, escalation policies, incidents and an investigation agent beside Eagle. Respond from the console, Slack or Microsoft Teams, using the identity your team already has.</p>
        <div class="btn-row rise-2">
          <ObfuscatedEmail class="btn btn-primary" subject="EagleSRE preview" label="Request preview access" />
          <a class="btn btn-ghost" href="#pricing">See proposed pricing <Arrow /></a>
        </div>
      </div>
      <figure class="shot rise-3">
        <img src={url('/images/eaglesre_incident.webp')} alt="EagleSRE preview inside Eagle: an incident drawer with acknowledge, escalate and resolve actions, investigation and timeline" width="2000" height="1250" />
        <figcaption>Incident response inside Eagle. EagleSRE is in preview.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="stack"><div class="eyebrow">The incident workflow</div><h2 class="h2">Keep the alert, the people and the evidence together.</h2></div>
        <p class="body-2">EagleSRE is an optional service alongside Eagle. The console and the investigation agent work with the same incident record.</p>
      </div>
      <ol class="flow">
        {flow.map(([title, text], i) => <li><span class="mono">0{i + 1}</span><h3 class="h3">{title}</h3><p class="body-2">{text}</p></li>)}
      </ol>
      <div class="tile-grid grid-2">
        {features.map(([title, text]) => <div><h3 class="h3">{title}</h3><p class="body-2">{text}</p></div>)}
      </div>
      <p class="preview-note"><strong>Preview availability.</strong> Incident records, escalation workers, chat adapters and the investigation agent are built. Delivery through each notification provider is in acceptance testing. Production paging commitments are agreed after acceptance; request an evaluation to validate your workflow.</p>
    </div>
  </section>

  <section class="section-tight" id="pricing">
    <div class="wrap panel pricing-panel">
      <div class="stack" style="gap: 18px">
        <div class="eyebrow">Proposed production pricing</div>
        <h2 class="h2"><Price eur={EAGLESRE.launchPrice} /> / month on Go. Included in Pro and Max at launch.</h2>
        <p class="body-2">Flat per deployment, with unlimited on-call users and incidents. EagleSRE is not offered on Starter. Preview access is by request; production billing starts only after general availability and an agreed activation.</p>
        <p class="small">{AI_BILLING}</p>
      </div>
      <div class="btn-row">
        <ObfuscatedEmail class="btn btn-dark" subject="EagleSRE preview" label="Discuss an evaluation" />
        <a class="text-link" href={url('/pricing#products')}>Compare every product <Arrow size={16} /></a>
      </div>
    </div>
  </section>

  <section class="dark">
    <div class="wrap cta-band">
      <div class="stack" style="gap: 18px"><h2 class="h2">Part of the Eagle family.</h2><p class="body-2">Eagle is the console. EagleSRE coordinates incidents. EagleMCP connects assistants to the stack.</p></div>
      <div class="btn-row"><a class="btn btn-primary" href={url('/eagle')}>Explore Eagle <Arrow /></a><a class="btn btn-ghost" href={url('/eaglemcp')}>Explore EagleMCP</a></div>
    </div>
  </section>
</Layout>

<style>
  .brand-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .shot { margin: 0; min-width: 0; }
  .shot img { display: block; width: 100%; height: auto; border-radius: 14px; border: 1px solid var(--on-dark-line); }
  .shot figcaption { margin-top: 14px; color: var(--on-dark-2); font-size: 14px; }
  .flow { list-style: none; padding: 0; margin: 0 0 48px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .flow li { display: flex; flex-direction: column; gap: 12px; padding-top: 20px; border-top: 2px solid var(--ink); }
  .flow .mono { color: var(--link); }
  .preview-note { margin-top: 32px; padding: 20px; border: 1px dashed var(--line); line-height: 1.7; }
  .pricing-panel { display: flex; flex-direction: column; gap: 28px; padding: 32px; }
  @media (max-width: 1100px) { .hero-grid { grid-template-columns: minmax(0, 1fr); } .flow { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 800px) { .flow { grid-template-columns: minmax(0, 1fr); } .pricing-panel { padding: 24px; } }
</style>
