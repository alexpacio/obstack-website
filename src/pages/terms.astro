---
import Layout from '../layouts/Layout.astro';
import PriceTable from '../components/PriceTable.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import { AURORA, PAGEROOT, STORAGE, TERM_DISCOUNT, dualPrice, findPlan, pct, volumeBands } from '../data/plans';
import { url } from '../lib/url';

const bee = findPlan('bee');
const stack = findPlan('stack');
const cloud = findPlan('cloud');
const gb = dualPrice(STORAGE.pricePerGb);

interface Section {
  id: string;
  title: string;
  paras: string[];
  table?: { head: string[]; rows: string[][] };
  after?: string[];
}

const sections: Section[] = [
  {
    id: 'scope',
    title: 'Scope',
    paras: [
      'These terms cover Obstack subscriptions bought on obstack.it or through a quote from us. Obstack is sold by Netter srl, P.IVA IT03569900545, Via Indipendenza, 06081 Assisi (PG), Italy. Where a signed order form or master agreement differs, that document prevails.',
      'List prices are in euros. US dollar prices are 25% above the euro list. Prices exclude VAT. VAT is added where it applies; business customers in other EU countries with a valid VAT number are invoiced under reverse charge. The invoice is issued in the currency chosen at checkout.',
    ],
  },
  {
    id: 'plans',
    title: 'Plans',
    paras: [
      `${bee.name}, ${dualPrice(bee.price)} per node per month: the application agent. The first month ships under a license key. After that the PolyForm Internal Use License applies; once you sign the agreement, you get the source over git. It exports to a collector you run and stores nothing itself.`,
      `${stack.name}, ${dualPrice(stack.price)} per node per month: Bee plus our support for Beyla, Vector, Kafka, GreptimeDB, Grafana and Prometheus Alertmanager, on your infrastructure. We deploy and configure the infrastructure, with reference Grafana dashboards. Storage is your own, or Obstack storage at ${gb} per GB per month.`,
      `${cloud.name}, ${dualPrice(cloud.price)} per node per month: we deploy and operate the backend in the EU or US datacenter you choose, with the same setup, and you run the agents. Storage is bought by the gigabyte, from ${STORAGE.minGb} GB.`,
      `${stack.name} and ${cloud.name} start at ${stack.minNodes} nodes. Enterprise terms are agreed per contract.`,
      'Air-gapped deployments, offline updates and sites with no outbound connectivity are not included in list plans. They are quoted as Enterprise.',
    ],
  },
  {
    id: 'pageroot',
    title: 'PageRoot module',
    paras: [
      `PageRoot is an optional on-call module on ${stack.name} and ${cloud.name}. It is not available with Bee alone.`,
      `Self-hosted PageRoot is ${dualPrice(PAGEROOT.selfHosted)} per on-call user per month. PageRoot on Obstack Cloud is ${dualPrice(PAGEROOT.cloud)} per on-call user per month. An on-call user is a person who can be placed on a schedule or receive a page. People who only watch ChatOps are not billed.`,
      'Volume discounts and the yearly and 3-year billing discounts that apply to node fees also apply to PageRoot seats. Storage is not discounted.',
      'PageRoot can be added to an existing Stack or Cloud subscription at any time, prorated to the renewal date. Reduce seats at renewal.',
    ],
  },
  {
    id: 'aurora',
    title: 'Aurora AI module',
    paras: [
      `Aurora AI is an optional module on ${stack.name} and ${cloud.name}. It is not available with Bee alone. The list SKU is a bundle: Aurora plus unlimited ${AURORA.model} inference hosted by Obstack, at ${dualPrice(AURORA.price)} per month.`,
      `Unlimited means Aurora investigations on that subscription are not token-metered. It is not a general-purpose API for other workloads. Prompts go to ${AURORA.model} in the EU or US datacenter you pick; telemetry stays in GreptimeDB.`,
      'Volume discounts and the yearly and 3-year billing discounts do not apply to Aurora. Storage and Aurora are not discounted.',
      'Aurora can be added to an existing Stack or Cloud subscription at any time, prorated to the renewal date. Remove it at renewal. Running Aurora against your own model, or air-gapped with a local model, is quoted as Enterprise.',
    ],
  },
  {
    id: 'custom-work',
    title: 'Custom work',
    paras: [
      'Work beyond the standard setup is not included in any subscription. This covers, for example, building dashboards for your services, configuring alert rules and notification routing, and migrating dashboards, alerts, workflows and incidents from your current tools.',
      'Custom work is billed on time and materials. We estimate it in a written quote that you approve before any work starts, and invoice the time actually spent.',
    ],
  },
  {
    id: 'nodes',
    title: 'Nodes',
    paras: [
      'A node is one Linux host, virtual machine or Kubernetes worker node running an Obstack agent. Pods and containers are not counted.',
      'Bursts are covered: autoscaling up to 20% above your node count, for up to 7 days in a calendar month, costs nothing extra. There are no retroactive true-ups.',
      'Add nodes, PageRoot seats or Aurora at any time; they are billed prorated to your renewal date at your current rate. Reduce nodes or seats, or remove Aurora, at renewal.',
    ],
  },
  {
    id: 'storage',
    title: 'Storage',
    paras: [
      `Managed storage is Obstack object storage, in the EU or US datacenter you choose. It is priced by capacity at ${gb} per GB per month, measured as compressed data at rest.`,
      'Egress, API requests and early deletion are included.',
      'When your capacity is full, the oldest data expires first. We warn you at 80% and 95%. You are never billed for overage.',
      'Increase capacity at any time, prorated to your renewal date; reduce it at renewal. Self-hosted customers can use any S3-compatible bucket or local disk instead, at no charge from us.',
    ],
  },
  {
    id: 'fair-use',
    title: 'Fair use on Obstack Cloud',
    paras: [
      'Ingest, queries and users are not metered. If a fleet averages more than 50 GB of raw telemetry per node per day over a full calendar month, we will contact you to agree a change of plan. We will never add charges automatically.',
    ],
  },
  {
    id: 'discounts',
    title: 'Discounts',
    paras: [
      `Volume discounts are graduated and apply to node fees and to PageRoot seats: ${volumeBands().join(', ')}. Each unit is priced by the band it falls in, so adding a node or a seat never lowers the total.`,
      `Yearly billing takes ${pct(TERM_DISCOUNT[12])} off node fees and PageRoot fees, on top of volume discounts. A 3-year term takes ${pct(TERM_DISCOUNT[36])} off those same fees, is billed yearly, and locks the unit prices for the whole term. Storage and Aurora are not discounted. Monthly billing is at list, after volume.`,
    ],
  },
  {
    id: 'billing',
    title: 'Billing and payment',
    paras: [
      'Subscriptions are billed monthly at list, or yearly in advance. 3-year terms are billed yearly. Pay by bank transfer within 30 days of the invoice date. Card payments are not accepted.',
      'If an invoice is more than 30 days overdue, Cloud access may be suspended after 14 days’ written notice. Self-hosted license keys, git access and updates are suspended the same way; copies you already have remain usable under the PolyForm Internal Use License for internal business operations.',
    ],
  },
  {
    id: 'renewal',
    title: 'Term, renewal and cancellation',
    paras: [
      'Monthly subscriptions renew each month unless cancelled in writing before the next invoice. Yearly and 3-year subscriptions renew for the same length of term unless either side cancels in writing at least 30 days before the renewal date.',
      'Yearly renewals can rise by at most 5% over the previous per-node price. 3-year terms are locked for their full length. Monthly list can rise on 30 days’ notice, at most 5% in a calendar year.',
      'A first order can be cancelled within 30 days for a full refund. After that, fees for the current term are not refunded, except as service credits.',
    ],
  },
  {
    id: 'sla',
    title: 'Service level on Obstack Cloud',
    paras: [
      'The OTLP ingest endpoint and the Grafana and query interfaces are available at least 99.9% of each calendar month. Maintenance announced at least 5 days ahead, and outages caused by the customer or by force majeure, do not count.',
    ],
    table: {
      head: ['Monthly availability', 'Service credit'],
      rows: [
        ['Below 99.9%', '10% of that month’s Cloud fees'],
        ['Below 99.0%', '25% of that month’s Cloud fees'],
        ['Below 95.0%', '50% of that month’s Cloud fees'],
      ],
    },
    after: ['Credits are applied to the next invoice when claimed within 30 days of the end of the month.'],
  },
  {
    id: 'support',
    title: 'Support',
    paras: ['Response targets measure the time to a first reply from an engineer.'],
    table: {
      head: ['Plan', 'Channel', 'P1 · service down', 'P2 · degraded', 'P3 · question'],
      rows: [
        [bee.name, 'Email, business hours', 'Next business day', 'Next business day', '2 business days'],
        [stack.name, 'Email and tickets, business hours', '4 business hours', '1 business day', '2 business days'],
        [cloud.name, 'Email and tickets; P1 around the clock', '1 hour, 24/7', '4 business hours', '1 business day'],
        ['Enterprise', '24/7, with a named engineer', '30 minutes, 24/7', '2 hours', '1 business day'],
      ],
    },
    after: ['Business hours are 09:00–18:00 CET, Monday to Friday, excluding Italian public holidays.'],
  },
  {
    id: 'licenses',
    title: 'Self-hosted licenses',
    paras: [
      'The first month of a self-hosted subscription, Bee and PageRoot (when PageRoot is on the order) are delivered under a license key: Ubuntu packages you run, without source.',
      'After that first month the PolyForm Internal Use License 1.0.0 applies to Bee and to PageRoot. We send an agreement to sign. Once it is signed, you are granted git access to the source. You may use and modify that software for the internal business operations of you and your company. You may not distribute it, sublicense it or transfer the license.',
      'An active paid subscription is how you keep git access and updates. When the subscription ends, git access stops. Copies you already have remain usable under PolyForm Internal Use for internal use. PageRoot is not distributed as a standalone product without Stack or Cloud.',
      'Aurora is Apache 2.0 software. When it is on the order, Obstack deploys it and hosts DeepSeek 4 Flash for Aurora investigations on that subscription. Aurora is not distributed as a standalone Obstack product without Stack or Cloud.',
      'The open-source components of the stack (Beyla, Vector, Kafka, GreptimeDB, Grafana and Prometheus Alertmanager) stay under their own licenses. The subscription pays for Bee, PageRoot when purchased, Aurora when purchased, our integration work and our support.',
    ],
  },
  {
    id: 'data',
    title: 'Your data',
    paras: [
      'You own your telemetry. On Obstack Cloud we process it only to run the service, in the EU or US datacenter you chose, under a data processing agreement per Article 28 GDPR, available on request with the list of sub-processors.',
      'Export at any time with SQL, PromQL or the raw Parquet files. When a Cloud subscription ends you have 30 days to export; we then delete tenant data within a further 30 days.',
    ],
  },
  {
    id: 'liability',
    title: 'Liability',
    paras: [
      'Each party’s total liability under a subscription is capped at the fees paid in the 12 months before the claim. Neither party is liable for indirect or consequential loss. These limits do not apply where the law does not allow them.',
    ],
  },
  {
    id: 'law',
    title: 'Governing law',
    paras: ['These terms are governed by Italian law. Disputes go to the competent court for Assisi, Italy, where Netter srl has its registered office.'],
  },
];
---

<Layout title="Commercial terms · Obstack" description="Obstack commercial terms: nodes, storage, discounts, billing, renewal, service levels, support and data.">
  <section class="hero">
    <div class="wrap terms-hero">
      <div class="stack" style="gap: 22px; max-width: 820px">
        <div class="eyebrow rise">Commercial terms</div>
        <h1 class="display rise">Plain terms, no fine print.</h1>
        <p class="lead rise-2">What you pay for, what is included, and what happens at renewal. Last updated 11 September 2026.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap terms">
      <nav class="toc mono" aria-label="Sections">
        {sections.map((s, i) => <a href={`#${s.id}`}><span>{String(i + 1).padStart(2, '0')}</span>{s.title}</a>)}
      </nav>
      <div class="body">
        {sections.map((s, i) => (
          <section id={s.id} class="clause">
            <h2 class="h3"><span class="mono">{String(i + 1).padStart(2, '0')}</span>{s.title}</h2>
            {s.paras.map((p) => <p class="body-2" set:html={p} />)}
            {s.table && <PriceTable head={s.table.head} rows={s.table.rows} minWidth={s.table.head.length > 2 ? 720 : 0} />}
            {s.after?.map((p) => <p class="small">{p}</p>)}
          </section>
        ))}
        <div class="panel contact">
          <p class="body-2">Questions about these terms, or need an order form and DPA for procurement?</p>
          <div class="btn-row">
            <ObfuscatedEmail class="btn btn-dark" label="Email us" subject="Commercial terms" />
            <a class="btn btn-outline" href={url('/pricing#configure')}>Configure a quote</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .terms-hero { padding-top: 88px; padding-bottom: 88px; }
  .terms { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 72px; align-items: start; }
  .toc { position: sticky; top: 64px; display: flex; flex-direction: column; border-top: 2px solid var(--ink); font-size: 13px; }
  .toc a { display: flex; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line-soft); color: var(--text-2); text-decoration: none; }
  .toc a:hover { color: var(--ink); }
  .toc span { color: var(--link); }
  .body { display: flex; flex-direction: column; gap: 56px; max-width: 860px; }
  .clause { display: flex; flex-direction: column; gap: 14px; scroll-margin-top: 64px; }
  .clause h2 { display: flex; gap: 14px; align-items: baseline; padding-bottom: 12px; border-bottom: 2px solid var(--ink); }
  .clause h2 .mono { font-size: 13px; color: var(--link); }
  .contact { padding: 32px; display: flex; flex-direction: column; gap: 20px; }
  @media (max-width: 1100px) {
    .terms { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .toc { position: static; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 32px; }
  }
  @media (max-width: 800px) {
    .terms-hero { padding-top: 48px; padding-bottom: 56px; }
    .body { gap: 40px; }
    .toc { grid-template-columns: minmax(0, 1fr); }
    .contact { padding: 24px; }
  }
</style>
