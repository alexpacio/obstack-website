---
import Layout from "../layouts/Layout.astro";

const basePath = import.meta.env.BASE_URL || '';
---

<Layout title="Request a Demo — Obstack Bee Observability" description="Request a personalized demo of Obstack Bee. Our team will show you how to deploy zero-code observability with eBPF and native Node.js profiling.">
  <!-- Hero -->
  <section class="py-20 sm:py-32">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
          Request a Demo
        </h1>
        <p class="mt-6 text-lg text-gray-600">
          See Obstack Bee in action. Our team will walk you through deployment,
          configuration, and how to get the most out of your observability stack.
        </p>
      </div>
    </div>
  </section>

  <!-- Demo Form -->
  <section class="py-16 sm:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl">
        <div class="rounded-xl border border-gray-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-gray-900">Schedule your demo</h2>
          <p class="mt-2 text-sm text-gray-600">
            Fill out the form below and we'll contact you within 1 business day
            to schedule a 30-minute demo.
          </p>

          <form id="demo-form" class="mt-8 space-y-6">
            <div class="grid gap-6 sm:grid-cols-2">
              <div>
                <label for="first-name" class="block text-sm font-medium text-gray-900">
                  First name
                </label>
                <input
                  type="text"
                  id="first-name"
                  name="first_name"
                  required
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                />
              </div>

              <div>
                <label for="last-name" class="block text-sm font-medium text-gray-900">
                  Last name
                </label>
                <input
                  type="text"
                  id="last-name"
                  name="last_name"
                  required
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-gray-900">
                Work email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
              />
            </div>

            <div>
              <label for="company" class="block text-sm font-medium text-gray-900">
                Company
              </label>
              <input
                type="text"
                id="company"
                name="company"
                required
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
              />
            </div>

            <div>
              <label for="role" class="block text-sm font-medium text-gray-900">
                Role
              </label>
              <select
                id="role"
                name="role"
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
              >
                <option value="">Select your role</option>
                <option value="engineering">Engineering</option>
                <option value="devops">DevOps / SRE</option>
                <option value="platform">Platform Engineering</option>
                <option value="executive">Executive / Leadership</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label for="company-size" class="block text-sm font-medium text-gray-900">
                Company size
              </label>
              <select
                id="company-size"
                name="company_size"
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
              >
                <option value="">Select company size</option>
                <option value="1-10">1-10 employees</option>
                <option value="11-50">11-50 employees</option>
                <option value="51-200">51-200 employees</option>
                <option value="201-1000">201-1000 employees</option>
                <option value="1000+">1000+ employees</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-gray-900">
                What are you looking to observe?
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                placeholder="Tell us about your observability needs, current stack, and pain points..."
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
              ></textarea>
            </div>

            <div class="flex items-start">
              <div class="flex items-center">
                <input
                  id="consent"
                  name="consent"
                  type="checkbox"
                  required
                  class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
                />
                <label for="consent" class="ml-2 block text-sm text-gray-600">
                  I agree to be contacted by Obstack and accept the
                  <a href={`${basePath}/privacy`} class="text-indigo-600 hover:underline">Privacy Policy</a>
                </label>
              </div>
            </div>

            <button
              type="submit"
              class="w-full rounded-md bg-indigo-600 px-6 py-3 text-base font-medium text-white hover:bg-indigo-700"
            >
              Request Demo
            </button>
          </form>

          <div id="form-success" class="mt-6 hidden rounded-md bg-green-50 p-4 text-center">
            <p class="text-sm font-medium text-green-800">
              Thank you! Your demo request has been submitted. We'll contact you
              within 1 business day.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Info -->
  <section class="bg-gray-50 py-16 sm:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
          Or contact us directly
        </h2>
        <p class="mt-4 text-lg text-gray-600">
          Have a question? Reach out via email or chat with us live.
        </p>
        <div class="mt-8 space-y-4 text-center">
          <p class="text-lg">
            <a href="mailto:sales@obstack.io" class="text-indigo-600 hover:underline">
              sales@obstack.io
            </a>
          </p>
          <p class="text-lg">
            <a href="mailto:support@obstack.io" class="text-indigo-600 hover:underline">
              support@obstack.io
            </a>
          </p>
          <p class="text-sm text-gray-500">
            Our chat widget is available in the bottom-right corner for live support.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var form = document.getElementById('demo-form');
      var successDiv = document.getElementById('form-success');

      form.addEventListener('submit', function(e) {
        e.preventDefault();

        // In a real implementation, this would POST to your backend
        // For now, we'll simulate a successful submission
        var formData = new FormData(form);
        var data = Object.fromEntries(formData);

        // Send to backend endpoint (configure this)
        fetch('/api/demo-request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        }).catch(function() {
          // Ignore errors in demo mode
        });

        form.reset();
        form.style.display = 'none';
        successDiv.classList.remove('hidden');
      });
    });
  </script>
</Layout>
