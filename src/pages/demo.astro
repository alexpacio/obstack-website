---
import Layout from '../layouts/Layout.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import { url } from '../lib/url';
import { CHAPTERS, JOURNEY, runTime } from '../data/videos';
import { DEMO } from '../data/plans';
import { breadcrumbSchema } from '../lib/seo';
---

<Layout
  title="Watch Obstack in action"
  description="A real UI recording of application metrics, logs and traces in Grafana, alongside the Eagle product family."
  schema={[breadcrumbSchema('/demo', 'Watch Obstack in action')]}
>
  <section class="hero">
    <div class="wrap hero-grid demo-hero">
      <div class="stack" style="gap: 26px">
        <div class="eyebrow rise">Watch the stack at work</div>
        <h1 class="display rise">Explore real<br />telemetry.</h1>
        <p class="lead rise-2">A Python application sends metrics, logs and traces through Vector. Follow the metrics, logs and traces in Grafana — {runTime(JOURNEY.seconds)} of the working stack, uncut in the parts that matter.</p>
      </div>

      <div class="stack rise-3" style="gap: 16px">
        <VideoPlayer clip={JOURNEY} rec>
          <span>Grafana / metrics, logs and traces</span>
          <a href="#chapters">Chapter by chapter &darr;</a>
        </VideoPlayer>
        <p class="small note">Recorded in a working Obstack demo, against a Python application that really fails. Loading screens and model response waits are shortened in the edit; the interactions are not.</p>
      </div>
    </div>
  </section>

  <!-- Chapters -->
  <section class="section" id="chapters">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">Inside the recording</div>
          <h2 class="h2">Follow the application signals.</h2>
        </div>
        <p class="body-2">Application metrics, logs and a distributed trace from the working demo, with English captions.</p>
      </div>

      <div class="chapters">
        {CHAPTERS.map((chapter, i) => (
          <article class="chapter">
            <div class="stack">
              <div class="eyebrow">Chapter {String(i + 1).padStart(2, '0')} / {runTime(chapter.seconds)}</div>
              <h3 class="h3">{chapter.title}</h3>
              <p class="body-2">{chapter.text}</p>
            </div>
            <VideoPlayer clip={chapter} preload="none" />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="dark">
    <div class="wrap cta-band">
      <div class="stack" style="gap: 18px">
        <h2 class="h2">Explore Eagle, EagleSRE and EagleMCP on your own telemetry.</h2>
        <p class="body-2" style="font-size: 18px; max-width: 620px">Install the Max demo on your Kubernetes cluster with the Obstack Helm chart and a {DEMO.days}-day license. Evaluate it with your own data, then activate the same installation on self-hosted Go, Pro or Max.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" href={url('/download')}>Get the Max demo · {DEMO.days}-day license</a>
        <a class="btn btn-ghost" href={url('/pricing')}>See the plans</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* One column: the recording is the width of the page, not a sidebar. */
  .demo-hero { grid-template-columns: minmax(0, 1fr); gap: 44px; align-items: start; }
  .demo-hero .lead { max-width: 720px; }
  .note { color: var(--on-dark-3); max-width: 780px; }

  /* One row per chapter: the copy on the left, the recording big enough to read. */
  .chapters { display: grid; gap: 56px; }
  .chapter {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: 48px;
    align-items: start;
    padding-top: 26px;
    border-top: 2px solid var(--ink);
  }
  .chapter .stack { gap: 12px; }

  @media (max-width: 1100px) {
    .chapter { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  }
  @media (max-width: 800px) {
    .demo-hero { gap: 32px; }
    .chapters { gap: 40px; }
    .chapter { padding-top: 20px; gap: 20px; }
  }
</style>
