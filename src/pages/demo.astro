---
import Layout from "../layouts/Layout.astro";

const basePath = import.meta.env.BASE_URL || '';
---

<Layout title="Request a Demo — Obstack Bee Observability" description="Request a personalized demo of Obstack Bee. Our team will show you how to deploy zero-code observability with eBPF and native Node.js profiling.">
  <!-- Hero -->
  <section class="relative section overflow-hidden">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto animate-slide-up">
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-gray-900 mb-6">
          Request a <span class="gradient-text">Demo</span>
        </h1>
        <p class="text-lg text-gray-600 mb-10 max-w-2xl mx-auto">
          See Obstack Bee in action. Our team will walk you through deployment, configuration, and how to get the most out of your observability stack.
        </p>
      </div>
    </div>
    <div class="absolute inset-0 bg-grid opacity-50 pointer-events-none" aria-hidden="true"></div>
  </section>

  <!-- Demo Form -->
  <section class="section">
    <div class="container">
      <div class="max-w-2xl mx-auto">
        <div class="card">
          <h2 class="text-2xl font-bold text-gray-900 mb-2">Schedule your demo</h2>
          <p class="text-sm text-gray-600 mb-8">
            Fill out the form below and we'll contact you within 1 business day to schedule a 30-minute demo.
          </p>

          <form id="demo-form" class="space-y-6">
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="first-name" class="block text-sm font-medium text-gray-900 mb-1.5">First name</label>
                <input type="text" id="first-name" name="first_name" required class="w-full" />
              </div>

              <div>
                <label for="last-name" class="block text-sm font-medium text-gray-900 mb-1.5">Last name</label>
                <input type="text" id="last-name" name="last_name" required class="w-full" />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-gray-900 mb-1.5">Work email</label>
              <input type="email" id="email" name="email" required class="w-full" />
            </div>

            <div>
              <label for="company" class="block text-sm font-medium text-gray-900 mb-1.5">Company</label>
              <input type="text" id="company" name="company" required class="w-full" />
            </div>

            <div>
              <label for="role" class="block text-sm font-medium text-gray-900 mb-1.5">Role</label>
              <select id="role" name="role" class="w-full">
                <option value="">Select your role</option>
                <option value="engineering">Engineering</option>
                <option value="devops">DevOps / SRE</option>
                <option value="platform">Platform Engineering</option>
                <option value="executive">Executive / Leadership</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label for="company-size" class="block text-sm font-medium text-gray-900 mb-1.5">Company size</label>
              <select id="company-size" name="company_size" class="w-full">
                <option value="">Select company size</option>
                <option value="1-10">1-10 employees</option>
                <option value="11-50">11-50 employees</option>
                <option value="51-200">51-200 employees</option>
                <option value="201-1000">201-1000 employees</option>
                <option value="1000+">1000+ employees</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-gray-900 mb-1.5">What are you looking to observe?</label>
              <textarea id="message" name="message" rows="4" placeholder="Tell us about your observability needs, current stack, and pain points..." class="w-full"></textarea>
            </div>

            <div class="flex items-start">
              <div class="flex items-center">
                <input id="consent" name="consent" type="checkbox" required class="h-4 w-4 border-gray-300 text-primary focus:ring-primary" />
                <label for="consent" class="ml-2 block text-sm text-gray-600">
                  I agree to be contacted by Obstack and accept the
                  <a href={`${basePath}/privacy`} class="text-primary hover:underline">Privacy Policy</a>
                </label>
              </div>
            </div>

            <button type="submit" class="w-full bg-primary px-6 py-3 text-base font-medium text-white hover:bg-primary-hover">
              Request Demo
            </button>
          </form>

          <div id="form-success" class="mt-6 hidden rounded-none bg-green-50 p-4 text-center">
            <p class="text-sm font-medium text-green-800">
              Thank you! Your demo request has been submitted. We'll contact you within 1 business day.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Info -->
  <section class="section bg-gray-50">
    <div class="container">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 mb-4">
          Or contact us directly
        </h2>
        <p class="mt-4 text-lg text-gray-600 mb-10">
          Have a question? Reach out via email or chat with us live.
        </p>
        <div class="space-y-4 text-center">
          <a href="mailto:sales@obstack.io" class="inline-flex items-center gap-2 text-lg text-primary hover:underline">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            sales@obstack.io
          </a>
          <a href="mailto:support@obstack.io" class="inline-flex items-center gap-2 text-lg text-primary hover:underline">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            support@obstack.io
          </a>
          <p class="text-sm text-gray-500">
            Our chat widget is available in the bottom-right corner for live support.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var form = document.getElementById('demo-form');
      var successDiv = document.getElementById('form-success');

      form.addEventListener('submit', function(e) {
        e.preventDefault();

        var formData = new FormData(form);
        var data = Object.fromEntries(formData);

        fetch('/api/demo-request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        }).catch(function() {});

        form.reset();
        form.style.display = 'none';
        successDiv.classList.remove('hidden');
      });
    });
  </script>
</Layout>