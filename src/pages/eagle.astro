---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import EagleMark from '../components/EagleMark.astro';
import CompareTable from '../components/CompareTable.astro';
import { url } from '../lib/url';
import { DEMO } from '../data/plans';
import { breadcrumbSchema, softwareSchema } from '../lib/seo';

/** Stroke icons, 24-unit grid, one or more paths each. */
const icons: Record<string, string[]> = {
  spark: ['M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z'],
  code: ['M8 7l-5 5 5 5M16 7l5 5-5 5'],
  bell: ['M6 8a6 6 0 0112 0c0 7 3 9 3 9H3s3-2 3-9', 'M10.3 21a1.9 1.9 0 003.4 0'],
  chart: ['M3 3v18h18', 'M7 15l4-4 3 3 5-6'],
  terminal: ['M3 5h18v14H3z', 'M7 9l3 3-3 3M13 15h4'],
  lock: ['M4 10h16v11H4z', 'M8 10V7a4 4 0 018 0v3'],
  shield: ['M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z'],
  box: ['M21 16V8l-9-5-9 5v8l9 5z', 'M3 8l9 5 9-5M12 13v8'],
};

const facts = [
  ['9 sections', 'from workloads to dashboards, in the order an investigation runs'],
  ['1 search syntax', 'compiled to PromQL, LogQL or TraceQL, and shown to you'],
  ['10 assistant tools', 'each one a read-only query, run under your identity'],
  ['320 px and up', 'to a wall display, with a mouse or a finger, checked on every route'],
];

// The rail in Eagle is ordered the way an investigation runs, so the page is too.
const sequence = [
  ['What is running', 'Workloads, Hosts, Docker Swarm and Kubernetes: every service and the machine it runs on.'],
  ['How it connects', 'A Service Map drawn from traces, and APIs: every service broken down by endpoint.'],
  ['What it emitted', 'Logs, Traces and AI Observability, searched with one syntax. A trace id in a log line opens its trace.'],
  ['How you watch it', 'Monitors, Metrics and Dashboards over the same labels as everything else.'],
];

// Screenshots of the running console, against the mock API's fixtures.
const tour = [
  { id: 'workloads', label: 'Workloads', img: 'eagle_workloads', alt: 'Workloads: every running service with its node, requests per second, error rate and p95', title: 'Every running service, in one list.', text: 'The node it runs on, its CPU and memory, requests per second, error rate and p95, with bars you can read at a glance.' },
  { id: 'hosts', label: 'Hosts', img: 'eagle_host', alt: 'A host drawer: CPU and memory by state, load, and filesystems with a fill forecast showing /var/lib/mongo full in about 46 minutes', title: 'A host, measured or marked not measured.', text: 'CPU and memory by state, load, network and disk, and filesystems with a straight-line fill forecast. A metric the collector does not send says so, instead of drawing a zero.' },
  { id: 'kubernetes', label: 'Kubernetes', img: 'eagle_kubernetes', alt: 'Kubernetes pods with status, namespace, node, restarts, age, CPU and memory', title: 'Pods, nodes and restarts.', text: 'Every pod with its namespace, node, restarts, age, CPU and memory. Docker Swarm services get the same view.' },
  { id: 'logs', label: 'Logs', img: 'eagle_logs', alt: 'Logs: a volume histogram, presets, level facets with counts and log rows', title: 'Logs with facets that add up.', text: 'A volume histogram, presets and saved queries, facets whose counts add up to the rows, and a patterns view. Every search shows the LogQL it runs.' },
  { id: 'traces', label: 'Traces', img: 'eagle_trace', alt: 'A trace waterfall opened from the Traces list, with spans across frontend, shipping, mongodb and redis', title: 'Spans, traces and the waterfall.', text: 'Golden signals over whatever the search matched, then a waterfall for each trace in a drawer that lives in the URL. A trace id in a log line opens here.' },
  { id: 'ai', label: 'AI Observability', img: 'eagle_ai_obs', alt: 'The AI Observability dashboard preset: GenAI spans, error spans, p95 latency, total cost, total tokens and chat spans, with spans by status over time', title: 'Your own LLM traffic, as spans.', text: 'OpenTelemetry GenAI spans: tokens, recorded cost, tool calls and models, next to latency and errors. It installs as a dashboard preset you can then edit.' },
];

// Real compiler output from Eagle's search, not a mock-up.
const compiled = [
  ['Logs', 'LogQL', 'service:checkout level:error "timeout"', '{service_name="checkout"} |= "timeout" | level="error"'],
  ['Traces', 'TraceQL', 'service:checkout status:error duration:>500ms', '{ resource.service.name = "checkout" && status = error && duration > 500ms }'],
  ['Metrics', 'PromQL', 'avg:http_server_duration{service:checkout} by {route}', 'avg by (route) (http_server_duration{service_name="checkout"})'],
];

const tools = ['search_logs', 'search_traces', 'trace_golden_signals', 'query_metrics', 'service_map', 'list_workloads', 'list_hosts', 'host_details', 'get_trace', 'suggest_query'];

const answer = [
  ['You ask', 'In plain words, or by describing the query you want written.'],
  ['The model picks a tool', ''],
  ['Eagle runs it, as you', "The same read-only query the page would make, with your permissions, in one of your tenant's query slots. The model never touches the store."],
  ['Eagle does the arithmetic', 'Counts, extremes and when a peak happened are computed by Eagle and handed back. Missing data comes back as “not measured”, never as zero.'],
  ['You get an answer you can check', 'Every query listed and openable on its page; suggested queries come back as buttons. Up to 8 tool rounds a turn, then the tools are withdrawn and it must answer.'],
];

const aiPlaces = [
  ['spark', 'Ask Eagle, on every page', 'Root causes, where a piece of data lives, or the query you could not quite write. It docks beside the page on a desktop and opens as a sheet on a phone.'],
  ['code', 'In the function editor', 'Explain, test or debug a function. It sees your unsaved files and manifest; a proposed change opens as a diff and reaches the editor only when you apply it. Commit and deploy stay yours.'],
  ['bell', 'In EagleSRE', 'An investigation agent built on LangGraph runs as a Serverless function and checkpoints every step. Ask Eagle can read incident records, but never starts or changes one.'],
  ['chart', 'AI Observability', 'Watch your own AI features: OpenTelemetry GenAI spans with tokens, recorded cost, tool calls and models, next to their latency and errors.'],
];

const lifecycle = [
  ['Commit', 'To a Forgejo repository Eagle creates for you, or to your own Git.'],
  ['Build', "Type-checked with Deno and bundled to an eszip. Errors land in the editor's gutter."],
  ['Version', 'Immutable, numbered, deduplicated by source digest.'],
  ['Staging', 'Notifications and sink writes are captured, so nothing real is touched.'],
  ['Test', "The version's own tests, with their results kept beside it."],
  ['Production', 'Promotion gated on tests and approvals. Roll back to any built version without a rebuild.'],
];

const triggers = [
  ['Schedule', 'Every five minutes, or a cron line. Fires exactly once across replicas.'],
  ['Query', 'A query over your telemetry, evaluated against history through Piper.'],
  ['Ingest', 'A Lua predicate inside Vector, sandboxed and hot-loaded, sees each record as it arrives.'],
  ['Webhook', 'A bearer token per deployment, shown once and rotated from the console.'],
  ['Event and listen', 'Topics that other functions and external publishers write to.'],
  ['By hand', "Run now, with a form generated from the manifest's inputs."],
];

const presets = ['HTTP check', 'TLS expiry', 'DNS check', 'TCP connect', 'Postgres query check', 'AWS EC2 status'];

const isolation = [
  ['terminal', 'One worker per run', "Edge Runtime in oneshot mode: non-root, read-only root filesystem, and a run's timers die with it."],
  ['lock', 'Secrets stay in Vault', "OpenBao or Vault holds the values; Git and Postgres hold only names. Resolved secrets are redacted from every run's output."],
  ['shield', 'No path inward', "Workers reach Eagle's broker, the artifact store and the public internet. Private ranges, metadata endpoints and your databases are firewalled off."],
  ['box', 'Builds that work air-gapped', 'A pinned runtime, offline dependency packs and prebuilt preset archives: a build never reaches for a registry.'],
];

const sreFlow = [
  ['Alert in', 'Eagle monitors and query triggers, Prometheus Alertmanager, or any webhook with its own token.'],
  ['Incident', 'Mapped to a service, a severity and an escalation policy. Every action carries the version you saw, so a stale click is refused.'],
  ['Notify', 'Slack, Teams, email, Pushover or Twilio, along schedules and escalation steps.'],
  ['Investigate', 'You ask the question; the agent gathers evidence with approved read-only queries and checkpoints each step.'],
  ['Learn', 'Follow-ups, postmortems, SLO definitions and status updates, alongside the incident.'],
];

const sreCommands = [
  '/eaglesre declare S1 Checkout failures',
  '/eaglesre incidents',
  '/eaglesre ack <incident>',
  '/eaglesre investigate <incident> Compare the error spike with recent changes',
  '/eaglesre catchup <incident>',
];

const sreNotes = [
  ['From requirements to monitors.', 'Write down what must stay true. A planner drafts monitors as Serverless functions and tests them, then waits: only a person can approve one, from the web, against the exact revision that passed.'],
  ['One identity, short-lived credentials.', 'Eagle issues two-minute, audience-bound credentials to EagleSRE, and every change is checked against your current permissions in Eagle.'],
];

const inside = [
  ['Workloads', 'Every running service in one list, with the node it runs on, its CPU and memory, requests per second, errors and p95.', 'req/s · errors · p95'],
  ['Infrastructure', 'Hosts, Docker Swarm and Kubernetes. A host opens on CPU, memory, filesystems with a fill forecast, disk and network, and says "not measured" instead of drawing a zero.', 'hosts · swarm · kubernetes'],
  ['Service Map', 'Who calls whom, drawn from traces. Every service shows its call rate and error rate; colour the map by errors or by latency, or read it as a list.', 'graph · list'],
  ['APIs', 'Each service by endpoint: latency percentiles, errors by span name and spans by status.', 'per endpoint'],
  ['Logs', 'Search, presets and saved queries over a volume histogram, with counted facets and a patterns view.', 'LogQL'],
  ['Traces', 'Spans or whole traces, golden signals over whatever the search matched, and a waterfall for each trace.', 'TraceQL'],
  ['AI Observability', 'GenAI spans: tokens, cost, tool calls and models, with latency and errors beside them, as an installable dashboard preset.', 'GenAI spans'],
  ['Monitors', 'Conditions with a severity. Each shows when it was last evaluated; open issues show when they last changed.', 'conditions · issues'],
  ['Metrics and dashboards', 'Metrics in PromQL or the search syntax. Dashboards per tenant, with panel tabs and presets you can install and then edit.', 'PromQL'],
];

const builtIn = [
  'One identity across several tenants: OIDC or Active Directory / LDAP sign-in, groups, roles and an audit log.',
  'Every query bound to the tenant that made it, and API keys per tenant.',
  'Every page works from a 320-pixel phone to a wall display, with a mouse or a finger. A test sweeps each route across that range.',
  'Details open in drawers that live in the URL, so the link you paste opens what you were looking at.',
  'Light and dark themes. The dark one is the default.',
  'One telemetry store behind it, GreptimeDB or ClickHouse, read through Piper.',
];

// No winners marked: the table says how each console works, not which is best.
const compareColumns = ['Eagle', 'Grafana', 'Datadog', 'groundcover', 'SigNoz'];
const compareRows = [
  {
    label: 'Where it runs',
    win: [],
    cells: [
      'Your servers or Obstack Cloud. Runs air-gapped, assistant included.',
      'Self-managed, or Grafana Cloud.',
      "Datadog's cloud.",
      'Bring your own cloud: the data plane sits in your cloud account.',
      'Self-hosted open source, or SigNoz Cloud.',
    ],
  },
  {
    label: 'What you type',
    win: [],
    cells: [
      'One search syntax, compiled to PromQL, LogQL or TraceQL and shown under the bar. Native queries any time.',
      "Each data source's own language, with query builders.",
      "Datadog's own search and query syntax.",
      'gcQL for logs, traces and events; PromQL for metrics.',
      'A query builder, ClickHouse SQL, and PromQL for metrics.',
    ],
  },
  {
    label: 'Where you start',
    win: [],
    cells: [
      'Sections in investigation order, from workloads to dashboards. Details open in drawers that live in the URL.',
      'Dashboards, and Explore for ad-hoc queries.',
      'A product area per signal: APM, Logs, Infrastructure and more.',
      'Kubernetes workloads and the signals around them.',
      'Services, traces, logs and dashboards.',
    ],
  },
  {
    label: 'The assistant',
    win: [],
    cells: [
      'Ask Eagle, with every query it ran listed. Any OpenAI-compatible model, including one you host.',
      'Grafana Assistant. Self-managed installs connect a Grafana Cloud stack; in public preview there.',
      "Bits AI, in Datadog's cloud.",
      'Agent Mode, running in your cloud.',
      'Noz, on SigNoz Cloud.',
    ],
  },
];

const split = [
  ['Next to Grafana', 'Grafana stays.', 'In every plan, with unlimited users and the Grafana MCP server for agents. Both read the same store, so choosing one costs nothing in the other.'],
  ['A second way in', 'Eagle follows the incident.', 'Keep the dashboards you have. Open Eagle when you want to go from a service to its log line, ask a question of the data, or run code against it.'],
];

// How the pieces fit. Coordinates in the SVG's own 1200 × 544 units.
type Node = { x: number; y: number; w: number; h: number; lines: [string, boolean][]; kind?: 'eagle' | 'store' | 'sre' | 'ext' };
const nodes: Node[] = [
  { x: 40, y: 72, w: 200, h: 88, lines: [['Browser', true], ['desktop, tablet, phone', false]] },
  { x: 336, y: 48, w: 232, h: 136, kind: 'eagle', lines: [['Eagle', true], ['console · Ask Eagle', false], ['identity · functions control', false]] },
  { x: 664, y: 72, w: 200, h: 88, lines: [['Piper', true], ['PromQL · LogQL · TraceQL', false]] },
  { x: 960, y: 72, w: 200, h: 88, kind: 'store', lines: [['GreptimeDB', true], ['or ClickHouse', true], ['one telemetry store', false]] },
  { x: 664, y: 232, w: 200, h: 88, kind: 'ext', lines: [['Your LLM endpoint', true], ['OpenAI-compatible', false]] },
  { x: 960, y: 232, w: 200, h: 88, lines: [['Vector · OpenTelemetry', true], ['ingest and trigger tee', false]] },
  { x: 40, y: 392, w: 200, h: 88, lines: [['Slack · Teams', true], ['the EagleSRE bot', false]] },
  { x: 336, y: 368, w: 232, h: 136, kind: 'sre', lines: [['EagleSRE', true], ['preview', false], ['incidents · on-call', false], ['investigation agent', false]] },
  { x: 664, y: 392, w: 200, h: 88, lines: [['Edge Runtime', true], ['one worker per run', false]] },
  { x: 960, y: 392, w: 200, h: 88, lines: [['Vault · Git · S3', true], ['secrets, source, artifacts', false]] },
];
const edges: { d: string; accent?: boolean }[] = [
  { d: 'M240 116H335' },
  { d: 'M568 100H663' },
  { d: 'M664 132H569', accent: true },
  { d: 'M864 116H959' },
  { d: 'M568 172H616V276H663' },
  { d: 'M452 184V367', accent: true },
  { d: 'M240 436H335' },
  { d: 'M568 436H663' },
  { d: 'M864 436H959' },
  { d: 'M1060 232V161' },
];
const edgeLabels: { x: number; y: number; t: string; accent?: boolean; start?: boolean }[] = [
  { x: 616, y: 88, t: 'queries' },
  { x: 616, y: 156, t: 'introspect', accent: true },
  { x: 568, y: 222, t: 'Ask Eagle' },
  { x: 408, y: 279, t: 'identity', accent: true },
  { x: 616, y: 420, t: 'agent runs' },
  { x: 1072, y: 200, t: 'OTLP in', start: true },
];
/** Baseline of line i of n, centred on the box, 20 units a line. */
const lineY = (n: Node, i: number) => n.y + n.h / 2 + (i - (n.lines.length - 1) / 2) * 20 + 5;
---

<Layout
  title="Obstack Eagle · the observability console for the Obstack Stack"
  description="Obstack Eagle is the observability console in the Obstack Stack: workloads, infrastructure, service map, logs, traces and AI spans in PromQL, LogQL and TraceQL, with Ask Eagle, Serverless functions on an edge runtime, and EagleSRE for incidents."
  active="eagle"
  image="/og-eagle.png"
  schema={[
    softwareSchema({
      path: '/eagle',
      name: 'Obstack Eagle',
      description:
        "Obstack Eagle is the observability console for the Obstack Stack: workloads, hosts, Docker Swarm and Kubernetes, a service map, APIs, logs, traces, AI observability, monitors, metrics and dashboards. It queries the store natively in PromQL, LogQL and TraceQL and compiles a single search syntax to all three. Ask Eagle answers by querying the tenant's telemetry; Serverless functions run TypeScript on an edge runtime; EagleSRE, in preview, adds incident response.",
    }),
    breadcrumbSchema('/eagle', 'Eagle'),
  ]}
>
  <section class="hero">
    <div class="wrap hero-grid eagle-hero">
      <div class="stack" style="gap: 26px">
        <div class="brand-row rise">
          <EagleMark size={34} />
          <span class="eyebrow">Obstack Eagle</span>
          <span class="badge badge-mint now"><span class="dot" aria-hidden="true"></span>Available now</span>
        </div>
        <h1 class="display rise">An observability console that speaks PromQL, LogQL and TraceQL — and answers back.</h1>
        <p class="lead rise-2">Eagle is the Obstack Stack's own console, and it is running today. Workloads, infrastructure, the service map, logs, traces and AI spans, read straight from the store in its own query languages. Ask Eagle answers from that same telemetry, TypeScript functions run beside it on an edge runtime, and EagleSRE brings incidents into the same place.</p>
        <div class="btn-row rise-2" style="padding-top: 6px">
          <a class="btn btn-primary" href={url('/pricing#demo')}>Start the {DEMO.days}-day evaluation <Arrow /></a>
          <a class="btn btn-ghost" href="#tour">Tour the console</a>
        </div>
        <div class="hero-meta mono rise-2">
          <span>Self-hosted or Obstack Cloud</span>
          <span>Air-gap ready</span>
          <span>GreptimeDB or ClickHouse</span>
        </div>
      </div>

      <div class="hero-shot rise-3">
        <figure class="shot">
          <img src={url('/images/eagle_map.webp')} alt="Eagle's Service Map: services and their dependencies with call and error rates; checkout and payment are flagged for errors" width="2000" height="1250" fetchpriority="high" />
        </figure>
        <div class="ask-card" aria-hidden="true">
          <div class="ask-head">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7FB4FA" stroke-width="2"><path d={icons.spark[0]}></path></svg>
            Ask Eagle<span class="kbd mono">⌘J</span>
          </div>
          <p>“Why did errors go up in the last hour?”</p>
          <div class="ask-ran mono">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#63E8B0" stroke-width="2.5"><path d="M5 12l5 5 9-10"></path></svg>
            Ran 4 queries · map, traces, logs
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="facts-band">
    <div class="wrap">
      <div class="grid-4 rule-top facts">
        {facts.map(([n, d]) => (
          <div class="stack">
            <span class="fact-n">{n}</span>
            <span class="body-2">{d}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="tour">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">01 / How it is laid out</div>
          <h2 class="h2">In the order an investigation runs.</h2>
        </div>
        <p class="body-2">Eagle's sections follow the questions you ask during an incident, not the teams that own the data. A service keeps the same name on the map, in its logs and in its traces, so moving between them keeps your place.</p>
      </div>

      <ol class="steps" aria-label="Investigation order">
        {sequence.map(([t, d], i) => (
          <li>
            <span class="num mono" aria-hidden="true">{i + 1}</span>
            <span class="mono step-t">{t}</span>
            <span class="body-2">{d}</span>
          </li>
        ))}
      </ol>

      <div class="tour" data-tour>
        <div class="tabs" role="tablist" aria-label="Eagle sections">
          {tour.map((t, i) => (
            <button type="button" role="tab" class="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.label}</button>
          ))}
        </div>
        {tour.map((t, i) => (
          <div class="tour-panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} tabindex="0">
            <figure class="shot light-shot">
              <img src={url(`/images/${t.img}.webp`)} alt={t.alt} width="2000" height="1250" loading={i === 0 ? 'eager' : 'lazy'} />
            </figure>
            <div class="tour-cap">
              <h3 class="h3">{t.title}</h3>
              <p class="body-2">{t.text}</p>
            </div>
          </div>
        ))}
      </div>
      <script is:inline>
        (() => {
          const root = document.querySelector('[data-tour]');
          if (!root) return;
          const tabs = [...root.querySelectorAll('[role="tab"]')];
          const show = (tab, focus) => {
            for (const t of tabs) {
              const on = t === tab;
              t.setAttribute('aria-selected', String(on));
              t.tabIndex = on ? 0 : -1;
              document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
            }
            if (focus) tab.focus();
          };
          tabs.forEach((t, i) => {
            t.addEventListener('click', () => show(t, false));
            t.addEventListener('keydown', (e) => {
              const to = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
              if (to === undefined) return;
              e.preventDefault();
              show(tabs[(to + tabs.length) % tabs.length], true);
            });
          });
          // Without script every panel stays visible, one under the other.
          show(tabs[0], false);
        })();
      </script>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">02 / One search, three languages</div>
          <h2 class="h2">Type the search. Read the query it runs.</h2>
        </div>
        <p class="body-2">Eagle compiles one search syntax to LogQL, TraceQL or PromQL and prints the result under the bar. Switch to the native query whenever you want, and back. Structured fields such as <code>level</code> become pipeline filters, not stream selectors, so a search never quietly matches nothing.</p>
      </div>
      <div class="search-grid">
        <div class="compile">
          {compiled.map(([signal, lang, typed, native]) => (
            <div class="row">
              <div class="row-head"><span class="mono sig">{signal}</span><span class="mono lang">runs as {lang}</span></div>
              <div class="typed mono">{typed}</div>
              <pre class="code native">{native}</pre>
            </div>
          ))}
        </div>
        <figure class="shot light-shot cap-shot">
          <img src={url('/images/eagle_search.webp')} alt="Eagle's Logs page filtered by status:error: the search bar, the LogQL it runs, presets, a volume histogram and the error facet" width="2000" height="1250" loading="lazy" />
          <figcaption class="mono">“Runs as LogQL” sits under the bar on every search, with a copy button.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="dark">
    <div class="wrap section">
      <div class="section-head">
        <div class="stack">
          <div class="eyebrow">03 / AI, built in</div>
          <h2 class="h2">An assistant that answers from your telemetry, with its working shown.</h2>
        </div>
        <p class="body-2">Ask Eagle sits in the rail on every page, and <span class="mono" style="color: var(--on-dark)">⌘J</span> opens it anywhere. It knows the section you are on, the query in the bar and the time range, and it answers by running the queries the pages run.</p>
      </div>

      <div class="ai-grid">
        <figure class="shot cap-shot">
          <img src={url('/images/eagle_companion.webp')} alt="Ask Eagle docked beside the Logs page: it ran four queries, explains that order-service errors point at its database calls, and offers the queries as Run in Logs and Run in Traces buttons" width="2000" height="1250" loading="lazy" />
          <figcaption class="mono">The queries it ran come first, each with what came back and an Open link. A refused query is shown as refused.</figcaption>
        </figure>
        <ol class="vsteps" aria-label="How Ask Eagle answers">
          {answer.map(([t, d], i) => (
            <li>
              <span class="num mono" aria-hidden="true">{i + 1}</span>
              <span class="vs-t">{t}</span>
              {d && <span class="body-2">{d}</span>}
              {i === 1 && (
                <span class="tools">{tools.map((t) => <span class="mono">{t}</span>)}</span>
              )}
            </li>
          ))}
        </ol>
      </div>

      <div class="gossip four-up">
        {aiPlaces.map(([icon, t, d]) => (
          <div>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#7FB4FA" stroke-width="1.8" aria-hidden="true">{icons[icon].map((p) => <path d={p}></path>)}</svg>
            <h3 class="h3" style="font-size: 18px">{t}</h3>
            <p class="body-2" style="font-size: 15px">{d}</p>
