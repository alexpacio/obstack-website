          <pre class="code"><span class="k">import</span> {'{'} defineScript {'}'} <span class="k">from</span> <span class="s">"@eagle/sdk"</span>;

<span class="k">export default</span> defineScript&lt;{'{'} url: string; expected_status: number; timeout_ms: number {'}'}&gt;(
  <span class="k">async</span> (ctx, input) =&gt; {'{'}
    <span class="k">const</span> started = performance.now();
    <span class="k">const</span> url = <span class="k">new</span> URL(input.url);
    <span class="k">const</span> response = <span class="k">await</span> fetch(url, {'{'} redirect: <span class="s">"manual"</span>, signal: AbortSignal.timeout(input.timeout_ms) {'}'});
    <span class="k">await</span> response.body?.cancel();
    <span class="k">const</span> ok = response.status === input.expected_status;
    ctx.metrics.gauge(<span class="s">"http_check_latency_ms"</span>, performance.now() - started, {'{'} target: url.origin {'}'});
    ctx.metrics.gauge(<span class="s">"http_check_success"</span>, Number(ok), {'{'} target: url.origin {'}'});
    <span class="k">if</span> (ok) <span class="k">await</span> ctx.resolve(url.origin);
    <span class="k">else await</span> ctx.alert({'{'} key: url.origin, severity: <span class="s">"S2"</span>, title: <span class="s">`HTTP check answered ${'{'}response.status{'}'}`</span> {'}'});
    <span class="k">return</span> {'{'} ok, status: response.status {'}'};
  {'}'});</pre>
