---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import EagleMark from '../components/EagleMark.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import { DEMO } from '../data/plans';
import { AI_BILLING } from '../data/product-pricing';
import { breadcrumbSchema, softwareSchema } from '../lib/seo';
import { url } from '../lib/url';

const roles = [
  ['Eagle', 'Your team explores workloads, infrastructure, logs, traces and metrics in the console.', '/eagle'],
  ['EagleSRE', 'Responders coordinate incidents, on-call and investigations alongside Eagle. Currently in preview.', '/eaglesre'],
  ['EagleMCP', 'MCP-compatible assistants connect to the Obstack Stack through its tool interface.', '/eaglemcp'],
];
---

<Layout
  title="Obstack EagleMCP · connect assistants to your observability stack"
  description="EagleMCP provides MCP access for assistants working with the Obstack Stack. Included in every stack plan, without a connector or per-tool-call fee."
  active="eaglemcp"
  image="/og-eagle.png"
  schema={[
    breadcrumbSchema('/eaglemcp', 'EagleMCP'),
    softwareSchema({ path: '/eaglemcp', name: 'Obstack EagleMCP', description: 'MCP access for assistants working with the Obstack Stack. Included in every stack subscription; external provider charges are separate.' }),
  ]}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="stack" style="gap: 26px">
        <div class="brand-row"><EagleMark size={32} /><span class="eyebrow">Obstack EagleMCP</span></div>
        <h1 class="display rise">Bring your observability stack into the conversation.</h1>
        <p class="lead rise-2">Connect your MCP-compatible assistants to Obstack. EagleMCP is the assistant access product alongside Eagle's console and EagleSRE's incident workflow.</p>
        <div class="btn-row rise-2">
          <ObfuscatedEmail class="btn btn-primary" subject="EagleMCP evaluation" label="Discuss your integration" />
          <a class="btn btn-ghost" href="#pricing">See what's included <Arrow /></a>
        </div>
      </div>
      <div class="connection rise-3" role="img" aria-label="An MCP-compatible assistant connects through EagleMCP to the Obstack Stack">
        <div class="connection-node"><span class="mono">Your assistant</span><strong>MCP-compatible client</strong></div>
        <span class="connection-arrow" aria-hidden="true">↕</span>
        <div class="connection-node accent"><EagleMark size={32} /><strong>EagleMCP</strong><span>MCP access to the stack</span></div>
        <span class="connection-arrow" aria-hidden="true">↕</span>
        <div class="connection-node"><span class="mono">Obstack</span><strong>Your observability environment</strong></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="stack"><div class="eyebrow">The Eagle family</div><h2 class="h2">A console, an incident workflow and assistant access.</h2></div>
        <p class="body-2">Choose the interface that fits the task. During deployment we agree your assistant integration, access scope and model endpoint.</p>
      </div>
      <div class="tile-grid grid-3">
        {roles.map(([name, description, path]) => <div><h3 class="h3">{name}</h3><p class="body-2">{description}</p><a class="text-link" href={url(path)}>Explore {name} <Arrow size={16} /></a></div>)}
      </div>
    </div>
  </section>

  <section class="section-tight" id="pricing">
    <div class="wrap panel pricing-panel">
      <div class="stack" style="gap: 18px">
        <div class="eyebrow">Included in every plan</div>
        <h2 class="h2">No separate connector licence. No per-tool-call charge.</h2>
        <p class="body-2">EagleMCP is included with Starter, Go, Pro and Max. The stack subscription covers Obstack software, the selected backend and its support tier. Custom integration work is quoted before it starts.</p>
        <p class="small">{AI_BILLING}</p>
      </div>
      <div class="btn-row"><a class="btn btn-dark" href={url('/pricing#products')}>Compare the plans <Arrow /></a><a class="text-link" href={url('/download')}>Start a {DEMO.days}-day evaluation</a></div>
    </div>
  </section>

  <section class="dark">
    <div class="wrap cta-band">
      <div class="stack" style="gap: 18px"><h2 class="h2">Tell us which assistant you want to connect.</h2><p class="body-2">We will scope the integration around your telemetry and the access your team needs.</p></div>
      <ObfuscatedEmail class="btn btn-primary" subject="EagleMCP integration" label="Talk about EagleMCP" />
    </div>
  </section>
</Layout>

<style>
  .brand-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .connection { display: flex; flex-direction: column; align-items: center; padding: 28px; border: 1px solid var(--on-dark-line); border-radius: 16px; background: var(--night); }
  .connection-node { width: 100%; display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 22px; border: 1px solid var(--on-dark-line); border-radius: 10px; text-align: center; color: var(--on-dark); }
  .connection-node strong { font-size: 22px; color: var(--on-dark-strong); }
  .connection-node.accent { border-color: var(--mint); }
  .connection-arrow { padding: 8px; font-size: 24px; color: var(--mint); }
  .pricing-panel { display: flex; flex-direction: column; gap: 28px; padding: 32px; }
  @media (max-width: 1100px) { .hero-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 800px) { .pricing-panel, .connection { padding: 24px; } }
</style>
