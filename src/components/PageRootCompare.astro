---
import { PAGEROOT, formatPrice } from '../data/plans';
import CompareTable from './CompareTable.astro';

const sh = formatPrice(PAGEROOT.selfHosted, 'usd');
const cloud = formatPrice(PAGEROOT.cloud, 'usd');

const columns = ['Obstack PageRoot', 'PagerDuty Professional', 'Rootly On-Call + IR', 'incident.io Team + on-call'];

const rows = [
  {
    label: 'List price, annual billing',
    win: [0],
    cells: [
      `${sh} self-hosted / ${cloud} cloud, per user / month`,
      '$21 per user / month',
      '$20 On-Call + $20 Incident Response = $40 per user / month',
      '$15 Team + $10 on-call = $25 per user / month',
    ],
  },
  {
    label: 'What the seat buys',
    win: [0],
    cells: [
      'On-call, escalations, ChatOps and a built-in MCP server, one SKU',
      'On-call, escalations, ChatOps, status page (250 subscribers)',
      'On-call and Slack-native incident command, as two products',
      'Incident command in Slack/Teams, plus a paid on-call add-on',
    ],
  },
  {
    label: 'Self-hosted',
    win: [0],
    cells: [
      'Yes, on Obstack Stack; or we run it on Obstack Cloud. Air-gapped delivery is Enterprise, quoted',
      'No, SaaS only',
      'No, SaaS only',
      'No, SaaS only',
    ],
  },
  {
    label: 'On-call schedules',
    win: [2],
    cells: [
      'Web rotations, iCal import, Terraform, shift swaps',
      'Yes, more schedules than Free',
      'Yes, plus shadow rotations, PTO calendars and a pay calculator',
      'Yes, on the on-call add-on',
    ],
  },
  {
    label: 'Escalation chains',
    win: [0, 1, 2, 3],
    cells: [
      'Wait, notify on-call, round-robin, time windows, thresholds, webhooks, repeat',
      'Yes, more policies than Free',
      'Yes',
      'Yes',
    ],
  },
  {
    label: 'Alert grouping',
    win: [2],
    cells: [
      'Grouping id and routes from the payload, next to Prometheus Alertmanager',
      'Dedup and basic grouping; ML grouping is AIOps, extra',
      'Alert grouping and noise reduction included on On-Call',
      'On the incident product',
    ],
  },
  {
    label: 'ChatOps',
    win: [2, 3],
    cells: [
      'Slack, Microsoft Teams, Telegram, outgoing webhooks',
      'Basic Slack and Teams on Professional',
      'Slack-first; Teams on Incident Response',
      'Slack and Teams native',
    ],
  },
  {
    label: 'Built-in MCP server',
    win: [0],
    cells: [
      'Yes, in-process, on your network',
      'No',
      'MCP on AI SRE, a separate product, quoted',
      'No public MCP for on-call',
    ],
  },
  {
    label: 'Phone, SMS, push',
    win: [1, 2],
    cells: [
      'SMS and phone calls via Twilio (your account). ChatOps, email and webhooks included',
      'Unlimited SMS and phone on paid plans, plus push',
      'SMS, voice, push, bypass DND',
      'Mobile and ChatOps; phone varies by plan',
    ],
  },
  {
    label: 'Live call routing',
    win: [2],
    cells: [
      'No',
      'Add-on',
      'Included on On-Call, one number on Essentials',
      'Not a headline feature',
    ],
  },
  {
    label: 'Public status page',
    win: [2, 3],
    cells: [
      'No',
      'Up to 250 subscribers on Professional',
      'Included on Incident Response (1 external)',
      'Included',
    ],
  },
  {
    label: 'Slack-native incident command',
    win: [2, 3],
    cells: [
      'Publishes alert groups; not a full incident room product',
      'Basic chat experience on Professional',
      'Yes: roles, timelines, @Rootly',
      'Yes: @incident, roles, timelines',
    ],
  },
  {
    label: 'AI / AIOps',
    win: [3],
    cells: [
      'MCP for agents you run, including Aurora AI',
      'PagerDuty Advance and AIOps are extra',
      'AI SRE is a third product, quoted',
      'AI included on Team and Pro',
    ],
  },
  {
    label: 'Cost during an incident',
    win: [0],
    cells: [
      'Unchanged: seats and nodes, no event meter',
      'Seats unchanged; AIOps is per accepted event if you buy it',
      'Seats unchanged',
      'Seats unchanged',
    ],
  },
];
---

<CompareTable columns={columns} ours={0} rows={rows} />
