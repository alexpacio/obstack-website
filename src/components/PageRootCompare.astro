      'Unchanged: seats and nodes, no event meter',
      'Seats unchanged; AIOps is per accepted event if you buy it',
      'Seats unchanged',
      'Seats unchanged',
    ],
  },
];
---

<CompareTable columns={columns} ours={0} rows={rows} />
