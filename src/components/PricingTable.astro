---
import { AURORA, PAGEROOT, PLANS, STORAGE, TERM_DISCOUNT, VOLUME_TIERS, dualPrice, pct, type Deployment } from '../data/plans';
import { url } from '../lib/url';
import ObfuscatedEmail from './ObfuscatedEmail.astro';
import Price from './Price.astro';

interface Props {
  /** `bee` features Bee and links straight to checkout; `all` adds Enterprise and links each plan to the configurator. */
  variant?: 'bee' | 'all';
}

const { variant = 'all' } = Astro.props;
const featured = variant === 'bee' ? 'bee' : 'cloud';
const kind: Record<Deployment, string> = { 'self-hosted': 'Self-hosted', cloud: 'Managed cloud' };
const storageLine = {
  none: 'Agent only · nothing to store',
  optional: `Storage: your own, or ${dualPrice(STORAGE.pricePerGb)} / GB / month`,
  required: `+ storage at ${dualPrice(STORAGE.pricePerGb)} / GB / month`,
};
/** The strip reads as a discount board: the figure first, what earns it underneath. */
const discounts = [
  ...VOLUME_TIERS.filter((t) => t.off > 0).map((t) => ({
    value: `${pct(t.off)} off`,
    label: Number.isFinite(t.to) ? `${t.from}–${t.to} nodes` : `${t.from} nodes and up`,
  })),
  { value: `${pct(TERM_DISCOUNT[12])} off`, label: 'Yearly billing' },
  { value: `${pct(TERM_DISCOUNT[36])} off`, label: '3-year term, price locked' },
];
---

<div class:list={['plans', `plans-${variant}`]}>
  {PLANS.map((p) => (
    <article class:list={['plan', { featured: p.id === featured }]}>
      <div class="top">
        <span class="kind mono">{kind[p.deployment]}</span>
        {p.id === featured && <span class="badge badge-mint">{variant === 'bee' ? 'Start here' : 'Recommended'}</span>}
      </div>
      <h3 class="h3">{p.name}</h3>
      <div class="price"><span class="amount"><Price eur={p.price} /></span><span class="per mono">/ node / month</span></div>
      <p class="addon mono" set:html={storageLine[p.storage]} />
      <p class="small">{p.blurb}</p>
      <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
      <a
        class:list={['btn', p.id === featured ? 'btn-dark' : 'btn-outline']}
        href={variant === 'bee' ? url(`/buy?plan=${p.id}`) : url(`/pricing?plan=${p.id}#configure`)}
      >
        {variant === 'bee' ? `Buy ${p.short}` : `Configure ${p.short}`}
      </a>
    </article>
  ))}

  {variant === 'all' && (
    <article class="plan">
      <div class="top"><span class="kind mono">Either deployment</span></div>
      <h3 class="h3">Enterprise</h3>
      <div class="price"><span class="amount">Custom</span></div>
      <p class="addon mono">Annual or multi-year agreement</p>
      <p class="small">For regulated, air-gapped and very large estates.</p>
      <ul>
        <li>Air-gapped delivery and offline updates</li>
        <li>24/7 support with a named engineer</li>
        <li>Security review pack, DPA and procurement paperwork</li>
      </ul>
      <ObfuscatedEmail class="btn btn-outline" label="Talk to us" subject="Obstack Enterprise" />
    </article>
  )}
</div>

{variant === 'all' && (
  <aside class="module">
    <div class="stack" style="gap: 10px">
      <div class="kind mono">Optional module · Stack and Cloud</div>
      <h3 class="h3">PageRoot</h3>
      <p class="small">On-call, escalations, ChatOps and a built-in MCP server. Add it when you configure Stack or Cloud. Not available with Bee alone.</p>
    </div>
    <div class="module-prices">
      <div>
        <span class="mono">Self-hosted</span>
        <strong><Price eur={PAGEROOT.selfHosted} /></strong>
        <span class="mono">/ user / month</span>
      </div>
      <div>
        <span class="mono">Obstack Cloud</span>
        <strong><Price eur={PAGEROOT.cloud} /></strong>
        <span class="mono">/ user / month</span>
      </div>
    </div>
    <a class="btn btn-outline" href={url('/pageroot')}>Compare with PagerDuty and Rootly</a>
  </aside>
  <aside class="module">
    <div class="stack" style="gap: 10px">
      <div class="kind mono">Optional bundle · Stack and Cloud</div>
      <h3 class="h3">Aurora AI</h3>
      <p class="small">The AI SRE, bundled with unlimited {AURORA.model} hosted by Obstack. No per-token meter. Add it when you configure Stack or Cloud. Not available with Bee alone.</p>
    </div>
    <div class="module-prices">
      <div>
        <span class="mono">Self-hosted or Cloud</span>
        <strong><Price eur={AURORA.price} /></strong>
        <span class="mono">/ month</span>
      </div>
    </div>
    <a class="btn btn-outline" href={url('/aurora')}>How Aurora works</a>
  </aside>
)}

<div class="strip">
  <div class="strip-head">
    <span class="strip-title mono">Discounts, applied automatically</span>
    <span class="strip-note mono">No meters on ingest, egress or queries</span>
  </div>
  <div class="strip-body">
    <div class="discounts">
      {discounts.map((d) => (
        <div class="discount">
          <span class="d-value">{d.value}</span>
          <span class="d-label mono">{d.label}</span>
        </div>
      ))}
    </div>
    {variant === 'bee'
      ? <a class="btn btn-primary" href={url('/pricing#configure')}>Configure a quote</a>
      : <a class="btn btn-primary" href="#configure">Configure a quote</a>}
  </div>
</div>

<style>
  .plans { display: grid; gap: 24px; align-items: stretch; }
  .plans-all { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .plans-bee { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .plan { background: var(--white); border: 1px solid var(--line); padding: 32px; display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .plan.featured { border: 2px solid var(--ink); padding: 31px; box-shadow: 10px 10px 0 var(--mint); }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 22px; }
  .kind { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--link); font-weight: 700; }
  .price { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; margin-top: -6px; }
  .amount { font-size: 50px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.05; }
  .per { font-size: 13px; color: var(--text-2); }
  .addon { font-size: 12px; color: var(--text-2); margin-top: -8px; }
  ul { list-style: none; margin: 0; padding: 20px 0 0; border-top: 1px solid var(--line-soft); display: flex; flex-direction: column; gap: 10px; font-size: 14px; line-height: 1.5; }
  li { display: flex; gap: 10px; }
  li::before { content: ""; width: 8px; height: 8px; background: var(--teal); margin-top: 7px; flex-shrink: 0; }
  .plan :global(.btn) { margin-top: auto; }

  /* Fixed price and button tracks so every module card lines up, whatever its labels say. */
  .module { margin-top: 24px; background: var(--white); border: 1px solid var(--line); border-top: 4px solid var(--ink); padding: 28px 32px; display: grid; grid-template-columns: minmax(0, 1fr) 300px 340px; gap: 32px; align-items: center; }
  .module-prices { display: flex; gap: 32px; }
  .module-prices div { display: flex; flex-direction: column; gap: 4px; }
  .module-prices strong { font-size: 28px; font-weight: 800; letter-spacing: -0.02em; }
  .module :global(.btn) { justify-self: end; }

  .strip { margin-top: 24px; background: var(--night); color: var(--on-dark); padding: 26px 32px 28px; display: flex; flex-direction: column; gap: 22px; }
  .strip-head { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; flex-wrap: wrap; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; padding-bottom: 18px; border-bottom: 1px solid rgba(232, 241, 242, 0.16); }
  .strip-title { color: var(--mint); font-weight: 700; }
  .strip-note { color: var(--on-dark-2); }
  .strip-body { display: flex; justify-content: space-between; align-items: center; gap: 32px; flex-wrap: wrap; }
  .discounts { display: flex; flex-wrap: wrap; }
  .discount { display: flex; flex-direction: column; gap: 6px; padding: 2px 28px; border-left: 1px solid rgba(232, 241, 242, 0.16); }
  .discount:first-child { padding-left: 0; border-left: 0; }
  .d-value { font-size: 24px; font-weight: 800; letter-spacing: -0.01em; line-height: 1; color: var(--on-dark-strong); }
  .d-label { font-size: 12px; color: var(--on-dark-2); }

  @media (max-width: 1300px) {
    .plans-all { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 1100px) {
    .plans-bee { grid-template-columns: minmax(0, 1fr); max-width: 560px; }
    .plan.featured { box-shadow: 6px 6px 0 var(--mint); }
    .module { grid-template-columns: minmax(0, 1fr); }
    .module :global(.btn) { justify-self: start; }
  }
  @media (max-width: 800px) {
    .plans-all { grid-template-columns: minmax(0, 1fr); }
    .strip { padding: 24px; }
    .strip-body { align-items: flex-start; }
    .discounts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 0; width: 100%; }
    .discount { padding: 2px 20px; }
    .discount:nth-child(odd) { padding-left: 0; border-left: 0; }
    .strip :global(.btn) { width: 100%; }
    .module { grid-template-columns: minmax(0, 1fr); padding: 24px; gap: 20px; }
    .module :global(.btn) { justify-self: start; }
    .plan { padding: 24px; }
    .plan.featured { padding: 23px; }
  }
</style>
