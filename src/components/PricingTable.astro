---
import { PLANS, STORAGE, TERM_DISCOUNT, formatPrice, pct, volumeBands, type Deployment } from '../data/plans';
import { url } from '../lib/url';
import ObfuscatedEmail from './ObfuscatedEmail.astro';

interface Props {
  /** `bee` features Bee and links straight to checkout; `all` adds Enterprise and links each plan to the configurator. */
  variant?: 'bee' | 'all';
}

const { variant = 'all' } = Astro.props;
const featured = variant === 'bee' ? 'bee' : 'cloud';
const kind: Record<Deployment, string> = { 'self-hosted': 'Self-hosted', cloud: 'Managed cloud' };
const storageLine = {
  none: 'Agent only · nothing to store',
  optional: `Storage: your own, or ${formatPrice(STORAGE.pricePerGb, 'usd')} / GB / month`,
  required: `+ storage at ${formatPrice(STORAGE.pricePerGb, 'usd')} / GB / month`,
};
const perks = [
  ...volumeBands().map((b) => `Nodes ${b}`),
  `3-year term: ${pct(TERM_DISCOUNT[36])} off, price locked`,
  'No meters on ingest, egress, queries or users',
];
---

<div class:list={['plans', `plans-${variant}`]}>
  {PLANS.map((p) => (
    <article class:list={['plan', { featured: p.id === featured }]}>
      <div class="top">
        <span class="kind mono">{kind[p.deployment]}</span>
        {p.id === featured && <span class="badge badge-mint">{variant === 'bee' ? 'Start here' : 'Recommended'}</span>}
      </div>
      <h3 class="h3">{p.name}</h3>
      <div class="price"><span class="amount">{formatPrice(p.price, 'usd')}</span><span class="per mono">/ node / month</span></div>
      <p class="addon mono">{storageLine[p.storage]}</p>
      <p class="small">{p.blurb}</p>
      <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
      <a
        class:list={['btn', p.id === featured ? 'btn-dark' : 'btn-outline']}
        href={variant === 'bee' ? url(`/buy?plan=${p.id}`) : url(`/pricing?plan=${p.id}#configure`)}
      >
        {variant === 'bee' ? `Buy ${p.short}` : `Configure ${p.short}`}
      </a>
    </article>
  ))}

  {variant === 'all' && (
    <article class="plan">
      <div class="top"><span class="kind mono">Either deployment</span></div>
      <h3 class="h3">Enterprise</h3>
      <div class="price"><span class="amount">Custom</span></div>
      <p class="addon mono">Annual or multi-year agreement</p>
      <p class="small">For regulated, air-gapped and very large estates.</p>
      <ul>
        <li>Air-gapped delivery and offline updates</li>
        <li>24/7 support with a named engineer</li>
        <li>Security review pack, DPA and procurement paperwork</li>
      </ul>
      <ObfuscatedEmail class="btn btn-outline" label="Talk to us" subject="Obstack Enterprise" />
    </article>
  )}
</div>

<div class="strip">
  <ul class="perks mono">{perks.map((p) => <li>{p}</li>)}</ul>
  {variant === 'bee'
    ? <a class="btn btn-primary" href={url('/pricing#configure')}>Configure a quote</a>
    : <a class="btn btn-primary" href="#configure">Configure a quote</a>}
</div>

<style>
  .plans { display: grid; gap: 24px; align-items: stretch; }
  .plans-all { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .plans-bee { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .plan { background: var(--white); border: 1px solid var(--line); padding: 32px; display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .plan.featured { border: 2px solid var(--ink); padding: 31px; box-shadow: 10px 10px 0 var(--mint); }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 22px; }
  .kind { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--link); font-weight: 700; }
  .price { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; margin-top: -6px; }
  .amount { font-size: 50px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.05; }
  .per { font-size: 13px; color: var(--text-2); }
  .addon { font-size: 12px; color: var(--text-2); margin-top: -8px; }
  ul { list-style: none; margin: 0; padding: 20px 0 0; border-top: 1px solid var(--line-soft); display: flex; flex-direction: column; gap: 10px; font-size: 14px; line-height: 1.5; }
  li { display: flex; gap: 10px; }
  li::before { content: ""; width: 8px; height: 8px; background: var(--teal); margin-top: 7px; flex-shrink: 0; }
  .plan :global(.btn) { margin-top: auto; }

  .strip { margin-top: 24px; display: flex; justify-content: space-between; align-items: center; gap: 32px; background: var(--night); color: var(--on-dark); padding: 24px 32px; }
  .perks { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 32px; font-size: 13px; color: var(--on-dark-2); border: 0; }
  .perks li::before { background: var(--mint); margin-top: 6px; }

  @media (max-width: 1300px) {
    .plans-all { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 1100px) {
    .plans-bee { grid-template-columns: minmax(0, 1fr); max-width: 560px; }
    .plan.featured { box-shadow: 6px 6px 0 var(--mint); }
  }
  @media (max-width: 800px) {
    .plans-all { grid-template-columns: minmax(0, 1fr); }
    .strip { flex-direction: column; align-items: flex-start; padding: 24px; }
    .plan { padding: 24px; }
    .plan.featured { padding: 23px; }
  }
</style>
