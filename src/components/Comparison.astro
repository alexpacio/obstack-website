---
import CompareTable from './CompareTable.astro';

const columns = ['Obstack Bee', 'Grafana Beyla', 'Dynatrace OneAgent', 'Datadog Agent'];

const rows = [
  {
    label: 'What you run',
    win: [0, 1],
    cells: [
      'One Rust binary per node, eBPF embedded',
      'One eBPF agent per node, open source (now OpenTelemetry eBPF Instrumentation)',
      'OneAgent per host, reporting to a Dynatrace cluster',
      'Agent per host, plus configuration per capability',
    ],
  },
  {
    label: 'Application code changes',
    win: [0, 1],
    cells: [
      'None',
      'None',
      'None, but OneAgent is injected into your processes',
      'A tracer library in each service for APM spans',
    ],
  },
  {
    label: 'Where telemetry goes',
    win: [0, 1],
    cells: [
      'Any OpenTelemetry collector that accepts OTLP over HTTP',
      'Your OTLP or Prometheus backend',
      'Dynatrace SaaS or a vendor-run Managed cluster',
      'Datadog SaaS',
    ],
  },
  {
    label: 'Air-gapped operation',
    win: [],
    cells: [
      'Not on list plans; quoted as Enterprise (offline delivery and updates)',
      'Possible; you assemble the stack',
      'Managed option, still vendor-operated',
      'No',
    ],
  },
  {
    label: 'Distributed tracing',
    win: [0],
    cells: [
      'Intra-service, intra-host and cross-host, no coordinator',
      'Propagated context; you assemble the backend',
      'In-process agent plus a Dynatrace cluster',
      'Tracer libraries plus Datadog APM',
    ],
  },
  {
    label: 'Profiling',
    win: [0],
    cells: [
      'Tied to the same request as the trace',
      'Not a first-class profiler',
      'Code-level through the in-process agent',
      'Separate profiler product',
    ],
  },
  {
    label: 'Named Node.js async waits',
    win: [0],
    cells: [
      'Yes, tied to the exact request that caused them',
      'No, generic transactions',
      'Method-level through the in-process agent',
      'Through tracer and profiler integrations',
    ],
  },
  {
    label: 'Full MySQL query text',
    win: [0],
    cells: [
      'Yes, with typed prepared-statement parameters',
      'Generic SQL metadata',
      'Through the in-process agent',
      'Through tracer libraries',
    ],
  },
  {
    label: 'Trace correlation',
    win: [0],
    cells: [
      'Evidence only; refuses to guess',
      'Heuristics plus propagated context',
      'In-process agent context',
      'Tracer-propagated context',
    ],
  },
  {
    label: 'Resource ceilings',
    win: [0],
    cells: [
      'Published for every queue, map and buffer',
      'Partial',
      'Vary by agent configuration',
      'Vary by agent configuration',
    ],
  },
  {
    label: 'Cost during an incident',
    win: [0],
    cells: [
      'Flat per node, unchanged',
      'Free software; backend costs are yours',
      'Consumption units rise with load',
      'Host, span and ingest meters rise with load',
    ],
  },
  {
    label: 'Output format',
    win: [0, 1],
    cells: [
      'OTLP and Prometheus',
      'OTLP and Prometheus',
      'Proprietary ingestion',
      'Proprietary ingestion',
    ],
  },
];
---

<CompareTable columns={columns} ours={0} rows={rows} />
