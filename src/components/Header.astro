---
import Logo from './Logo.astro';
import { url, mailto } from '../lib/url';

interface Props {
  active?: 'bee' | 'stack' | 'pricing' | 'buy';
  /** Minimal header used on checkout. */
  checkout?: boolean;
}

const { active, checkout = false } = Astro.props;

const links = [
  { id: 'bee', label: 'Bee', href: url('/bee') },
  { id: 'stack', label: 'Stack', href: url('/stack') },
  { id: 'pricing', label: 'Pricing', href: url('/pricing') },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a href={url('/')} class="home" aria-label="Obstack home"><Logo /></a>

    {checkout ? (
      <div class="secure">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#63E8B0" stroke-width="2" stroke-linecap="square" aria-hidden="true"><rect x="5" y="11" width="14" height="10"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
        <span>Secure checkout · <a href={mailto()}>info@obstack.it</a></span>
      </div>
    ) : (
      <>
        <nav class="links" aria-label="Main">
          {links.map((l) => (
            <a href={l.href} class:list={['nl', { on: active === l.id }]} aria-current={active === l.id ? 'page' : undefined}>{l.label}</a>
          ))}
          <a class="nl" href={mailto()}>Contact</a>
        </nav>
        <div class="right">
          <a class="btn btn-primary btn-sm" href={url('/pricing#configure')}>Get a quote</a>
          <details class="mnav">
            <summary aria-label="Menu">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
            </summary>
            <nav aria-label="Mobile">
              {links.map((l) => <a href={l.href}>{l.label}</a>)}
              <a href={mailto()}>Contact</a>
            </nav>
          </details>
        </div>
      </>
    )}
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(3, 6, 7, 0.96);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--on-dark-line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 76px; gap: 24px; }
  .home { text-decoration: none; }
  .links { display: flex; gap: 36px; align-items: center; }
  .nl { color: #B9CCD3; text-decoration: none; font-size: 14px; font-weight: 500; padding: 6px 0; border-bottom: 2px solid transparent; }
  .nl:hover { color: #fff; }
  .nl.on { color: #fff; font-weight: 700; border-bottom-color: var(--mint); }
  .right { display: flex; align-items: center; gap: 12px; }
  .secure { display: flex; align-items: center; gap: 10px; color: var(--on-dark-2); font-size: 14px; }
  .secure a { color: var(--on-dark); }

  .mnav { display: none; position: relative; }
  .mnav summary { list-style: none; cursor: pointer; color: var(--on-dark); width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(232, 241, 242, 0.28); }
  .mnav summary::-webkit-details-marker { display: none; }
  .mnav nav { position: absolute; right: 0; top: 48px; min-width: 200px; background: #0A0F12; border: 1px solid var(--on-dark-line); display: flex; flex-direction: column; padding: 6px; }
  .mnav nav a { color: var(--on-dark); text-decoration: none; padding: 12px 14px; font-size: 15px; }
  .mnav nav a:hover { background: rgba(99, 232, 176, 0.08); }

  @media (max-width: 800px) {
    .links { display: none; }
    .mnav { display: block; }
    .secure span { display: none; }
  }
</style>
