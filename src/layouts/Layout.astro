---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  active?: 'bee' | 'stack' | 'pricing' | 'buy';
  checkout?: boolean;
}

const {
  title = 'Obstack · Observability for applications, infrastructure and IoT',
  description = 'Obstack is a self-hosted observability stack for applications, infrastructure and IoT: the Bee eBPF agent, Beyla, Vector, GreptimeDB, Grafana and Keep, on servers you own.',
  active,
  checkout = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A1F2E" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=M+PLUS+1+Code:wght@400;500;700&family=M+PLUS+1p:wght@400;500;700;800&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <Header active={active} checkout={checkout} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
