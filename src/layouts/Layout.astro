---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HumanChallenge from '../components/HumanChallenge.astro';
import { url } from '../lib/url';
import { EURO_COUNTRIES } from '../data/plans';

interface Props {
  title?: string;
  description?: string;
  active?: 'bee' | 'pageroot' | 'grafana' | 'aurora' | 'stack' | 'pricing' | 'buy';
  checkout?: boolean;
  /** Social card image, site-relative. Defaults to the site-wide card. */
  image?: string;
  /** Keep the page out of search indexes (checkout and other funnel pages). */
  noindex?: boolean;
  /** Extra JSON-LD documents for this page, on top of the site-wide graph. */
  schema?: Record<string, unknown>[];
}

const {
  title = 'Obstack · Observability for applications, infrastructure and IoT',
  description = 'Obstack is a self-hosted observability stack for applications, infrastructure and IoT: the Bee eBPF agent, Beyla, Vector, GreptimeDB, Grafana and Prometheus Alertmanager, on servers you own. PageRoot is the optional on-call module.',
  active,
  checkout = false,
  image = '/og-obstack.png',
  noindex = false,
  schema = [],
} = Astro.props;

const turnstileSitekey = (import.meta.env.PUBLIC_TURNSTILE_SITEKEY as string | undefined) || undefined;

const SITE = Astro.site ?? new URL('https://obstack.it');

/**
 * Canonical URL. GitHub Pages serves each page as a directory index, so the
 * trailing-slash form is the one that answers 200 — and the one the sitemap
 * lists. Query and hash are dropped.
 */
const path = `${Astro.url.pathname.replace(/\/+$/, '')}/`;
const canonical = new URL(path, SITE).href;
const ogImage = new URL(url(image), SITE).href;

const organisation = {
  '@type': 'Organization',
  '@id': `${SITE.origin}/#organization`,
  name: 'Obstack',
  legalName: 'Netter srl',
  url: `${SITE.origin}/`,
  logo: {
    '@type': 'ImageObject',
    url: new URL(url('/logo-obstack-mark.svg'), SITE).href,
  },
  image: ogImage,
  description:
    'Obstack builds and supports a self-hosted observability stack for applications, infrastructure and IoT.',
  vatID: 'IT03569900545',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Via Indipendenza',
    postalCode: '06081',
    addressLocality: 'Assisi',
    addressRegion: 'PG',
    addressCountry: 'IT',
  },
};

const website = {
  '@type': 'WebSite',
  '@id': `${SITE.origin}/#website`,
  url: `${SITE.origin}/`,
  name: 'Obstack',
  description:
    'Obstack is a self-hosted observability stack for applications, infrastructure and IoT: the Bee eBPF agent, Beyla, Vector, GreptimeDB, Grafana and Prometheus Alertmanager, on servers you own.',
  inLanguage: 'en',
  publisher: { '@id': `${SITE.origin}/#organization` },
};

const webPage = {
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  isPartOf: { '@id': `${SITE.origin}/#website` },
  about: { '@id': `${SITE.origin}/#organization` },
  primaryImageOfPage: ogImage,
  inLanguage: 'en',
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [organisation, website, webPage, ...schema],
};

/**
 * Currency boot script, inlined so the right prices are already showing at
 * first paint. It runs before the bundle loads, so it repeats the rules in
 * `currencyFromBrowser()` in plain ES5 — but over the same country list, which
 * is injected here rather than copied.
 */
const euroCountries: string[] = [...EURO_COUNTRIES];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#030607" />
    <meta name="color-scheme" content="dark light" />
    <meta name="generator" content={Astro.generator} />

    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Obstack" />
    <meta property="og:locale" content="en" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Obstack — one observability stack for applications, infrastructure and IoT" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="apple-touch-icon" sizes="180x180" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" type="application/xml" href={url('/sitemap-index.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=M+PLUS+1+Code:wght@400;500;700&display=swap"
    />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
    <script is:inline define:vars={{ euroCountries }}>
      (function () {
        var KEY = 'obstack-currency';
        var EURO = {};
        for (var n = 0; n < euroCountries.length; n++) EURO[euroCountries[n]] = 1;

        // Only languages spoken essentially in euro countries; ambiguous ones
        // (es, sv, da, pl, cs, hu, ro, is) fall through to USD.
        var EURO_LANGS = /^(it|de|fr|nl|pt|fi|el|sk|sl|et|lv|lt|ga|mt|lb|ca|eu|gl|hr|bg)$/;
        var EURO_TZ = {
          'Europe/Vienna': 1, 'Europe/Brussels': 1, 'Europe/Sofia': 1, 'Europe/Zagreb': 1,
          'Asia/Nicosia': 1, 'Europe/Nicosia': 1, 'Europe/Tallinn': 1, 'Europe/Helsinki': 1,
          'Europe/Mariehamn': 1, 'Europe/Paris': 1, 'Europe/Berlin': 1, 'Europe/Busingen': 1,
          'Europe/Athens': 1, 'Europe/Dublin': 1, 'Europe/Rome': 1, 'Europe/Riga': 1,
          'Europe/Vilnius': 1, 'Europe/Luxembourg': 1, 'Europe/Malta': 1, 'Europe/Amsterdam': 1,
          'Europe/Lisbon': 1, 'Atlantic/Madeira': 1, 'Atlantic/Azores': 1, 'Europe/Bratislava': 1,
          'Europe/Ljubljana': 1, 'Europe/Madrid': 1, 'Africa/Ceuta': 1, 'Atlantic/Canary': 1,
          'Europe/Andorra': 1, 'Europe/Monaco': 1, 'Europe/San_Marino': 1, 'Europe/Vatican': 1,
          'Europe/Podgorica': 1, 'America/Cayenne': 1, 'America/Guadeloupe': 1,
          'America/Martinique': 1, 'Indian/Mayotte': 1, 'Indian/Reunion': 1, 'America/Miquelon': 1,
          'America/St_Barthelemy': 1, 'America/Marigot': 1
        };

        var stored = null;
        try { stored = localStorage.getItem(KEY); } catch (e) {}
        var c = stored === 'eur' || stored === 'usd' ? stored : null;

        if (!c) {
          var langs = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language]) || [];
          var parsed = [];
          for (var i = 0; i < langs.length; i++) {
            var parts = String(langs[i] || '').replace(/_/g, '-').split('-');
            var region = '';
            for (var j = 1; j < parts.length; j++) {
              if (parts[j].length === 2) { region = parts[j].toUpperCase(); break; }
            }
            parsed.push({ lang: (parts[0] || '').toLowerCase(), region: region });
          }
          // A country in the locale is hard evidence: use it and stop.
          for (var k = 0; k < parsed.length; k++) {
            if (parsed[k].region) { c = EURO[parsed[k].region] ? 'eur' : 'usd'; break; }
          }
          // No country anywhere: try the language, then the time zone.
          if (!c) {
            for (var m = 0; m < parsed.length; m++) {
              if (EURO_LANGS.test(parsed[m].lang)) { c = 'eur'; break; }
            }
          }
          if (!c) {
            try {
              var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
              if (EURO_TZ[tz]) c = 'eur';
            } catch (e) {}
          }
          if (!c) c = 'usd';
        }
        document.documentElement.setAttribute('data-currency', c);
      })();
    </script>
  </head>
  <body>
    <Header active={active} checkout={checkout} />
    <main>
      <slot />
    </main>
    <Footer />
    <div id="obstack-human-layer" style="display:none;">
      <HumanChallenge lang="en" sitekey={turnstileSitekey} />
    </div>
    <script is:inline>
      (() => {
        // Reversed base64 — decoded only after human verification.
        const encoded = "0lmLrNWY0NnYvB0bm5Wa";
        const decode = (s) => {
          try { return atob(s.split("").reverse().join("")); }
          catch { return ""; }
        };
        const getEmail = () => decode(encoded);
        const buildMailto = (email, subject, body) => {
          if (!email) return "";
          const params = new URLSearchParams();
          if (subject) params.set("subject", subject);
          if (body) params.set("body", body);
          const query = params.toString().replace(/\+/g, "%20");
          return `mailto:${email}${query ? `?${query}` : ""}`;
        };
        const mailtoForEl = (el, email) =>
          buildMailto(email, el.getAttribute("data-subject"), el.getAttribute("data-body"));

        let humanVerified = false;
        let pendingTarget = null;
        let pendingMailto = null;

        const isBotSignal = () => {
          try {
            if (navigator.webdriver) return true;
            if (/HeadlessChrome|PhantomJS|bot|crawler|spider/i.test(navigator.userAgent)) return true;
            return false;
          } catch { return false; }
        };

        const revealAll = (email) => {
          document.querySelectorAll("a.obf-email").forEach((el) => {
            if (el.dataset.decoded === "1") return;
            el.setAttribute("href", mailtoForEl(el, email));
            if (!el.getAttribute("data-label")) {
              el.textContent = (el.getAttribute("data-prefix") || "") + email;
            }
            el.dataset.decoded = "1";
            el.classList.add("is-verified");
          });
        };

        const markVerified = (provider) => {
          if (humanVerified) return;
          if (isBotSignal()) return;
          humanVerified = true;
          const email = getEmail();
          if (!email) return;
          const layer = document.getElementById("obstack-human-layer");
          const widget = document.querySelector("[data-cf-widget]");
          if (widget) {
            widget.dataset.verified = "1";
            widget.dataset.checking = "";
            const msg = widget.querySelector(".cf-msg");
            if (msg) msg.textContent = "Verified ✓ — email unlocked";
          }
          revealAll(email);
          window.dispatchEvent(new CustomEvent("obstack:humanVerified", { detail: { provider, email } }));
          if (pendingMailto) {
            const href = buildMailto(email, pendingMailto.subject, pendingMailto.body);
            const cb = pendingMailto.onOpened;
            pendingMailto = null;
            setTimeout(() => {
              window.location.href = href;
              if (cb) cb(href, email);
            }, 300);
          } else if (pendingTarget) {
            const href = pendingTarget.getAttribute("href");
            pendingTarget = null;
            if (href && href.startsWith("mailto:")) {
              setTimeout(() => { window.location.href = href; }, 300);
            }
          }
          if (layer) setTimeout(() => { layer.style.display = "none"; }, 1800);
        };

        const startChallenge = () => {
          const layer = document.getElementById("obstack-human-layer");
          if (layer) {
            layer.style.display = "block";
            layer.style.outline = "2px solid #63E8B0";
            setTimeout(() => { layer.style.outline = "none"; }, 1500);
          }
          const widget = document.querySelector("[data-cf-widget]");
          if (widget && widget.dataset.verified !== "1") {
            const msg = widget.querySelector(".cf-msg");
            if (msg) msg.textContent = "Click the box to show the address";
          }
        };

        const onEmailActivate = (e) => {
          const el = e.currentTarget;
          if (el.dataset.decoded === "1") return;
          e.preventDefault();
          if (humanVerified) {
            const email = getEmail();
            el.setAttribute("href", mailtoForEl(el, email));
            if (!el.getAttribute("data-label")) {
              el.textContent = (el.getAttribute("data-prefix") || "") + email;
            }
            el.dataset.decoded = "1";
            window.location.href = mailtoForEl(el, email);
            return;
          }
          pendingTarget = el;
          startChallenge();
        };

        window.__obstackContactEmail = () => (humanVerified ? getEmail() : "");
        window.__obstackOpenMailto = (opts) => {
          const subject = opts && opts.subject;
          const body = opts && opts.body;
          const onOpened = opts && opts.onOpened;
          if (humanVerified) {
            const email = getEmail();
            const href = buildMailto(email, subject, body);
            window.location.href = href;
            if (onOpened) onOpened(href, email);
            return;
          }
          pendingMailto = { subject, body, onOpened };
          startChallenge();
        };

        const boot = () => {
          document.querySelectorAll("a.obf-email").forEach((el) => {
            el.addEventListener("click", onEmailActivate);
            el.addEventListener("keydown", (e) => {
              if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                onEmailActivate(e);
              }
            });
          });
          window.addEventListener("obstack:humanVerified", (e) => {
            if (!humanVerified) markVerified((e.detail && e.detail.provider) || "challenge");
          });
        };
        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
        else boot();
      })();
    </script>
  </body>
</html>
